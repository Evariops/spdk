 static int
@@ -724,6 +729,71 @@ spdk_iobuf_entry_abort(struct spdk_iobuf_channel *ch, struct spdk_iobuf_entry *e
 
 #define IOBUF_BATCH_SIZE 32
 
+/*
+ * Evariops 0077: a request waiting for a buffer was served only by a buffer returned on its own
+ * thread. Buffers returned on another thread go to that thread's cache, then to the central pool,
+ * and woke nobody: a thread whose buffers another thread holds waited until it returned one itself,
+ * possibly never (a second reactor, a second ublk thread). While a thread has requests waiting, a
+ * poller of its own takes buffers from the central pools for them, in their order, and stops once
+ * none waits. A buffer returned on the waiting thread still goes to its first request at once.
+ */
+static uint32_t
+iobuf_serve_from_pool(spdk_iobuf_entry_stailq_t *queue, struct spdk_ring *pool)
+{
+	struct spdk_iobuf_entry *entry;
+	uint32_t served = 0;
+	void *buf;
+
+	while (!STAILQ_EMPTY(queue) && spdk_ring_dequeue(pool, &buf, 1) == 1) {
+		entry = STAILQ_FIRST(queue);
+		STAILQ_REMOVE_HEAD(queue, stailq);
+		entry->cb_fn(entry, buf);
+		served++;
+		/* As in spdk_iobuf_put(): a callback that asked again went to the tail, and keeps
+		 * its place at the head. */
+		if (spdk_unlikely(entry == STAILQ_LAST(queue, spdk_iobuf_entry, stailq))) {
+			STAILQ_REMOVE(queue, entry, spdk_iobuf_entry, stailq);
+			STAILQ_INSERT_HEAD(queue, entry, stailq);
+		}
+	}
+
+	return served;
+}
+
+static int
+iobuf_retry_poll(void *ctx)
+{
+	struct iobuf_channel *ch = ctx;
+	struct iobuf_channel_node *node;
+	uint32_t served = 0;
+	bool waiting = false;
+	int32_t i;
+
+	IOBUF_FOREACH_NUMA_ID(i) {
+		node = &ch->node[i];
+		served += iobuf_serve_from_pool(&node->small_queue, g_iobuf.node[i].small_pool);
+		served += iobuf_serve_from_pool(&node->large_queue, g_iobuf.node[i].large_pool);
+		waiting |= !STAILQ_EMPTY(&node->small_queue) || !STAILQ_EMPTY(&node->large_queue);
+	}
+
+	if (!waiting) {
+		spdk_poller_unregister(&ch->retry_poller);
+	}
+
+	return served > 0 ? SPDK_POLLER_BUSY : SPDK_POLLER_IDLE;
+}
+
+static void
+iobuf_retry_start(struct spdk_iobuf_channel *ch)
+{
+	struct iobuf_channel *iobuf_ch = spdk_io_channel_get_ctx(ch->parent);
+
+	if (iobuf_ch->retry_poller == NULL) {
+		iobuf_ch->retry_poller = SPDK_POLLER_REGISTER(iobuf_retry_poll, iobuf_ch,
+					 IOBUF_RETRY_PERIOD_US);
+	}
+}
+
 void *
 spdk_iobuf_get(struct spdk_iobuf_channel *ch, uint64_t len,
 	       struct spdk_iobuf_entry *entry, spdk_iobuf_get_cb cb_fn)
@@ -761,6 +831,7 @@ spdk_iobuf_get(struct spdk_iobuf_channel *ch, uint64_t len,
 				entry->module = ch->module;
 				entry->cb_fn = cb_fn;
 				pool->stats.retry++;
+				iobuf_retry_start(ch);
 			}
 
 			return NULL;

+/* Evariops 0077: a thread whose requests wait is served by the buffers another thread returns. */
+static void
+iobuf_served_across_threads(void)
+{
+	struct spdk_iobuf_opts opts = {
+		.small_pool_count = 2,
+		.large_pool_count = 2,
+		.small_bufsize = SMALL_BUFSIZE,
+		.large_bufsize = LARGE_BUFSIZE,
+	};
+	struct spdk_iobuf_channel ch[2];
+	struct ut_iobuf_entry waiting[3] = {};
+	struct iobuf_channel *iobuf_ch0;
+	void *held[2];
+	int rc, finish = 0, i;
+
+	allocate_cores(2);
+	allocate_threads(2);
+
+	set_thread(0);
+	g_iobuf.opts = opts;
+	rc = spdk_iobuf_initialize();
+	CU_ASSERT_EQUAL(rc, 0);
+	rc = spdk_iobuf_register_module("ut_module");
+	CU_ASSERT_EQUAL(rc, 0);
+	rc = spdk_iobuf_channel_init(&ch[0], "ut_module", 0, 0);
+	CU_ASSERT_EQUAL(rc, 0);
+	set_thread(1);
+	rc = spdk_iobuf_channel_init(&ch[1], "ut_module", 0, 0);
+	CU_ASSERT_EQUAL(rc, 0);
+
+	/* Thread 1 holds every large buffer. */
+	for (i = 0; i < 2; i++) {
+		held[i] = spdk_iobuf_get(&ch[1], LARGE_BUFSIZE, NULL, NULL);
+		CU_ASSERT_PTR_NOT_NULL(held[i]);
+	}
+
+	/* Thread 0 waits for three. */
+	set_thread(0);
+	iobuf_ch0 = spdk_io_channel_get_ctx(ch[0].parent);
+	for (i = 0; i < 3; i++) {
+		waiting[i].buf = spdk_iobuf_get(&ch[0], LARGE_BUFSIZE, &waiting[i].iobuf,
+						ut_iobuf_get_buf_cb);
+		CU_ASSERT_PTR_NULL(waiting[i].buf);
+	}
+	CU_ASSERT_PTR_NOT_NULL(iobuf_ch0->retry_poller);
+
+	/* Thread 1 returns one: it goes to the central pool, and thread 0's first request gets it
+	 * at thread 0's next poll. Upstream left it in the pool. */
+	set_thread(1);
+	spdk_iobuf_put(&ch[1], held[0], LARGE_BUFSIZE);
+	spdk_delay_us(IOBUF_RETRY_PERIOD_US);
+	poll_threads();
+	CU_ASSERT_PTR_EQUAL(waiting[0].buf, held[0]);
+	CU_ASSERT_PTR_NULL(waiting[1].buf);
+	CU_ASSERT_PTR_NULL(waiting[2].buf);
+
+	/* The second, in order. */
+	set_thread(1);
+	spdk_iobuf_put(&ch[1], held[1], LARGE_BUFSIZE);
+	spdk_delay_us(IOBUF_RETRY_PERIOD_US);
+	poll_threads();
+	CU_ASSERT_PTR_EQUAL(waiting[1].buf, held[1]);
+	CU_ASSERT_PTR_NULL(waiting[2].buf);
+	CU_ASSERT_PTR_NOT_NULL(iobuf_ch0->retry_poller);
+
+	/* A buffer returned on thread 0 still goes to its first request at once, and with nothing
+	 * left waiting the poller stops. */
+	set_thread(0);
+	spdk_iobuf_put(&ch[0], waiting[0].buf, LARGE_BUFSIZE);
+	CU_ASSERT_PTR_EQUAL(waiting[2].buf, held[0]);
+	spdk_delay_us(IOBUF_RETRY_PERIOD_US);
+	poll_threads();
+	CU_ASSERT_PTR_NULL(iobuf_ch0->retry_poller);
+
+	spdk_iobuf_put(&ch[0], waiting[1].buf, LARGE_BUFSIZE);
+	spdk_iobuf_put(&ch[0], waiting[2].buf, LARGE_BUFSIZE);
+	spdk_iobuf_channel_fini(&ch[0]);
+	set_thread(1);
+	spdk_iobuf_channel_fini(&ch[1]);
+	poll_threads();
+
+	set_thread(0);
+	spdk_iobuf_finish(ut_iobuf_finish_cb, &finish);
+	poll_threads();
+	CU_ASSERT_EQUAL(finish, 1);
+
+	free_threads();
+	free_cores();
+}

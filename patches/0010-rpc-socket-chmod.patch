+#include <sys/stat.h>	/* Evariops 0010: umask() / mode_t for the owner-only socket */
 
 #include "spdk/stdinc.h"
 
@@ -147,6 +148,7 @@ struct spdk_rpc_server *
 spdk_rpc_server_listen(const char *listen_addr)
 {
 	struct spdk_rpc_server *server;
+	mode_t saved_umask;
 	int rc;
 
 	server = calloc(1, sizeof(struct spdk_rpc_server));
@@ -194,10 +196,19 @@ spdk_rpc_server_listen(const char *listen_addr)
 	 */
 	unlink(server->listen_addr_unix.sun_path);
 
+	/* Evariops 0010: the RPC socket must be owner-only from the instant it exists.
+	 * bind(), inside spdk_jsonrpc_server_listen(), creates the socket file with the
+	 * process umask, and the socket is connectable as soon as it is bound - so a
+	 * chmod performed afterwards leaves a window in which any local process can
+	 * connect and issue destructive RPCs. Wrapping the listen in umask 077 makes the
+	 * file 0600 (0666 & ~077) at creation time, closing that window. Restore the
+	 * previous umask immediately after, since it is process-wide. */
+	saved_umask = umask(077);
 	server->jsonrpc_server = spdk_jsonrpc_server_listen(AF_UNIX, 0,
 				 (struct sockaddr *) & server->listen_addr_unix,
 				 sizeof(server->listen_addr_unix),
 				 jsonrpc_handler);
+	umask(saved_umask);
 	if (server->jsonrpc_server == NULL) {
 		SPDK_ERRLOG("spdk_jsonrpc_server_listen() failed\n");
 		close(server->lock_fd);
@@ -205,6 +216,18 @@ spdk_rpc_server_listen(const char *listen_addr)
 		goto ret;
 	}
 
+	/* Backstop, not the primary control: re-assert 0600 in case a platform's bind()
+	 * ignores the umask for AF_UNIX. */
+	if (chmod(server->listen_addr_unix.sun_path, 0600) != 0) {
+		SPDK_ERRLOG("Cannot chmod 0600 RPC socket %s: %s\n",
+			    server->listen_addr_unix.sun_path, spdk_strerror(errno));
+		spdk_jsonrpc_server_shutdown(server->jsonrpc_server);
+		close(server->lock_fd);
+		unlink(server->lock_path);
+		unlink(server->listen_addr_unix.sun_path);
+		goto ret;
+	}
+
 	return server;
 

diff --git a/module/bdev/lvol/vbdev_lvol_quiesce_rpc.c b/module/bdev/lvol/vbdev_lvol_quiesce_rpc.c
new file mode 100644
index 0000000..908987a
--- /dev/null
+++ b/module/bdev/lvol/vbdev_lvol_quiesce_rpc.c
@@ -0,0 +1,237 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (C) 2026 Evariops.
+ *   All rights reserved.
+ */
+
+/*
+ * Evariops 0062: bdev_lvol_quiesce {name, ttl_ms} and bdev_lvol_unquiesce {name}.
+ *
+ * A group snapshot cuts every member volume at one instant. A volume behind an
+ * NVMe-oF subsystem is drained at its subsystem; one served to its node's kernel
+ * by a ublk disk has no subsystem, so it is quiesced at its lvol: I/O submitted
+ * after the quiesce waits, and the answer comes once the I/O in flight has
+ * completed. spdk_bdev_quiesce is a C API only, callable by the module that
+ * registered the bdev (vbdev_lvol_quiesce_bdev).
+ *
+ * A quiesce holds at most ttl_ms: a caller that dies between the quiesce and the
+ * unquiesce must not leave the volume's I/O waiting forever. Past it the lvol is
+ * unquiesced, and the expiry is logged; the unquiesce that comes late answers
+ * -ENOENT, which tells the caller its cut may not hold.
+ */
+
+#include "spdk/rpc.h"
+#include "spdk/util.h"
+#include "spdk/string.h"
+#include "spdk/bdev.h"
+#include "spdk/log.h"
+#include "spdk/thread.h"
+#include "vbdev_lvol.h"
+
+#define LVOL_QUIESCE_TTL_DEFAULT_MS	10000
+#define LVOL_QUIESCE_TTL_MAX_MS		60000
+
+struct lvol_quiesce {
+	char				*name;
+	struct spdk_poller		*ttl_poller;
+	uint32_t			ttl_ms;
+	struct spdk_jsonrpc_request	*request;
+	bool				held;
+	TAILQ_ENTRY(lvol_quiesce)	link;
+};
+
+static TAILQ_HEAD(, lvol_quiesce) g_lvol_quiesces = TAILQ_HEAD_INITIALIZER(g_lvol_quiesces);
+
+static struct lvol_quiesce *
+lvol_quiesce_find(const char *name)
+{
+	struct lvol_quiesce *q;
+
+	TAILQ_FOREACH(q, &g_lvol_quiesces, link) {
+		if (strcmp(q->name, name) == 0) {
+			return q;
+		}
+	}
+	return NULL;
+}
+
+static void
+lvol_quiesce_free(struct lvol_quiesce *q)
+{
+	TAILQ_REMOVE(&g_lvol_quiesces, q, link);
+	spdk_poller_unregister(&q->ttl_poller);
+	free(q->name);
+	free(q);
+}
+
+static void
+lvol_quiesce_expired_done(void *ctx, int status)
+{
+	struct lvol_quiesce *q = ctx;
+
+	if (status != 0) {
+		SPDK_ERRLOG("lvol %s: unquiesce at the end of its ttl failed: %s (Evariops 0062)\n",
+			    q->name, spdk_strerror(-status));
+	}
+	lvol_quiesce_free(q);
+}
+
+static int
+lvol_quiesce_expired(void *ctx)
+{
+	struct lvol_quiesce *q = ctx;
+	struct spdk_bdev *bdev;
+	int rc;
+
+	spdk_poller_unregister(&q->ttl_poller);
+	SPDK_WARNLOG("lvol %s: quiesce held past its ttl of %u ms, unquiescing (Evariops 0062)\n",
+		     q->name, q->ttl_ms);
+
+	bdev = spdk_bdev_get_by_name(q->name);
+	if (bdev == NULL) {
+		lvol_quiesce_free(q);
+		return SPDK_POLLER_BUSY;
+	}
+
+	q->held = false;
+	rc = vbdev_lvol_quiesce_bdev(bdev, true, lvol_quiesce_expired_done, q);
+	if (rc != 0) {
+		lvol_quiesce_expired_done(q, rc);
+	}
+	return SPDK_POLLER_BUSY;
+}
+
+struct rpc_lvol_quiesce {
+	char		*name;
+	uint32_t	ttl_ms;
+};
+
+static const struct spdk_json_object_decoder rpc_bdev_lvol_quiesce_decoders[] = {
+	{"name", offsetof(struct rpc_lvol_quiesce, name), spdk_json_decode_string},
+	{"ttl_ms", offsetof(struct rpc_lvol_quiesce, ttl_ms), spdk_json_decode_uint32, true},
+};
+
+static void
+rpc_bdev_lvol_quiesce_done(void *ctx, int status)
+{
+	struct lvol_quiesce *q = ctx;
+	struct spdk_jsonrpc_request *request = q->request;
+
+	q->request = NULL;
+	if (status != 0) {
+		spdk_jsonrpc_send_error_response(request, status, spdk_strerror(-status));
+		lvol_quiesce_free(q);
+		return;
+	}
+
+	q->held = true;
+	q->ttl_poller = SPDK_POLLER_REGISTER(lvol_quiesce_expired, q, (uint64_t)q->ttl_ms * 1000);
+	spdk_jsonrpc_send_bool_response(request, true);
+}
+
+static void
+rpc_bdev_lvol_quiesce(struct spdk_jsonrpc_request *request, const struct spdk_json_val *params)
+{
+	struct rpc_lvol_quiesce req = { .ttl_ms = LVOL_QUIESCE_TTL_DEFAULT_MS };
+	struct lvol_quiesce *q;
+	struct spdk_bdev *bdev;
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_lvol_quiesce_decoders,
+				    SPDK_COUNTOF(rpc_bdev_lvol_quiesce_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+	if (req.ttl_ms == 0 || req.ttl_ms > LVOL_QUIESCE_TTL_MAX_MS) {
+		spdk_jsonrpc_send_error_response_fmt(request, -EINVAL, "ttl_ms must be in 1..%u",
+						     LVOL_QUIESCE_TTL_MAX_MS);
+		goto cleanup;
+	}
+
+	bdev = spdk_bdev_get_by_name(req.name);
+	if (bdev == NULL || vbdev_lvol_get_from_bdev(bdev) == NULL) {
+		spdk_jsonrpc_send_error_response(request, -ENODEV, spdk_strerror(ENODEV));
+		goto cleanup;
+	}
+	if (lvol_quiesce_find(spdk_bdev_get_name(bdev)) != NULL) {
+		spdk_jsonrpc_send_error_response(request, -EALREADY, "lvol is already quiesced");
+		goto cleanup;
+	}
+
+	q = calloc(1, sizeof(*q));
+	if (q == NULL || (q->name = strdup(spdk_bdev_get_name(bdev))) == NULL) {
+		free(q);
+		spdk_jsonrpc_send_error_response(request, -ENOMEM, spdk_strerror(ENOMEM));
+		goto cleanup;
+	}
+	q->ttl_ms = req.ttl_ms;
+	q->request = request;
+	TAILQ_INSERT_TAIL(&g_lvol_quiesces, q, link);
+
+	rc = vbdev_lvol_quiesce_bdev(bdev, false, rpc_bdev_lvol_quiesce_done, q);
+	if (rc != 0) {
+		rpc_bdev_lvol_quiesce_done(q, rc);
+	}
+
+cleanup:
+	free(req.name);
+}
+SPDK_RPC_REGISTER("bdev_lvol_quiesce", rpc_bdev_lvol_quiesce, SPDK_RPC_RUNTIME)
+
+struct rpc_lvol_unquiesce {
+	char	*name;
+};
+
+static const struct spdk_json_object_decoder rpc_bdev_lvol_unquiesce_decoders[] = {
+	{"name", offsetof(struct rpc_lvol_unquiesce, name), spdk_json_decode_string},
+};
+
+static void
+rpc_bdev_lvol_unquiesce_done(void *ctx, int status)
+{
+	struct lvol_quiesce *q = ctx;
+	struct spdk_jsonrpc_request *request = q->request;
+
+	if (status != 0) {
+		spdk_jsonrpc_send_error_response(request, status, spdk_strerror(-status));
+	} else {
+		spdk_jsonrpc_send_bool_response(request, true);
+	}
+	lvol_quiesce_free(q);
+}
+
+static void
+rpc_bdev_lvol_unquiesce(struct spdk_jsonrpc_request *request, const struct spdk_json_val *params)
+{
+	struct rpc_lvol_unquiesce req = {};
+	struct lvol_quiesce *q;
+	struct spdk_bdev *bdev;
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_lvol_unquiesce_decoders,
+				    SPDK_COUNTOF(rpc_bdev_lvol_unquiesce_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	bdev = spdk_bdev_get_by_name(req.name);
+	q = bdev != NULL ? lvol_quiesce_find(spdk_bdev_get_name(bdev)) : NULL;
+	if (q == NULL || !q->held) {
+		/* Never quiesced, still quiescing, or released at the end of its ttl. */
+		spdk_jsonrpc_send_error_response(request, -ENOENT, "lvol is not quiesced");
+		goto cleanup;
+	}
+
+	spdk_poller_unregister(&q->ttl_poller);
+	q->held = false;
+	q->request = request;
+	rc = vbdev_lvol_quiesce_bdev(bdev, true, rpc_bdev_lvol_unquiesce_done, q);
+	if (rc != 0) {
+		rpc_bdev_lvol_unquiesce_done(q, rc);
+	}
+
+cleanup:
+	free(req.name);
+}
+SPDK_RPC_REGISTER("bdev_lvol_unquiesce", rpc_bdev_lvol_unquiesce, SPDK_RPC_RUNTIME)

+/* SPEC-73 M2a: physical LBA of a cluster on the underlying bs_dev (the bdev_tier
+ * composite). Returns 0 if the cluster is unallocated or out of range. Lets the
+ * control-plane map each cluster to a band/tier (LBA -> band) for placement. */
+uint64_t
+spdk_blob_get_cluster_lba(struct spdk_blob *blob, uint64_t cluster_num)
+{
+	assert(blob != NULL);
+
+	if (cluster_num >= blob->active.num_clusters) {
+		return 0;
+	}
+	return blob->active.clusters[cluster_num];
+}

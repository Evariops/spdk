diff --git a/lib/ublk/ublk.c b/lib/ublk/ublk.c
index dd90743..d7e1a24 100644
--- a/lib/ublk/ublk.c
+++ b/lib/ublk/ublk.c
@@ -71,11 +71,13 @@ static int ublk_ctrl_start_recovery(struct spdk_ublk_dev *ublk);
 
 static int ublk_ctrl_cmd_submit(struct spdk_ublk_dev *ublk, uint32_t cmd_op);
 
-/* Evariops 0060: control commands the driver has only in their ioctl encoding. */
+/* Evariops 0060, 0061: control commands the driver has only in their ioctl encoding. */
 #define UBLK_CMD_UPDATE_SIZE		_IOC_NR(UBLK_U_CMD_UPDATE_SIZE)
+#define UBLK_CMD_QUIESCE_DEV		_IOC_NR(UBLK_U_CMD_QUIESCE_DEV)
 
 static const char *ublk_op_name[64] = {
 	[UBLK_CMD_UPDATE_SIZE] = "UBLK_CMD_UPDATE_SIZE",
+	[UBLK_CMD_QUIESCE_DEV] = "UBLK_CMD_QUIESCE_DEV",
 	[UBLK_CMD_GET_DEV_INFO] = "UBLK_CMD_GET_DEV_INFO",
 	[UBLK_CMD_ADD_DEV] =	"UBLK_CMD_ADD_DEV",
 	[UBLK_CMD_DEL_DEV] =	"UBLK_CMD_DEL_DEV",
@@ -157,6 +159,9 @@ struct spdk_ublk_dev {
 	uint32_t		ctrl_ops_in_progress;
 	bool			is_closing;
 	bool			is_recovering;
+	/* Evariops 0061: quiesced to be left to the kernel for a later recovery, not deleted. */
+	bool			is_quiescing;
+	uint64_t		quiesce_timeout_ms;
 
 	TAILQ_ENTRY(spdk_ublk_dev) tailq;
 	TAILQ_ENTRY(spdk_ublk_dev) wait_tailq;
@@ -189,6 +194,8 @@ struct ublk_tgt {
 	bool			user_recovery;
 	/* Evariops 0060: `ublk_drv` supports UBLK_F_UPDATE_SIZE */
 	bool			update_size;
+	/* Evariops 0061: `ublk_drv` supports UBLK_F_QUIESCE */
+	bool			quiesce;
 };
 
 static TAILQ_HEAD(, spdk_ublk_dev) g_ublk_devs = TAILQ_HEAD_INITIALIZER(g_ublk_devs);
@@ -254,6 +261,9 @@ ublk_set_sqe_cmd_op(struct io_uring_sqe *sqe, uint32_t cmd_op)
 		case UBLK_CMD_UPDATE_SIZE:
 			opc = UBLK_U_CMD_UPDATE_SIZE;
 			break;
+		case UBLK_CMD_QUIESCE_DEV:
+			opc = UBLK_U_CMD_QUIESCE_DEV;
+			break;
 
 		/* io uring */
 		case UBLK_IO_FETCH_REQ:
@@ -339,6 +349,12 @@ ublk_ctrl_cmd_error(struct spdk_ublk_dev *ublk, int32_t res)
 	case UBLK_CMD_UPDATE_SIZE:
 		/* Evariops 0060: the disk keeps serving at its former size. */
 		break;
+	case UBLK_CMD_QUIESCE_DEV:
+		/* Evariops 0061: not quiesced (in-flight I/O outlived the timeout): the
+		 * disk keeps serving, and the caller was told. */
+		ublk->is_quiescing = false;
+		ublk->is_closing = false;
+		break;
 	default:
 		SPDK_ERRLOG("No match cmd operation,cmd_op = %d\n", ublk->current_cmd_op);
 		break;
@@ -444,6 +460,12 @@ ublk_ctrl_process_cqe(struct io_uring_cqe *cqe)
 		SPDK_NOTICELOG("ublk %u resized to %" PRIu64 " sectors (Evariops 0060)\n",
 			       ublk->ublk_id, (uint64_t)ublk->dev_params.basic.dev_sectors);
 		break;
+	case UBLK_CMD_QUIESCE_DEV:
+		/* Evariops 0061: no request in flight, and the kernel has cancelled the
+		 * fetch commands: the queues close on their aborts, and the disk is
+		 * released, not deleted (ublk_delete_dev). The caller is answered then. */
+		SPDK_NOTICELOG("ublk %u quiesced (Evariops 0061)\n", ublk->ublk_id);
+		break;
 	default:
 		SPDK_ERRLOG("No match cmd operation,cmd_op = %d\n", ublk->current_cmd_op);
 		break;
@@ -538,6 +560,9 @@ ublk_ctrl_cmd_submit(struct spdk_ublk_dev *ublk, uint32_t cmd_op)
 	case UBLK_CMD_UPDATE_SIZE:
 		cmd->data[0] = ublk->dev_params.basic.dev_sectors;
 		break;
+	case UBLK_CMD_QUIESCE_DEV:
+		cmd->data[0] = ublk->quiesce_timeout_ms;
+		break;
 	default:
 		SPDK_ERRLOG("No match cmd operation,cmd_op = %d\n", cmd_op);
 		return -EINVAL;
@@ -604,6 +629,8 @@ ublk_ctrl_cmd_get_features(void)
 		g_ublk_tgt.user_recovery = !!(g_ublk_tgt.features & UBLK_F_USER_RECOVERY);
 		g_ublk_tgt.update_size = g_ublk_tgt.ioctl_encode &&
 					 !!(g_ublk_tgt.features & UBLK_F_UPDATE_SIZE);
+		g_ublk_tgt.quiesce = g_ublk_tgt.ioctl_encode && g_ublk_tgt.user_recovery &&
+				     !!(g_ublk_tgt.features & UBLK_F_QUIESCE);
 		SPDK_NOTICELOG("User Copy %s\n", g_ublk_tgt.user_copy ? "enabled" : "disabled");
 		SPDK_NOTICELOG("ublk_drv features 0x%" PRIx64 "\n", g_ublk_tgt.features);
 	}
@@ -792,6 +819,9 @@ _ublk_fini_done(void *args)
 	g_ublk_tgt.ioctl_encode = false;
 	g_ublk_tgt.user_copy = false;
 	g_ublk_tgt.user_recovery = false;
+	/* Evariops 0060, 0061 */
+	g_ublk_tgt.update_size = false;
+	g_ublk_tgt.quiesce = false;
 
 	if (g_ublk_tgt.cb_fn) {
 		g_ublk_tgt.cb_fn(g_ublk_tgt.cb_arg);
@@ -1026,6 +1056,18 @@ ublk_delete_dev(void *arg)
 
 	if (ublk->cdev_fd >= 0) {
 		close(ublk->cdev_fd);
+		ublk->cdev_fd = -1;
+	}
+
+	/* Evariops 0061: a quiesced disk is left to the kernel, not deleted. With its
+	 * queues closed and its char device released, the device waits, QUIESCED,
+	 * holding the requests that arrive, for a server to recover it
+	 * (ublk_recover_disk), in this process or the next. */
+	if (ublk->is_quiescing) {
+		SPDK_NOTICELOG("ublk %u released quiesced, for a recovery (Evariops 0061)\n",
+			       ublk->ublk_id);
+		ublk_free_dev(ublk);
+		return;
 	}
 
 	rc = ublk_ctrl_cmd_submit(ublk, UBLK_CMD_DEL_DEV);
@@ -1120,6 +1162,51 @@ ublk_stop_disk(uint32_t ublk_id, ublk_ctrl_cb ctrl_cb, void *cb_arg)
 	return ublk_close_dev(ublk);
 }
 
+/* Evariops 0061: quiesces a disk for a planned restart (UBLK_U_CMD_QUIESCE_DEV): the
+ * kernel holds the new requests, lets the in-flight ones complete, then cancels the
+ * fetch commands, and the disk is released to the kernel instead of deleted. The
+ * next process recovers it (ublk_recover_disk) with nothing to replay. Upstream
+ * could only stop a disk, which deletes the kernel device under its filesystem.
+ * ctrl_cb is called once the disk is released, or with the error that kept it
+ * serving (-EBUSY: in-flight requests outlived timeout_ms, 0 waits forever). */
+int
+ublk_quiesce_disk(uint32_t ublk_id, uint64_t timeout_ms, ublk_ctrl_cb ctrl_cb, void *cb_arg)
+{
+	struct spdk_ublk_dev *ublk;
+	int rc;
+
+	assert(spdk_thread_is_app_thread(NULL));
+
+	ublk = ublk_dev_find_by_id(ublk_id);
+	if (ublk == NULL) {
+		SPDK_ERRLOG("no ublk dev with ublk_id=%u\n", ublk_id);
+		return -ENODEV;
+	}
+	if (!(ublk->dev_info.flags & UBLK_F_QUIESCE)) {
+		SPDK_ERRLOG("ublk %u was created without UBLK_F_QUIESCE (Evariops 0061)\n", ublk_id);
+		return -ENOTSUP;
+	}
+	if (ublk->is_closing || ublk->is_recovering || ublk->ctrl_cb != NULL ||
+	    ublk->ctrl_ops_in_progress > 0 || ublk->online_num_queues < ublk->num_queues) {
+		SPDK_WARNLOG("ublk %u is busy, not quiesced (Evariops 0061)\n", ublk_id);
+		return -EBUSY;
+	}
+
+	ublk->ctrl_cb = ctrl_cb;
+	ublk->cb_arg = cb_arg;
+	ublk->is_closing = true;
+	ublk->is_quiescing = true;
+	ublk->quiesce_timeout_ms = timeout_ms;
+	rc = ublk_ctrl_cmd_submit(ublk, UBLK_CMD_QUIESCE_DEV);
+	if (rc < 0) {
+		ublk->ctrl_cb = NULL;
+		ublk->is_closing = false;
+		ublk->is_quiescing = false;
+	}
+
+	return rc;
+}
+
 static inline void
 ublk_mark_io_done(struct ublk_io *io, int res)
 {
@@ -1872,6 +1959,10 @@ ublk_dev_info_init(struct spdk_ublk_dev *ublk)
 		uinfo.flags |= UBLK_F_UPDATE_SIZE;
 	}
 
+	if (g_ublk_tgt.quiesce) {
+		uinfo.flags |= UBLK_F_QUIESCE;
+	}
+
 	ublk->dev_info = uinfo;
 }
 
@@ -1948,6 +2039,8 @@ ublk_free_dev(struct spdk_ublk_dev *ublk)
 {
 	struct ublk_queue *q;
 	uint32_t q_idx;
+	ublk_ctrl_cb cb;
+	void *cb_arg;
 
 	spdk_poller_unregister(&ublk->resize_poller);
 
@@ -1982,7 +2075,14 @@ ublk_free_dev(struct spdk_ublk_dev *ublk)
 	ublk_dev_list_unregister(ublk);
 	SPDK_NOTICELOG("ublk dev %d stopped\n", ublk->ublk_id);
 
+	/* Evariops 0061: a quiesce is answered once the disk is gone from this
+	 * process, its id free and its bdev released, so a recovery may follow. */
+	cb = ublk->is_quiescing ? ublk->ctrl_cb : NULL;
+	cb_arg = ublk->cb_arg;
 	free(ublk);
+	if (cb != NULL) {
+		cb(cb_arg, 0);
+	}
 }
 

diff --git a/lib/ublk/ublk_rpc.c b/lib/ublk/ublk_rpc.c
index 371e26b..29e5f84 100644
--- a/lib/ublk/ublk_rpc.c
+++ b/lib/ublk/ublk_rpc.c
@@ -274,3 +274,63 @@ rpc_ublk_recover_disk(struct spdk_jsonrpc_request *request,
 }
 
 SPDK_RPC_REGISTER("ublk_recover_disk", rpc_ublk_recover_disk, SPDK_RPC_RUNTIME)
+
+/* Evariops 0061: ublk_quiesce_disk {ublk_id, timeout_ms} quiesces a disk for a planned
+ * restart and releases it to the kernel, which holds its requests until a recovery
+ * (ublk_recover_disk). Answered once the disk is released. A fork RPC, outside the
+ * schema (Evariops 0057). */
+struct rpc_ublk_quiesce_disk {
+	uint32_t ublk_id;
+	uint64_t timeout_ms;
+	struct spdk_jsonrpc_request *request;
+};
+
+static const struct spdk_json_object_decoder rpc_ublk_quiesce_disk_decoders[] = {
+	{"ublk_id", offsetof(struct rpc_ublk_quiesce_disk, ublk_id), spdk_json_decode_uint32},
+	{"timeout_ms", offsetof(struct rpc_ublk_quiesce_disk, timeout_ms), spdk_json_decode_uint64, true},
+};
+
+static void
+rpc_ublk_quiesce_disk_done(void *cb_arg, int rc)
+{
+	struct rpc_ublk_quiesce_disk *req = cb_arg;
+
+	if (rc == 0) {
+		spdk_jsonrpc_send_bool_response(req->request, true);
+	} else {
+		spdk_jsonrpc_send_error_response(req->request, rc, spdk_strerror(-rc));
+	}
+	free(req);
+}
+
+static void
+rpc_ublk_quiesce_disk(struct spdk_jsonrpc_request *request,
+		      const struct spdk_json_val *params)
+{
+	struct rpc_ublk_quiesce_disk *req;
+	int rc;
+
+	req = calloc(1, sizeof(*req));
+	if (req == NULL) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INTERNAL_ERROR, "Out of memory");
+		return;
+	}
+	req->request = request;
+	req->timeout_ms = 30000;
+
+	if (spdk_json_decode_object(params, rpc_ublk_quiesce_disk_decoders,
+				    SPDK_COUNTOF(rpc_ublk_quiesce_disk_decoders), req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "spdk_json_decode_object failed");
+		free(req);
+		return;
+	}
+
+	rc = ublk_quiesce_disk(req->ublk_id, req->timeout_ms, rpc_ublk_quiesce_disk_done, req);
+	if (rc != 0) {
+		spdk_jsonrpc_send_error_response(request, rc, spdk_strerror(-rc));
+		free(req);
+	}
+}
+
+SPDK_RPC_REGISTER("ublk_quiesce_disk", rpc_ublk_quiesce_disk, SPDK_RPC_RUNTIME)

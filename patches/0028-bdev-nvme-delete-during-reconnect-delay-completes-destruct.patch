diff --git a/module/bdev/nvme/bdev_nvme.c b/module/bdev/nvme/bdev_nvme.c
index e331994..056e9a3 100644
--- a/module/bdev/nvme/bdev_nvme.c
+++ b/module/bdev/nvme/bdev_nvme.c
@@ -840,6 +840,14 @@ nvme_ctrlr_put_ref(struct nvme_ctrlr *nvme_ctrlr)
 	assert(nvme_ctrlr->ref > 0);
 	ref = --nvme_ctrlr->ref;
 	if (ref > 0) {
+		if (nvme_ctrlr->destruct) {
+			/* Evariops 0028: the destruct waits for these refs — name what defers it,
+			 * or a leaked ref reads as an unexplained immortal ctrlr. */
+			NVME_CTRLR_NOTICELOG(nvme_ctrlr,
+					     "destruct deferred at put_ref: ref %d resetting %d reconnect_delayed %d (Evariops 0028)\n",
+					     ref, (int)nvme_ctrlr->resetting,
+					     (int)nvme_ctrlr->reconnect_is_delayed);
+		}
 		pthread_mutex_unlock(&nvme_ctrlr->mutex);
 		return ref;
 	}
@@ -2345,6 +2353,12 @@ bdev_nvme_reconnect_delay_timer_expired(void *ctx)
 	nvme_ctrlr->reconnect_is_delayed = false;
 
 	if (nvme_ctrlr->destruct) {
+		/* Evariops 0028: since v26.09 the delay holds no ref, so a delete landing in
+		 * its window unregisters through its own put_ref; this branch only has to
+		 * leave. Logged so that the window's end stays traceable to the delete. */
+		NVME_CTRLR_NOTICELOG(nvme_ctrlr,
+				     "reconnect delay expired with destruct pending: ref %d (Evariops 0028)\n",
+				     (int)nvme_ctrlr->ref);
 		return SPDK_POLLER_BUSY;
 	}
 
@@ -6257,6 +6271,13 @@ bdev_nvme_start_ctrlr_destruct(struct nvme_ctrlr *nvme_ctrlr, bool hotplug)
 
 	NVME_CTRLR_INFOLOG(nvme_ctrlr, "destructing ctrlr\n");
 	nvme_ctrlr->destruct = true;
+	/* Evariops 0028: record the lifecycle state at delete time. A delete landing
+	 * mid-reset defers its destruct until the reset puts its ref, and whoever
+	 * completes it later has to be traceable back to here. */
+	NVME_CTRLR_NOTICELOG(nvme_ctrlr,
+			     "delete requested: ref %d resetting %d reconnect_delayed %d (Evariops 0028)\n",
+			     (int)nvme_ctrlr->ref, (int)nvme_ctrlr->resetting,
+			     (int)nvme_ctrlr->reconnect_is_delayed);
 
 	spdk_nvme_ctrlr_register_aer_callback(nvme_ctrlr->ctrlr, NULL, NULL);
 	spdk_nvme_ctrlr_register_ns_attr_changed_callback(nvme_ctrlr->ctrlr, NULL, NULL);

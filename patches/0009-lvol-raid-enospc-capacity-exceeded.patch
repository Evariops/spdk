-		if (base_info) {
-			raid_bdev_fail_base_bdev(base_info);
+			base_info = raid_bdev_channel_get_base_info(raid_io->raid_ch, bdev_io->bdev);
+			if (base_info) {
+				raid_bdev_fail_base_bdev(base_info);
+			}
 		}
 	}
 

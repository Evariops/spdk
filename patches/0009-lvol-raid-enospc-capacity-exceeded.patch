+/* Evariops 0009: a failed member write is told apart by its NVMe status: a device
+ * fault fails the member, thin-pool exhaustion keeps it. The writes this suite
+ * fails are device faults, unless a test sets another status. */
+static int g_failed_write_sc = SPDK_NVME_SC_INTERNAL_DEVICE_ERROR;
+
+void
+spdk_bdev_io_get_nvme_status(const struct spdk_bdev_io *bdev_io, uint32_t *cdw0, int *sct, int *sc)
+{
+	*cdw0 = 0;
+	*sct = SPDK_NVME_SCT_GENERIC;
+	*sc = g_failed_write_sc;
+}

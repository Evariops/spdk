-	ublk->is_recovering = true;
-	return ublk_ctrl_cmd_submit(ublk, UBLK_CMD_START_USER_RECOVERY);
+	/* Evariops 0066: UBLK_CMD_START_USER_RECOVERY once every queue has its bdev channel. */
+	ublk_dev_get_channels(ublk, ublk_dev_start_user_recovery);
+	return 0;
 }
 

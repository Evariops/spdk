+
+/* Evariops 0066: upstream took a queue's bdev channel when the queue ran, after
+ * UBLK_CMD_START_DEV (or START_USER_RECOVERY) was sent, and asserted that it had one.
+ * Creating a channel takes buffers (the bdev and accel caches of that thread, on its
+ * first channel), and a thread short of them gets none: the process aborted, and a
+ * build without asserts served the disk through a NULL channel. Each queue now takes
+ * its channel first, on its poll group's thread; a queue that gets none fails the
+ * start or recovery with -ENOMEM before the kernel is asked for anything: a new disk
+ * is not added, and a quiesced one stays as it is, its requests held, for a retry. */
+static void ublk_dev_channels_got(void *arg);
+
+static void
+ublk_queue_get_channel(void *arg)
+{
+	struct ublk_queue *q = arg;
+
+	assert(spdk_get_thread() == q->poll_group->ublk_thread);
+	q->bdev_ch = spdk_bdev_get_io_channel(q->dev->bdev_desc);
+	if (q->bdev_ch == NULL) {
+		q->poll_group->channel_failures++;
+		SPDK_ERRLOG("ublk %u queue %u: no channel on bdev %s on thread %s (Evariops 0066)\n",
+			    q->dev->ublk_id, q->q_id, spdk_bdev_get_name(q->dev->bdev),
+			    spdk_thread_get_name(spdk_get_thread()));
+	}
+	spdk_thread_send_msg(spdk_thread_get_app_thread(), ublk_dev_channels_got, q);
+}
+
+static void
+ublk_dev_channels_got(void *arg)
+{
+	struct ublk_queue *q = arg;
+	struct spdk_ublk_dev *ublk = q->dev;
+
+	assert(spdk_thread_is_app_thread(NULL));
+	if (q->bdev_ch == NULL) {
+		ublk->channels_failed++;
+	}
+	if (--ublk->channels_pending > 0) {
+		return;
+	}
+	if (ublk->channels_failed > 0) {
+		/* The queues' channels are put, and their buffers freed, on their threads
+		 * (free_buffers); the caller is answered once the disk is gone. */
+		ublk->failed_rc = -ENOMEM;
+		ublk_free_dev(ublk);
+		return;
+	}
+	ublk->channels_next(ublk);
+}
+
+static void
+ublk_dev_get_channels(struct spdk_ublk_dev *ublk, void (*next)(struct spdk_ublk_dev *ublk))
+{
+	struct ublk_queue *q;
+	uint32_t q_id;
+
+	ublk->channels_pending = ublk->num_queues;
+	ublk->channels_failed = 0;
+	ublk->channels_next = next;
+	/* Send queue to different spdk_threads for load balance */
+	for (q_id = 0; q_id < ublk->num_queues; q_id++) {
+		q = &ublk->queues[q_id];
+		q->poll_group = &g_ublk_tgt.poll_groups[g_next_ublk_poll_group];
 		g_next_ublk_poll_group++;
 		if (g_next_ublk_poll_group == g_num_ublk_poll_groups) {
 			g_next_ublk_poll_group = 0;
 		}
+		spdk_thread_send_msg(q->poll_group->ublk_thread, ublk_queue_get_channel, q);
 	}
+}
 
-	return 0;
+static void
+ublk_dev_add(struct spdk_ublk_dev *ublk)

+
+	rc = ublk_ctrl_cmd_submit(ublk, UBLK_CMD_ADD_DEV);
+	if (rc < 0) {
+		SPDK_ERRLOG("UBLK can't add dev %d, rc %s\n", ublk->ublk_id, spdk_strerror(-rc));
+		ublk->failed_rc = rc;
+		ublk_free_dev(ublk);
+	}
+}
+
+static void
+ublk_dev_start_user_recovery(struct spdk_ublk_dev *ublk)
+{
+	int rc;
+
+	ublk->is_recovering = true;
+	rc = ublk_ctrl_cmd_submit(ublk, UBLK_CMD_START_USER_RECOVERY);
+	if (rc < 0) {
+		/* As upstream, when its recovery could not be started. */
+		ublk_delete_dev(ublk);
+		if (ublk->ctrl_cb) {
+			ublk->ctrl_cb(ublk->cb_arg, rc);
+			ublk->ctrl_cb = NULL;
+		}
+	}
 }
 
 static int
@@ -2727,8 +2850,9 @@ ublk_ctrl_start_recovery(struct spdk_ublk_dev *ublk)

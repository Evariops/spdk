+/* Evariops 0058: the length of the request's buffer i. Every buffer but the last is full. */
+static inline uint64_t
+ublk_io_iov_len(const struct ublk_io *io, int i)
+{
+	return spdk_min(io->payload_size - (uint64_t)i * UBLK_IO_IOV_BYTES, UBLK_IO_IOV_BYTES);
+}
+
+static void
+ublk_io_add_buffer(struct ublk_io *io, void *buf)
+{
+	assert(io->iovcnt < UBLK_IO_MAX_IOVS);
+	io->mpool_entries[io->iovcnt] = buf;
+	io->iovs[io->iovcnt].iov_base = (void *)(uintptr_t)SPDK_ALIGN_CEIL((uintptr_t)buf, 4096ULL);
+	io->iovs[io->iovcnt].iov_len = ublk_io_iov_len(io, io->iovcnt);
+	io->iovcnt++;
+}
+
+static void ublk_io_get_buffer_cb(struct spdk_iobuf_entry *iobuf, void *buf);
+
+/* Takes the request's buffers one at a time: when the pool is dry, the entry
+ * waits for one, and the callback goes on from there. */
+static void
+ublk_io_get_next_buffer(struct ublk_io *io)
+{
+	struct spdk_iobuf_channel *iobuf_ch = &io->q->poll_group->iobuf_ch;
+	void *buf;
+
+	while ((uint64_t)io->iovcnt * UBLK_IO_IOV_BYTES < io->payload_size) {
+		buf = spdk_iobuf_get(iobuf_ch, ublk_io_iov_len(io, io->iovcnt), &io->iobuf,
+				     ublk_io_get_buffer_cb);
+		if (buf == NULL) {
+			return;
+		}
+		ublk_io_add_buffer(io, buf);
+	}
+
+	io->payload = io->iovs[0].iov_base;
+	io->get_buf_cb(io);
+}
+
 static void
 ublk_io_get_buffer_cb(struct spdk_iobuf_entry *iobuf, void *buf)
 {
 	struct ublk_io *io = SPDK_CONTAINEROF(iobuf, struct ublk_io, iobuf);
 
-	io->mpool_entry = buf;
-	assert(io->payload == NULL);
-	io->payload = (void *)(uintptr_t)SPDK_ALIGN_CEIL((uintptr_t)buf, 4096ULL);
-	io->get_buf_cb(io);
+	ublk_io_add_buffer(io, buf);
+	ublk_io_get_next_buffer(io);
 }
 

+static void ublk_io_get_buffer_cb(struct spdk_iobuf_entry *iobuf, void *buf);
+
+/* Evariops 0058: takes the request's remaining buffers from the pool, one at a time.
+ * True once it holds them all; false when the pool is dry, the request then waiting
+ * in iobuf's queue for its next buffer. */
+static bool
+ublk_io_take_buffers(struct ublk_io *io)
+{
+	struct spdk_iobuf_channel *iobuf_ch = &io->q->poll_group->iobuf_ch;
+	void *buf;
+
+	while ((uint64_t)io->iovcnt * UBLK_IO_IOV_BYTES < io->payload_size) {
+		buf = spdk_iobuf_get(iobuf_ch, ublk_io_iov_len(io, io->iovcnt), &io->iobuf,
+				     ublk_io_get_buffer_cb);
+		if (buf == NULL) {
+			if (!io->buf_waited) {
+				io->buf_waited = true;
+				io->q->buf_waited++;
+			}
+			return false;
+		}
+		ublk_io_add_buffer(io, buf);
+	}
+	return true;
+}
+
+/* The head holds all its buffers: it leaves the head and goes on. */
+static void
+ublk_io_buffers_ready(struct ublk_io *io)
+{
+	struct ublk_poll_group *poll_group = io->q->poll_group;
+	uint64_t waited_us;
+
+	assert(poll_group->buf_head == io);
+	poll_group->buf_head = NULL;
+	poll_group->buf_holders++;
+	poll_group->last_progress_tsc = spdk_get_ticks();
+	poll_group->stall_reported = false;
+	io->q->buf_waiting--;
+	waited_us = (poll_group->last_progress_tsc - io->buf_wait_tsc) * SPDK_SEC_TO_USEC / spdk_get_ticks_hz();
+	io->q->buf_wait_max_us = spdk_max(io->q->buf_wait_max_us, waited_us);
+	io->payload = io->iovs[0].iov_base;
+	io->get_buf_cb(io);
+}
+
+/* Evariops 0058: the poll group's requests acquire their buffers one at a time, in
+ * arrival order: the head takes buffers, the others wait holding none. Requests that
+ * each held part of what they need while the pool was dry could otherwise wait for
+ * one another for ever: iobuf serves a thread's waiters only with buffers given back
+ * on that thread, and a new request may pass them. */
+static void
+ublk_buffers_pump(struct ublk_poll_group *poll_group)
+{
+	struct ublk_io *io;
+
+	while (poll_group->buf_head == NULL && (io = TAILQ_FIRST(&poll_group->buf_waiters)) != NULL) {
+		TAILQ_REMOVE(&poll_group->buf_waiters, io, buf_tailq);
+		poll_group->buf_head = io;
+		if (!ublk_io_take_buffers(io)) {
+			return;
+		}
+		ublk_io_buffers_ready(io);
+	}
+}

+/* Evariops 0058: with user copy, a request's data moves by a vectored read or
+ * write of the char device, so it need not fit one iobuf buffer. It is carried
+ * in up to UBLK_IO_MAX_IOVS buffers of UBLK_IO_IOV_BYTES: a large iobuf buffer
+ * (132 KiB by default) holds one with room to align it on 4 KiB. */
+#define UBLK_IO_IOV_BYTES				(128 * 1024)
+#define UBLK_IO_MAX_IOVS				8
+#define UBLK_USER_COPY_IO_MAX_BYTES			(UBLK_IO_IOV_BYTES * UBLK_IO_MAX_IOVS)

+/* Evariops 0058: the poll group's progress reserve, one maximum request's buffers taken
+ * when the poll group starts. The head takes from it when nothing in flight on this
+ * thread can give a buffer back, so the poll group always moves, one request at a
+ * time at worst, whatever the other threads and modules hold. */
+#define UBLK_RESERVE_SMALL_BYTES	4096
+
+static bool
+ublk_reserve_take(struct ublk_poll_group *poll_group)
+{
+	struct spdk_iobuf_opts opts;
+
+	spdk_iobuf_get_opts(&opts, sizeof(opts));
+	poll_group->small_bufsize = opts.small_bufsize;
+	while (poll_group->reserve_large_count < UBLK_IO_MAX_IOVS) {
+		poll_group->reserve_large[poll_group->reserve_large_count] =
+			spdk_iobuf_get(&poll_group->iobuf_ch, UBLK_IO_IOV_BYTES, NULL, NULL);
+		if (poll_group->reserve_large[poll_group->reserve_large_count] == NULL) {
+			return false;
+		}
+		poll_group->reserve_large_count++;
+	}
+	poll_group->reserve_small = spdk_iobuf_get(&poll_group->iobuf_ch, UBLK_RESERVE_SMALL_BYTES, NULL, NULL);
+	return poll_group->reserve_small != NULL;
+}
+
+static void
+ublk_reserve_release(struct ublk_poll_group *poll_group)
+{
+	while (poll_group->reserve_large_count > 0) {
+		spdk_iobuf_put(&poll_group->iobuf_ch, poll_group->reserve_large[--poll_group->reserve_large_count],
+			       UBLK_IO_IOV_BYTES);
+	}
+	if (poll_group->reserve_small != NULL) {
+		spdk_iobuf_put(&poll_group->iobuf_ch, poll_group->reserve_small, UBLK_RESERVE_SMALL_BYTES);
+		poll_group->reserve_small = NULL;
+	}
+}
+
+/* Nothing in flight on this thread gives a buffer back, and the pool did not serve the
+ * head: the head completes its buffers from the reserve. */
+static void
+ublk_buffers_rescue(struct ublk_poll_group *poll_group)
+{
+	struct ublk_io *io = poll_group->buf_head;
+	uint64_t len;
+	void *buf;
+
+	if (io == NULL || poll_group->buf_holders > 0 || poll_group->reserve_lent) {
+		return;
+	}
+	spdk_iobuf_entry_abort(&poll_group->iobuf_ch, &io->iobuf, ublk_io_iov_len(io, io->iovcnt));
+	while ((uint64_t)io->iovcnt * UBLK_IO_IOV_BYTES < io->payload_size) {
+		len = ublk_io_iov_len(io, io->iovcnt);
+		if (len <= poll_group->small_bufsize) {
+			buf = poll_group->reserve_small;
+			poll_group->reserve_small = NULL;
+		} else {
+			buf = poll_group->reserve_large[--poll_group->reserve_large_count];
+		}
+		assert(buf != NULL);
+		io->reserve_mask |= 1u << io->iovcnt;
+		ublk_io_add_buffer(io, buf);
+	}
+	poll_group->reserve_lent = true;
+	io->q->reserve_uses++;
+	ublk_io_buffers_ready(io);
+	ublk_buffers_pump(poll_group);
+}
+
+/* A head that waited a second while nothing moved on its thread is reported once: the
+ * reserve makes this a defect to find, not a state to live in. Nothing fails. */
+static void
+ublk_buffers_watch(struct ublk_poll_group *poll_group)
+{
+	struct ublk_io *io = poll_group->buf_head;
+	uint64_t now, hz;
+
+	if (io == NULL || poll_group->stall_reported) {
+		return;
+	}
+	now = spdk_get_ticks();
+	hz = spdk_get_ticks_hz();
+	if (now - io->buf_wait_tsc < hz || now - poll_group->last_progress_tsc < hz) {
+		return;
+	}
+	poll_group->stall_reported = true;
+	io->q->stalls++;
+	SPDK_ERRLOG("ublk %u queue %u: a request has waited %" PRIu64 " ms for its buffers with nothing "
+		    "moving on its thread: %u holding buffers in flight, %d of its %" PRIu64 " bytes' "
+		    "buffers held, reserve %s (Evariops 0058)\n",
+		    io->q->dev->ublk_id, io->q->q_id, (now - io->buf_wait_tsc) * 1000 / hz,
+		    poll_group->buf_holders, io->iovcnt, io->payload_size,
+		    poll_group->reserve_lent ? "lent" : "free");
 }
 

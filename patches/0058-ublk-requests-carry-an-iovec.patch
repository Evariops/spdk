+static void
+ublk_io_add_buffer(struct ublk_io *io, void *buf)
+{
+	assert(io->iovcnt < UBLK_IO_MAX_IOVS);
+	io->mpool_entries[io->iovcnt] = buf;
+	io->iovs[io->iovcnt].iov_base = (void *)(uintptr_t)SPDK_ALIGN_CEIL((uintptr_t)buf, 4096ULL);
+	io->iovs[io->iovcnt].iov_len = ublk_io_iov_len(io, io->iovcnt);
+	io->iovcnt++;
+}

+/* Evariops 0058: the length of the request's buffer i. Every buffer but the last is full. */
+static inline uint64_t
+ublk_io_iov_len(const struct ublk_io *io, int i)
+{
+	return spdk_min(io->payload_size - (uint64_t)i * UBLK_IO_IOV_BYTES, UBLK_IO_IOV_BYTES);

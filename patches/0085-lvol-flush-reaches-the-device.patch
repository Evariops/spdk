+/* Evariops 0085: spdk_blob_io_flush reaches the store's device once, and completes at once,
+ * sending nothing, on a device without flush. */
+static void
+blob_flush(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_power_failure_thresholds thresholds = {};
+	struct spdk_blob *blob;
+	struct spdk_io_channel *channel;
+	struct spdk_blob_opts opts;
+	void (*flush)(struct spdk_bs_dev *dev, struct spdk_io_channel *channel,
+		      struct spdk_bs_dev_cb_args *cb_args);
+
+	channel = spdk_bs_alloc_io_channel(bs);
+	CU_ASSERT(channel != NULL);
+
+	ut_spdk_blob_opts_init(&opts);
+	opts.num_clusters = 1;
+	blob = ut_blob_create_and_open(bs, &opts);
+
+	/* A threshold far away counts the device's flushes without failing them. */
+	thresholds.flush_threshold = 1000;
+	dev_reset_power_failure_counters();
+	dev_set_power_failure_thresholds(thresholds);
+	g_bserrno = -1;
+	spdk_blob_io_flush(blob, channel, blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	CU_ASSERT(g_power_failure_counters.flush_counter == 1);
+
+	flush = bs->dev->flush;
+	bs->dev->flush = NULL;
+	g_bserrno = -1;
+	spdk_blob_io_flush(blob, channel, blob_op_complete, NULL);
+	CU_ASSERT(g_bserrno == 0);
+	poll_threads();
+	CU_ASSERT(g_power_failure_counters.flush_counter == 1);
+	bs->dev->flush = flush;
+	dev_reset_power_failure_event();
+
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+
+	ut_blob_close_and_delete(bs, blob);
+}

diff --git a/lib/blob/blobstore.c b/lib/blob/blobstore.c
index 626e6bee9..a76578095 100644
--- a/lib/blob/blobstore.c
+++ b/lib/blob/blobstore.c
@@ -9830,6 +9830,35 @@ spdk_blob_io_unmap(struct spdk_blob *blob, struct spdk_io_channel *channel,
 			       SPDK_BLOB_UNMAP);
 }
 
+/* Evariops 0085: what the blob's writes left in the device's volatile cache is made durable.
+ * The cache is the device's, shared by every blob of the store: flushing it for one blob
+ * flushes it for all, and a device without flush has nothing to flush. */
+void
+spdk_blob_io_flush(struct spdk_blob *blob, struct spdk_io_channel *channel,
+		   spdk_blob_op_complete cb_fn, void *cb_arg)
+{
+	struct spdk_bs_cpl cpl;
+	spdk_bs_batch_t *batch;
+
+	if (blob->bs->dev->flush == NULL) {
+		cb_fn(cb_arg, 0);
+		return;
+	}
+
+	cpl.type = SPDK_BS_CPL_TYPE_BLOB_BASIC;
+	cpl.u.blob_basic.cb_fn = cb_fn;
+	cpl.u.blob_basic.cb_arg = cb_arg;
+
+	batch = bs_batch_open(channel, &cpl, blob);
+	if (!batch) {
+		cb_fn(cb_arg, -ENOMEM);
+		return;
+	}
+
+	bs_batch_flush_dev(batch);
+	bs_batch_close(batch);
+}

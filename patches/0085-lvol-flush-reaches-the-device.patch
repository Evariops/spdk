+/* Evariops 0085: the base bdev's flush, over the whole device; set only when it has one. */
+static void
+bdev_blob_flush(struct spdk_bs_dev *dev, struct spdk_io_channel *channel,
+		struct spdk_bs_dev_cb_args *cb_args)
+{
+	int rc;
+
+	rc = spdk_bdev_flush_blocks(__get_desc(dev), channel, 0, dev->blockcnt,
+				    bdev_blob_io_complete, cb_args);
+	if (rc == -ENOMEM) {
+		bdev_blob_queue_io(dev, channel, NULL, 0, 0, 0,
+				   dev->blockcnt, SPDK_BDEV_IO_TYPE_FLUSH, cb_args, NULL);
+	} else if (rc != 0) {
+		cb_args->cb_fn(cb_args->channel, cb_args->cb_arg, rc);
+	}
+}

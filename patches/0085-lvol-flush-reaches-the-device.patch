+/**
+ * Make durable the writes the blobstore's device holds in a volatile cache (Evariops 0085).
+ *
+ * The cache belongs to the device: the flush covers every blob of the store. Completes at
+ * once with no error when the device has no flush.
+ *
+ * \param blob Blob whose writes are to be made durable.
+ * \param channel I/O channel used to submit requests.
+ * \param cb_fn Called when the operation is complete.
+ * \param cb_arg Argument passed to function cb_fn.
+ */
+void spdk_blob_io_flush(struct spdk_blob *blob, struct spdk_io_channel *channel,
+			spdk_blob_op_complete cb_fn, void *cb_arg);

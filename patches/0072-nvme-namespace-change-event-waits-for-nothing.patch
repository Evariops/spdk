+
+/*
+ * Evariops 0072: nvme_ns_identify_async takes nvme_ns_identify's steps, each at the previous
+ * one's completion, and calls back once at the end. A step whose completion has not come leaves
+ * the callback pending, and nothing waits for it.
+ */
+static void
+test_nvme_ns_identify_async(void)
+{
+	struct spdk_nvme_ctrlr ctrlr = {};
+	struct spdk_nvme_ns *ns = ut_ns_alloc(1, &ctrlr);
+	struct spdk_nvme_ns_data nsdata = { .ncap = 1 };
+	struct spdk_nvme_cpl cpl = {};
+
+	g_ut_ns = ns;
+	ns->csi = SPDK_NVME_CSI_NVM;
+	fake_nsdata = &nsdata;
+
+	/* Before 1.3 a controller has no descriptor list: the data, then the callback. */
+	ctrlr.vs.raw = SPDK_NVME_VERSION(1, 2, 0);
+	g_ut_identify_async_calls = 0;
+	CU_ASSERT(nvme_ns_identify_async(ns, ut_identify_async_cb, NULL) == 0);
+	CU_ASSERT(g_ut_identify_async_calls == 1);
+	CU_ASSERT(g_ut_identify_async_rc == 0);
+
+	/* From 1.3 the descriptor list is asked, and the stub holds its completion. */
+	ctrlr.vs.raw = SPDK_NVME_VERSION(1, 3, 0);
+	g_ut_identify_async_calls = 0;
+	g_ut_id_desc_cb = NULL;
+	CU_ASSERT(nvme_ns_identify_async(ns, ut_identify_async_cb, NULL) == 0);
+	CU_ASSERT(g_ut_identify_async_calls == 0);
+	SPDK_CU_ASSERT_FATAL(g_ut_id_desc_cb != NULL);
+
+	g_ut_id_desc_cb(g_ut_id_desc_arg, &cpl);
+	CU_ASSERT(g_ut_identify_async_calls == 1);
+	CU_ASSERT(g_ut_identify_async_rc == 0);
+
+	g_ut_id_desc_cb = NULL;
+	fake_nsdata = NULL;
+	ut_ns_free(ns);
+	g_ut_ns = NULL;
+}

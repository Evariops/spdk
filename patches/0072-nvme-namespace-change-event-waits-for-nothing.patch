 }
+
+/*
+ * Evariops 0072: nvme_ns_identify with no wait, for the namespace-change event. The same steps,
+ * each started by the previous one's completion: the namespace's data, then, when it is active,
+ * its descriptors, then its command-set data. The namespace is found again by id at each step.
+ * cb_fn is invoked exactly once, with what nvme_ns_identify would return, when 0 is returned; a
+ * failure to submit the first command is returned, and cb_fn is not invoked.
+ */
+struct nvme_ns_identify_async_ctx {
+	struct spdk_nvme_ctrlr *ctrlr;
+	nvme_ns_async_cb_fn cb_fn;
+	void *cb_arg;
+};
+
+static void
+nvme_ns_identify_async_done(struct nvme_ns_identify_async_ctx *ctx, uint32_t nsid, int rc)
+{
+	nvme_ns_async_cb_fn cb_fn = ctx->cb_fn;
+	void *cb_arg = ctx->cb_arg;
+
+	free(ctx);
+	cb_fn(nsid, cb_arg, rc);
+}
+
+static void
+nvme_ns_identify_async_iocs_cb(uint32_t nsid, void *arg, int rc)
+{
+	nvme_ns_identify_async_done(arg, nsid, rc);
+}
+
+static void
+nvme_ns_identify_async_id_desc_cb(uint32_t nsid, void *arg, int rc)
+{
+	struct nvme_ns_identify_async_ctx *ctx = arg;
+	struct spdk_nvme_ns *ns;
+
+	if (rc != 0) {
+		nvme_ns_identify_async_done(ctx, nsid, rc);
+		return;
+	}
+
+	ns = nvme_ctrlr_find_ns(ctx->ctrlr, nsid);
+	if (ns == NULL) {
+		nvme_ns_identify_async_done(ctx, nsid, -ENODEV);
+		return;
+	}
+
+	if (!nvme_ctrlr_multi_iocs_enabled(ctx->ctrlr) ||
+	    !nvme_ns_has_supported_iocs_specific_data(ns)) {
+		nvme_ns_identify_async_done(ctx, nsid, 0);
+		return;
+	}
+
+	rc = nvme_ns_identify_iocs_specific_async(ns, NULL, nvme_ns_identify_async_iocs_cb, ctx);
+	if (rc != 0) {
+		nvme_ns_identify_async_done(ctx, nsid, rc);
+	}
+}
+
+static void
+nvme_ns_identify_async_data_cb(uint32_t nsid, void *arg, int rc)
+{
+	struct nvme_ns_identify_async_ctx *ctx = arg;
+	struct spdk_nvme_ns *ns;
+
+	if (rc != 0) {
+		nvme_ns_identify_async_done(ctx, nsid, rc);
+		return;
+	}
+
+	ns = nvme_ctrlr_find_ns(ctx->ctrlr, nsid);
+	if (ns == NULL) {
+		nvme_ns_identify_async_done(ctx, nsid, -ENODEV);
+		return;
+	}
+
+	if (!spdk_nvme_ns_is_active(ns)) {
+		nvme_ns_identify_async_done(ctx, nsid, 0);
+		return;
+	}
+
+	rc = nvme_ns_identify_id_desc_async(ns, NULL, nvme_ns_identify_async_id_desc_cb, ctx);
+	if (rc != 0) {
+		nvme_ns_identify_async_done(ctx, nsid, rc);
+	}
+}
+
+int
+nvme_ns_identify_async(struct spdk_nvme_ns *ns, nvme_ns_async_cb_fn cb_fn, void *cb_arg)
+{
+	struct nvme_ns_identify_async_ctx *ctx;
+	int rc;
+
+	assert(ns->id > 0);
+	assert(cb_fn != NULL);
+
+	ctx = calloc(1, sizeof(*ctx));
+	if (!ctx) {
+		return -ENOMEM;
+	}
+
+	ctx->ctrlr = ns->ctrlr;
+	ctx->cb_fn = cb_fn;
+	ctx->cb_arg = cb_arg;
+
+	rc = nvme_ns_identify_data_async(ns, NULL, nvme_ns_identify_async_data_cb, ctx);
+	if (rc != 0) {
+		free(ctx);
+	}
+
+	return rc;
+}

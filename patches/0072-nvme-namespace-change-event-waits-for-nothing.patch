+	DECLARE_AND_CONSTRUCT_CTRLR();
+	uint32_t active_ns_list[] = { 1, 2, 100 };
+	uint32_t changed_ns_list[] = { 100 };
+	union spdk_nvme_async_event_completion	aer_event = {
+		.bits.async_event_type = SPDK_NVME_ASYNC_EVENT_TYPE_NOTICE,
+		.bits.async_event_info = SPDK_NVME_ASYNC_EVENT_NS_ATTR_CHANGED
+	};
+	struct spdk_nvme_cpl aer_cpl = {
+		.status.sct = SPDK_NVME_SCT_GENERIC,
+		.status.sc = SPDK_NVME_SC_SUCCESS,
+		.cdw0 = aer_event.raw
+	};
+	struct spdk_nvme_cpl done = {
+		.status.sct = SPDK_NVME_SCT_GENERIC,
+		.status.sc = SPDK_NVME_SC_SUCCESS,
+	};
+	struct spdk_nvme_cpl aborted = {
+		.status.sct = SPDK_NVME_SCT_GENERIC,
+		.status.sc = SPDK_NVME_SC_ABORTED_SQ_DELETION,
+	};
+	spdk_nvme_cmd_cb cb;
+
+	SPDK_CU_ASSERT_FATAL(nvme_ctrlr_construct(&ctrlr) == 0);
+
+	ctrlr.vs.bits.mjr = 1;
+	ctrlr.vs.bits.mnr = 2;
+	ctrlr.vs.bits.ter = 0;
+	ctrlr.cdata.nn = 4096;
+
+	ctrlr.state = NVME_CTRLR_STATE_CONFIGURE_AER;
+	g_active_ns_list = active_ns_list;
+	g_active_ns_list_length = SPDK_COUNTOF(active_ns_list);
+	while (ctrlr.state != NVME_CTRLR_STATE_READY) {
+		SPDK_CU_ASSERT_FATAL(nvme_ctrlr_process_init(&ctrlr) == 0);
+	}
+
+	CU_ASSERT(nvme_ctrlr_add_process(&ctrlr, NULL) == 0);
+	spdk_nvme_ctrlr_register_aer_callback(&ctrlr, aer_cb, NULL);
+
+	g_defer_changed_ns_log = true;
+	g_wait_for_adminq_calls = 0;
+	g_aer_cb_counter = 0;
+	g_changed_ns_list = changed_ns_list;
+	g_changed_ns_list_length = SPDK_COUNTOF(changed_ns_list);
+
+	nvme_ctrlr_async_event_cb(&ctrlr.aer[0], &aer_cpl);
+	nvme_ctrlr_complete_queued_async_events(&ctrlr);
+
+	/* Submitted, not completed: the event is in progress, and nothing waited for it. */
+	SPDK_CU_ASSERT_FATAL(g_deferred_log_cb != NULL);
+	CU_ASSERT(ctrlr.async_event_in_progress != NULL);
+	CU_ASSERT(g_aer_cb_counter == 0);
+	CU_ASSERT(g_wait_for_adminq_calls == 0);
+
+	cb = g_deferred_log_cb;
+	g_deferred_log_cb = NULL;
+	cb(g_deferred_log_arg, &done);
+
+	CU_ASSERT(ctrlr.async_event_in_progress == NULL);
+	CU_ASSERT(g_aer_cb_counter == 1);
+	CU_ASSERT(g_wait_for_adminq_calls == 0);
+
+	/* The next event's log is aborted with its queue: the event ends, with no callback. */
+	nvme_ctrlr_async_event_cb(&ctrlr.aer[0], &aer_cpl);
+	nvme_ctrlr_complete_queued_async_events(&ctrlr);
+	SPDK_CU_ASSERT_FATAL(g_deferred_log_cb != NULL);
+	CU_ASSERT(ctrlr.async_event_in_progress != NULL);
+
+	cb = g_deferred_log_cb;
+	g_deferred_log_cb = NULL;
+	cb(g_deferred_log_arg, &aborted);
+
+	CU_ASSERT(ctrlr.async_event_in_progress == NULL);
+	CU_ASSERT(g_aer_cb_counter == 1);
+	CU_ASSERT(g_wait_for_adminq_calls == 0);
+
+	g_defer_changed_ns_log = false;
+	nvme_ctrlr_free_processes(&ctrlr);
+	nvme_ctrlr_destruct(&ctrlr);
+}

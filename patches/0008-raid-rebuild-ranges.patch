diff --git a/include/spdk/bdev_module.h b/include/spdk/bdev_module.h
index fce200b..e4a45e7 100644
--- a/include/spdk/bdev_module.h
+++ b/include/spdk/bdev_module.h
@@ -1954,6 +1954,21 @@ int spdk_bdev_unquiesce_range(struct spdk_bdev *bdev, struct spdk_bdev_module *m
 			      uint64_t offset, uint64_t length,
 			      spdk_bdev_quiesce_cb cb_fn, void *cb_arg);
 
+/* Evariops 0008: channel-owned LBA range lock. The lock is granted once in-flight
+ * I/O has drained; new I/O overlapping [offset, offset + length) is queued and
+ * replayed at unlock. The owning channel is exempt: an I/O submitted on ch whose
+ * cb_arg equals the lock's cb_arg passes straight through, which is what a
+ * read-modify-write repair needs. Both calls must run on the thread owning ch. */
+struct lba_range;
+typedef void (*spdk_bdev_lba_range_cb)(struct lba_range *range, void *ctx, int status);
+
+int spdk_bdev_lock_lba_range(struct spdk_bdev_desc *desc, struct spdk_io_channel *ch,
+			     uint64_t offset, uint64_t length,
+			     spdk_bdev_lba_range_cb cb_fn, void *cb_arg);
+int spdk_bdev_unlock_lba_range(struct spdk_bdev_desc *desc, struct spdk_io_channel *ch,
+			       uint64_t offset, uint64_t length,
+			       spdk_bdev_lba_range_cb cb_fn, void *cb_arg);
+
 /*
  *  Macro used to register module for later initialization.
  */
diff --git a/lib/bdev/bdev.c b/lib/bdev/bdev.c
index 98e01ca..a7ccfe6 100644
--- a/lib/bdev/bdev.c
+++ b/lib/bdev/bdev.c
@@ -11189,6 +11189,30 @@ spdk_bdev_unquiesce_range(struct spdk_bdev *bdev, struct spdk_bdev_module *modul
 	return _spdk_bdev_quiesce(bdev, module, offset, length, cb_fn, cb_arg, true);
 }
 
+/* Evariops 0008: expose the channel-owned LBA range lock already used by the
+ * COMPARE_AND_WRITE emulation. Unlike quiesce, the owning channel may keep
+ * submitting into the locked range as long as the I/O's cb_arg equals the lock's
+ * cb_arg (see bdev_io_range_is_locked), which is what a read-modify-write repair
+ * needs: host I/O is held and replayed at unlock while the repair's own I/O flows. */
+int
+spdk_bdev_lock_lba_range(struct spdk_bdev_desc *desc, struct spdk_io_channel *ch,
+			 uint64_t offset, uint64_t length,
+			 spdk_bdev_lba_range_cb cb_fn, void *cb_arg)
+{
+	/* Pass cb_fn without a cast: spdk_bdev_lba_range_cb and the internal
+	 * lock_range_cb are compatible types today, and keeping the compiler's check
+	 * means a future divergence breaks the build instead of failing at runtime. */
+	return bdev_lock_lba_range(desc, ch, offset, length, cb_fn, cb_arg);
+}
+
+int
+spdk_bdev_unlock_lba_range(struct spdk_bdev_desc *desc, struct spdk_io_channel *ch,
+			   uint64_t offset, uint64_t length,
+			   spdk_bdev_lba_range_cb cb_fn, void *cb_arg)
+{
+	return bdev_unlock_lba_range(desc, ch, offset, length, cb_fn, cb_arg);
+}

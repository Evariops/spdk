+/* Evariops 0016: the content generation the survivors carry. A member joining
+ * the array adopts it in the same superblock transaction as its CONFIGURED
+ * flip, which is the point at which its content matches the survivors'. */
+static uint64_t
+raid_bdev_sb_max_content_generation(const struct raid_bdev_superblock *sb)
+{
+	uint64_t max_gen = 0;
+	uint8_t i;
+
+	for (i = 0; i < sb->base_bdevs_size; i++) {
+		const struct raid_bdev_sb_base_bdev *sb_base_bdev = &sb->base_bdevs[i];
+
+		if (sb_base_bdev->state == RAID_SB_BASE_BDEV_CONFIGURED &&
+		    sb_base_bdev->content_generation > max_gen) {
+			max_gen = sb_base_bdev->content_generation;
+		}
+	}
+
+	return max_gen;
+}

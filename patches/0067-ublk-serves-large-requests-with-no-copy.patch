+/*
+ * Evariops 0067: zero copy. A read or write of at least zc_min_bytes on a disk that serves it has
+ * its pages registered in the queue's ring at index tag (UBLK_IO_REGISTER_IO_BUF, one command,
+ * answered as the ring is entered); its bdev I/O then carries them as the ublk-zc memory domain,
+ * one iovec, and the bdev reads or writes them with fixed operations on the same ring. Once the
+ * bdev I/O has completed, every operation on the pages has: they are unregistered, then the
+ * request is committed, in one submission. A registration that fails falls back to a copy, as
+ * does every request below the size, every other command, and every request of a disk whose
+ * bdev does not serve the domain. No iobuf buffer is taken: the copy path's buffers (U-20)
+ * are not on the way.
+ */
+static bool
+ublk_zc_queue_buf_cmd(struct ublk_queue *q, struct ublk_io *io, uint32_t cmd_op)
+{
+	struct ublksrv_io_cmd *cmd;
+	struct io_uring_sqe *sqe;
+
+	sqe = io_uring_get_sqe(&q->ring);
+	if (spdk_unlikely(sqe == NULL)) {
+		return false;
+	}
+
+	/* The entry may last have held another operation: none of its bytes is left. */
+	memset(sqe, 0, 2 * sizeof(*sqe));
+	cmd = (struct ublksrv_io_cmd *)ublk_get_sqe_cmd(sqe);
+	ublk_set_sqe_cmd_op(sqe, cmd_op);
+	sqe->fd = 0;
+	sqe->opcode = IORING_OP_URING_CMD;
+	sqe->flags = IOSQE_FIXED_FILE;
+	cmd->q_id = q->q_id;
+	cmd->tag = io->tag;
+	/* The index in the ring's buffer table. */
+	cmd->addr = io->tag;
+	io_uring_sqe_set_data64(sqe, build_user_data(io->tag, cmd_op));
+
+	return true;
+}
+
+static void
+ublk_zc_registered(struct ublk_queue *q, struct ublk_io *io, int32_t res)
+{
+	if (spdk_unlikely(res != 0)) {
+		SPDK_DEBUGLOG(ublk_io, "(qid %d tag %u) pages not registered (%d): copied\n",
+			      q->q_id, io->tag, res);
+		q->zc_fallbacks++;
+		ublk_submit_bdev_io_copied(q, io);
+		return;
+	}
+
+	io->zc_registered = true;
+	io->zc_ctx.ring = &q->ring;
+	io->zc_ctx.buf_index = io->tag;
+	io->zc_iov.iov_base = (void *)(uintptr_t)SPDK_UBLK_ZC_ADDR_BASE;
+	io->zc_iov.iov_len = io->result;
+	q->zc_ios++;
+	_ublk_submit_bdev_io(q, io);
+}
+
+static void
+ublk_submit_bdev_io(struct ublk_queue *q, struct ublk_io *io)
+{
+	const struct ublksrv_io_desc *iod = io->iod;
+	uint8_t ublk_op = ublksrv_get_op(iod);
+
+	io->result = iod->nr_sectors * (1ULL << LINUX_SECTOR_SHIFT);
+	if (q->dev->zero_copy && (ublk_op == UBLK_IO_OP_READ || ublk_op == UBLK_IO_OP_WRITE) &&
+	    (uint32_t)io->result >= g_ublk_tgt.zc_min_bytes) {
+		if (ublk_zc_queue_buf_cmd(q, io, UBLK_IO_REGISTER_IO_BUF)) {
+			/* ublk_zc_registered goes on, from the registration's completion. */
+			return;
+		}
+		q->zc_fallbacks++;
+	}
+	ublk_submit_bdev_io_copied(q, io);
+}
+
+/* Evariops 0067: a copy between a request's pages and local memory, through the char device as
+ * user copy moves them, for a layer that needs the data in hand: the ublk-zc domain's pull,
+ * push and memzero. One vectored read or write of the char device per domain iovec, on the
+ * request's ring; answered once all have completed with all their bytes. */
+#define UBLK_ZC_COPY_MAX_IOVS	64
+#define UBLK_ZC_ZEROES_BYTES	(64 * 1024)
+
+static uint8_t g_ublk_zeroes[UBLK_ZC_ZEROES_BYTES] __attribute__((aligned(4096)));
+
+struct ublk_zc_copy {
+	struct spdk_ublk_zc_op		op;
+	spdk_memory_domain_data_cpl_cb	cpl_cb;
+	void				*cpl_cb_arg;
+	uint32_t			pending;
+	int				rc;
+	uint64_t			expected;
+	uint64_t			done;
+	/* The local side of each domain iovec, sliced: segment i is iovs[start[i]..start[i+1]). */
+	struct iovec			iovs[UBLK_ZC_COPY_MAX_IOVS];
+	uint32_t			start[UBLK_ZC_COPY_MAX_IOVS + 1];
+};
+
+static void
+ublk_zc_copy_done(struct spdk_ublk_zc_op *op, int32_t res)
+{
+	struct ublk_zc_copy *copy = SPDK_CONTAINEROF(op, struct ublk_zc_copy, op);
+	spdk_memory_domain_data_cpl_cb cpl_cb;
+	void *cpl_cb_arg;
+	int rc;
+
+	if (res < 0) {
+		copy->rc = res;
+	} else {
+		copy->done += (uint64_t)res;
+	}
+	if (--copy->pending > 0) {
+		return;
+	}
+
+	rc = copy->rc != 0 ? copy->rc : (copy->done == copy->expected ? 0 : -EIO);
+	cpl_cb = copy->cpl_cb;
+	cpl_cb_arg = copy->cpl_cb_arg;
+	free(copy);

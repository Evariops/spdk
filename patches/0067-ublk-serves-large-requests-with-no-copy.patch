+/* Slices the local iovecs (or, with local NULL, the zero buffer) along the domain iovecs, then
+ * prepares the reads (pages to local) or writes (local to pages) of the char device. Nothing is
+ * prepared unless all can be. */
+static int
+ublk_zc_copy(void *domain_ctx, bool to_pages, struct iovec *dom_iov, uint32_t dom_iovcnt,
+	     struct iovec *local_iov, uint32_t local_iovcnt, spdk_memory_domain_data_cpl_cb cpl_cb,
+	     void *cpl_cb_arg)
+{
+	struct ublk_io *io = SPDK_CONTAINEROF(domain_ctx, struct ublk_io, zc_ctx);
+	struct ublk_queue *q = io->q;
+	struct ublk_zc_copy *copy;
+	struct io_uring_sqe *sqe;
+	uint32_t d, used = 0, local_idx = 0;
+	uint64_t local_off = 0, len, n, avail, pos;
+
+	if (dom_iovcnt == 0 || dom_iovcnt > UBLK_ZC_COPY_MAX_IOVS ||
+	    io_uring_sq_space_left(&q->ring) < dom_iovcnt) {
+		return -ENOMEM;
+	}
+	copy = calloc(1, sizeof(*copy));
+	if (copy == NULL) {
+		return -ENOMEM;
+	}
+
+	for (d = 0; d < dom_iovcnt; d++) {
+		copy->start[d] = used;
+		len = dom_iov[d].iov_len;
+		copy->expected += len;
+		while (len > 0) {
+			if (used == UBLK_ZC_COPY_MAX_IOVS) {
+				free(copy);
+				return -ENOMEM;
+			}
+			if (local_iov == NULL) {
+				n = spdk_min(len, (uint64_t)UBLK_ZC_ZEROES_BYTES);
+				copy->iovs[used].iov_base = g_ublk_zeroes;
+			} else {
+				if (local_idx == local_iovcnt) {
+					free(copy);
+					return -EINVAL;
+				}
+				avail = local_iov[local_idx].iov_len - local_off;
+				n = spdk_min(len, avail);
+				copy->iovs[used].iov_base = (uint8_t *)local_iov[local_idx].iov_base + local_off;
+				local_off += n;
+				if (local_off == local_iov[local_idx].iov_len) {
+					local_idx++;
+					local_off = 0;
+				}
+			}
+			copy->iovs[used].iov_len = n;
+			used++;
+			len -= n;
+		}
+	}
+	copy->start[dom_iovcnt] = used;
+	copy->op.cb = ublk_zc_copy_done;
+	copy->cpl_cb = cpl_cb;
+	copy->cpl_cb_arg = cpl_cb_arg;
+	copy->pending = dom_iovcnt;
+
+	for (d = 0; d < dom_iovcnt; d++) {
+		pos = ublk_user_copy_pos(q->q_id, io->tag) +
+		      ((uint64_t)(uintptr_t)dom_iov[d].iov_base - SPDK_UBLK_ZC_ADDR_BASE);
+		sqe = io_uring_get_sqe(&q->ring);
+		assert(sqe != NULL);
+		memset(sqe, 0, 2 * sizeof(*sqe));
+		if (to_pages) {
+			io_uring_prep_writev(sqe, 0, &copy->iovs[copy->start[d]], copy->start[d + 1] - copy->start[d], pos);
+		} else {
+			io_uring_prep_readv(sqe, 0, &copy->iovs[copy->start[d]], copy->start[d + 1] - copy->start[d], pos);
+		}
+		io_uring_sqe_set_flags(sqe, IOSQE_FIXED_FILE);
+		io_uring_sqe_set_data64(sqe, (uint64_t)(uintptr_t)&copy->op | SPDK_UBLK_ZC_OP_FLAG);
+	}
+
+	return 0;
+}
+
+static int
+ublk_zc_pull(struct spdk_memory_domain *src_domain, void *src_domain_ctx,
+	     struct iovec *src_iov, uint32_t src_iovcnt, struct iovec *dst_iov, uint32_t dst_iovcnt,
+	     spdk_memory_domain_data_cpl_cb cpl_cb, void *cpl_cb_arg)
+{
+	return ublk_zc_copy(src_domain_ctx, false, src_iov, src_iovcnt, dst_iov, dst_iovcnt, cpl_cb, cpl_cb_arg);
+}
+
+static int
+ublk_zc_push(struct spdk_memory_domain *dst_domain, void *dst_domain_ctx,
+	     struct iovec *dst_iov, uint32_t dst_iovcnt, struct iovec *src_iov, uint32_t src_iovcnt,
+	     spdk_memory_domain_data_cpl_cb cpl_cb, void *cpl_cb_arg)
+{
+	return ublk_zc_copy(dst_domain_ctx, true, dst_iov, dst_iovcnt, src_iov, src_iovcnt, cpl_cb, cpl_cb_arg);
+}
+
+static int
+ublk_zc_memzero(struct spdk_memory_domain *domain, void *domain_ctx, struct iovec *iov,
+		uint32_t iovcnt, spdk_memory_domain_data_cpl_cb cpl_cb, void *cpl_cb_arg)

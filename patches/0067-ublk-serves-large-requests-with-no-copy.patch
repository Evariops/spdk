+/* Evariops 0067 */
+static int ublk_zc_pull(struct spdk_memory_domain *src_domain, void *src_domain_ctx,
+			struct iovec *src_iov, uint32_t src_iovcnt, struct iovec *dst_iov, uint32_t dst_iovcnt,
+			spdk_memory_domain_data_cpl_cb cpl_cb, void *cpl_cb_arg);
+static int ublk_zc_push(struct spdk_memory_domain *dst_domain, void *dst_domain_ctx,
+			struct iovec *dst_iov, uint32_t dst_iovcnt, struct iovec *src_iov, uint32_t src_iovcnt,
+			spdk_memory_domain_data_cpl_cb cpl_cb, void *cpl_cb_arg);
+static int ublk_zc_memzero(struct spdk_memory_domain *domain, void *domain_ctx, struct iovec *iov,
+			   uint32_t iovcnt, spdk_memory_domain_data_cpl_cb cpl_cb, void *cpl_cb_arg);
+
+void
+ublk_set_zero_copy(bool enable, uint32_t min_bytes)
+{
+	g_zero_copy_requested = enable;
+	g_zero_copy_min_bytes = min_bytes;
+}
+
+/* Evariops 0067: the domain of requests served with no copy. A bdev declares it by type; its
+ * data, when a layer needs it in hand, moves through the char device, as with user copy. It
+ * exists before any bdev: the bdev layer reads a bdev's domains once, when the bdev registers,
+ * and an lvol declares the domains of its base bdev. Created with the target, it would be
+ * missing from every bdev registered before, whose requests would then be bounced through
+ * buffers, and fail above a buffer's size. */
+static void
+ublk_zc_domain_create(void)
+{
+	int rc;
+
+	rc = spdk_memory_domain_create(&g_ublk_tgt.zc_domain, SPDK_UBLK_ZC_DMA_DEVICE_TYPE, NULL,
+				       SPDK_UBLK_ZC_DMA_DEVICE_ID);
+	if (rc != 0) {
+		SPDK_ERRLOG("ublk-zc memory domain not created: %s; every request will be copied "
+			    "(Evariops 0067)\n", spdk_strerror(-rc));
+		g_ublk_tgt.zc_domain = NULL;
+		return;
+	}
+	spdk_memory_domain_set_pull(g_ublk_tgt.zc_domain, ublk_zc_pull);
+	spdk_memory_domain_set_push(g_ublk_tgt.zc_domain, ublk_zc_push);
+	spdk_memory_domain_set_memzero(g_ublk_tgt.zc_domain, ublk_zc_memzero);
+}
+
+/* Evariops 0067: the target serves with no copy when asked for and the driver registers request
+ * pages (UBLK_F_SUPPORT_ZERO_COPY, which only exists with ioctl-encoded commands). */
+static void
+ublk_zero_copy_decide(void)
+{
+	g_ublk_tgt.zero_copy = false;
+	if (!g_zero_copy_requested) {
+		return;
+	}
+	if (g_ublk_tgt.zc_domain == NULL || !g_ublk_tgt.ioctl_encode || !g_ublk_tgt.user_copy ||
+	    !(g_ublk_tgt.features & UBLK_F_SUPPORT_ZERO_COPY)) {
+		SPDK_WARNLOG("zero copy asked for, and ublk_drv cannot register request pages: every request is "
+			     "copied (Evariops 0067)\n");
+		return;
+	}
+	g_ublk_tgt.zero_copy = true;
+	g_ublk_tgt.zc_min_bytes = g_zero_copy_min_bytes != 0 ? g_zero_copy_min_bytes : UBLK_ZC_DEFAULT_MIN_BYTES;
+	SPDK_NOTICELOG("zero copy for requests of %" PRIu32 " bytes and more (Evariops 0067)\n",
+		       g_ublk_tgt.zc_min_bytes);
+}

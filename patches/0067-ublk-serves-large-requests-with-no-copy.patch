index 0000000..7f08810
--- /dev/null
+++ b/include/spdk_internal/ublk_zc.h
@@ -0,0 +1,99 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (C) 2026 Evariops.

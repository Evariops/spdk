+
+/** \file
+ * Evariops: a ublk request's pages as a memory domain, served with no copy.
+ *
+ * With UBLK_F_SUPPORT_ZERO_COPY, ublk registers a request's pages in its queue's io_uring
+ * (UBLK_U_IO_REGISTER_IO_BUF), at the request's tag in the ring's buffer table. Its bdev I/O
+ * then carries the pages as this memory domain: the iovecs are addresses in the request's
+ * buffer, and the context names the ring and the index. A bdev that declares the domain's type
+ * reads and writes the pages with fixed operations prepared on that ring, from the ring's own
+ * thread (the queue's poll group submits the bdev I/O); ublk submits them and calls back each
+ * completion. Any other layer that needs the data in hand goes through the domain's pull, push
+ * and memzero, which copy through the ublk char device.
+ */
+
+#ifndef SPDK_INTERNAL_UBLK_ZC_H
+#define SPDK_INTERNAL_UBLK_ZC_H
+
+#include "spdk/stdinc.h"
+#include "spdk/dma.h"
+
+#include <liburing.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** The domain's type: a vendor type, so that a bdev says by type that it serves it. */
+#define SPDK_UBLK_ZC_DMA_DEVICE_TYPE \
+	((enum spdk_dma_device_type)(SPDK_DMA_DEVICE_VENDOR_SPECIFIC_TYPE_START + 81))
+
+#define SPDK_UBLK_ZC_DMA_DEVICE_ID "ublk-zc"
+
+/**
+ * The address of a request's buffer in the domain: an iovec's base minus it is the offset in the
+ * buffer. Not NULL, since a NULL iovec asks a bdev to allocate one, and aligned for any bdev.
+ */
+#define SPDK_UBLK_ZC_ADDR_BASE (1ULL << 46)
+
+/** An operation a bdev prepared on the request's ring: ublk calls cb with its completion's result. */
+struct spdk_ublk_zc_op {
+	void (*cb)(struct spdk_ublk_zc_op *op, int32_t res);
+};
+
+/** The completions of such operations carry this bit, and the operation's address. */
+#define SPDK_UBLK_ZC_OP_FLAG (1ULL << 63)
+
+/** The domain context of a request's bdev I/O. */
+struct spdk_ublk_zc_ctx {
+	/** The queue's ring, owned by the calling thread. */
+	struct io_uring	*ring;
+	/** The index of the request's pages in the ring's buffer table. */
+	uint16_t	buf_index;
+};
+
+/**
+ * Prepares, on the request's ring, a fixed read (or write) of \b len bytes of the request's
+ * buffer at domain address \b addr, from (or to) \b fd at \b offset. Its completion calls
+ * \b op->cb. NULL when the ring has no free entry: the caller retries later.
+ */
+static inline struct io_uring_sqe *
+spdk_ublk_zc_prep_rw(struct spdk_ublk_zc_ctx *ctx, bool write, int fd, void *addr, uint32_t len,
+		     uint64_t offset, struct spdk_ublk_zc_op *op)
+{
+	struct io_uring_sqe *sqe;
+	uint64_t buf_offset = (uint64_t)(uintptr_t)addr - SPDK_UBLK_ZC_ADDR_BASE;
+
+	sqe = io_uring_get_sqe(ctx->ring);
+	if (sqe == NULL) {
+		return NULL;
+	}
+
+	/* The ring takes 128-byte entries for ublk's commands: none of a command's bytes is left. */
+	memset(sqe, 0, 2 * sizeof(*sqe));
+	if (write) {
+		io_uring_prep_write_fixed(sqe, fd, (void *)(uintptr_t)buf_offset, len, offset, ctx->buf_index);
+	} else {
+		io_uring_prep_read_fixed(sqe, fd, (void *)(uintptr_t)buf_offset, len, offset, ctx->buf_index);
+	}
+	io_uring_sqe_set_data64(sqe, (uint64_t)(uintptr_t)op | SPDK_UBLK_ZC_OP_FLAG);
+
+	return sqe;
+}
+
+/** Free entries of the request's ring. */
+static inline unsigned
+spdk_ublk_zc_ring_space(struct spdk_ublk_zc_ctx *ctx)
+{
+	return io_uring_sq_space_left(ctx->ring);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SPDK_INTERNAL_UBLK_ZC_H */

+/* Evariops 0053: a leg's superblock as a view create reads it. A leg with no
+ * superblock, or with one below minor 2 or without a lineage, is unstamped: it
+ * carries no generation of any lineage. */
+struct raid_bdev_stamp {
+	/* 0 once the leg is read, whether it carries a superblock or not; else the

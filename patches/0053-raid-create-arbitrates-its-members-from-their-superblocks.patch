+	CU_ASSERT(sb->version.minor == 2);
+	CU_ASSERT(spdk_uuid_is_null(&sb->lineage));
+	CU_ASSERT(sb->owner[0] == '\0');
+	CU_ASSERT(sb->view_epoch == 0);
+	CU_ASSERT(sb->base_bdevs[0].state == RAID_SB_BASE_BDEV_CONFIGURED);
+	CU_ASSERT(sb->base_bdevs[1].state == RAID_SB_BASE_BDEV_CONFIGURED);
+
+	raid_bdev_free_superblock(&raid_bdev);
+}

+	CU_ASSERT(raid_bdev->view_epoch == 5);
+	ut_view_member(raid_bdev, 0, "Nvme0n1", 0, 5);
+	ut_view_member(raid_bdev, 1, "Nvme1n1", 0, 5);
+	ut_view_member(raid_bdev, 2, "Nvme2n1", 0, 5);
+
+	ut_view_teardown();

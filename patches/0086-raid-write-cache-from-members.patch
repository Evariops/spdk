+/* Evariops 0086: the raid has a volatile write cache when one of its members has one. */
+static void
+test_raid_write_cache_from_members(void)
+{
+	struct rpc_bdev_raid_create_ctx req;
+	struct rpc_bdev_raid_delete_ctx delete_req;
+	struct raid_bdev *pbdev;
+	struct spdk_bdev *bdev;
+	char first[16];
+
+	set_globals();
+	CU_ASSERT(raid_bdev_init() == 0);
+
+	create_raid_bdev_create_req(&req, "raid1", 0, true, 0, false);
+	rpc_bdev_raid_create(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	pbdev = raid_bdev_find_by_name("raid1");
+	SPDK_CU_ASSERT_FATAL(pbdev != NULL);
+	CU_ASSERT(pbdev->bdev.write_cache == 0);
+	free_test_req(&req);
+	create_raid_bdev_delete_req(&delete_req, "raid1", 0);
+	rpc_bdev_raid_delete(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+
+	create_raid_bdev_create_req(&req, "raid2", g_max_base_drives, true, 0, false);
+	snprintf(first, sizeof(first), "Nvme%un1", g_max_base_drives);
+	TAILQ_FOREACH(bdev, &g_bdev_list, internal.link) {
+		if (strcmp(bdev->name, first) == 0) {
+			bdev->write_cache = 1;
+		}
+	}
+	rpc_bdev_raid_create(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	pbdev = raid_bdev_find_by_name("raid2");
+	SPDK_CU_ASSERT_FATAL(pbdev != NULL);
+	CU_ASSERT(pbdev->bdev.write_cache == 1);
+	free_test_req(&req);
+	create_raid_bdev_delete_req(&delete_req, "raid2", 0);
+	rpc_bdev_raid_delete(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+
+	raid_bdev_exit();
+	base_bdevs_cleanup();
+	reset_globals();
+}
+

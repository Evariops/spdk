+{
+	struct nvme_ctrlr_ana_log_page_ctx *ctx = arg;
+	struct spdk_nvme_ctrlr *ctrlr = ctx->ctrlr;
+	nvme_ctrlr_ana_log_page_cb cb_fn = ctx->cb_fn;
+	void *cb_arg = ctx->cb_arg;
+	int rc = 0;
+
+	free(ctx);
+	if (spdk_nvme_cpl_is_error(cpl)) {

+ * Evariops 0073: the ANA log page is read with no wait. Both readers, the ANA change event and the
+ * controller's init state machine (run again at every reconnect), waited on the admin queue after
+ * the command, polling that queue alone: a process that is also an NVMe-oF target answered nobody
+ * meanwhile. cb_fn is invoked once, at the command's completion, when 0 is returned; a failure to
+ * submit is returned, and cb_fn is not invoked.
+ */
+typedef void (*nvme_ctrlr_ana_log_page_cb)(struct spdk_nvme_ctrlr *ctrlr, void *cb_arg, int rc,
+		const struct spdk_nvme_cpl *cpl);

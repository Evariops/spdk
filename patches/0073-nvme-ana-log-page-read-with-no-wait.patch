+/* Evariops 0073: the ANA log page is read with no wait; its completion is recorded here. */
+static int g_ut_ana_log_page_rc;
+
+static void
+ut_ana_log_page_done(struct spdk_nvme_ctrlr *ctrlr, void *cb_arg, int rc,
+		     const struct spdk_nvme_cpl *cpl)
+{
+	g_ut_ana_log_page_rc = rc;

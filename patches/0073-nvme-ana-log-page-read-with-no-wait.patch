+/*
+ * Evariops 0073: the ANA log page is read with no wait, by the controller's init state machine
+ * and by the ANA change event. Held by the test, the init's read leaves the state waiting for it,
+ * and its completion moves the state on; the event stays in progress until its read completes,
+ * then ends and calls back. No wait on the admin queue at any point.
+ */
+static void
+test_nvme_ctrlr_ana_log_page_waits_for_nothing(void)
+{
+	DECLARE_AND_CONSTRUCT_CTRLR();
+	union spdk_nvme_async_event_completion	aer_event = {
+		.bits.async_event_type = SPDK_NVME_ASYNC_EVENT_TYPE_NOTICE,
+		.bits.async_event_info = SPDK_NVME_ASYNC_EVENT_ANA_CHANGE
+	};
+	struct spdk_nvme_cpl aer_cpl = {
+		.status.sct = SPDK_NVME_SCT_GENERIC,
+		.status.sc = SPDK_NVME_SC_SUCCESS,
+		.cdw0 = aer_event.raw
+	};
+	struct spdk_nvme_cpl done = {
+		.status.sct = SPDK_NVME_SCT_GENERIC,
+		.status.sc = SPDK_NVME_SC_SUCCESS,
+	};
+	spdk_nvme_cmd_cb cb;
+
+	SPDK_CU_ASSERT_FATAL(nvme_ctrlr_construct(&ctrlr) == 0);
+	ctrlr.vs.bits.mjr = 1;
+	ctrlr.vs.bits.mnr = 2;
+	ctrlr.cdata.nn = 4096;
+	ctrlr.cdata.cmic.anars = true;
+	ctrlr.cdata.nanagrpid = 1;
+
+	ctrlr.state = NVME_CTRLR_STATE_CONFIGURE_AER;
+	while (ctrlr.state != NVME_CTRLR_STATE_READY) {
+		SPDK_CU_ASSERT_FATAL(nvme_ctrlr_process_init(&ctrlr) == 0);
+	}
+
+	CU_ASSERT(nvme_ctrlr_add_process(&ctrlr, NULL) == 0);
+	spdk_nvme_ctrlr_register_aer_callback(&ctrlr, aer_cb, NULL);
+
+	g_defer_ana_log = true;
+	g_deferred_log_cb = NULL;
+	g_wait_for_adminq_calls = 0;
+	g_aer_cb_counter = 0;
+
+	/* The event: in progress until its read completes, then it ends and calls back. */
+	nvme_ctrlr_async_event_cb(&ctrlr.aer[0], &aer_cpl);
+	nvme_ctrlr_complete_queued_async_events(&ctrlr);
+	SPDK_CU_ASSERT_FATAL(g_deferred_log_cb != NULL);
+	CU_ASSERT(ctrlr.async_event_in_progress != NULL);
+	CU_ASSERT(g_aer_cb_counter == 0);
+
+	cb = g_deferred_log_cb;
+	g_deferred_log_cb = NULL;
+	cb(g_deferred_log_arg, &done);
+	CU_ASSERT(ctrlr.async_event_in_progress == NULL);
+	CU_ASSERT(g_aer_cb_counter == 1);
+
+	/* The init (again at a reconnect): the state waits for the page, and moves on at its
+	 * completion. */
+	ctrlr.opts.admin_timeout_ms = NVME_TIMEOUT_INFINITE;
+	ctrlr.state = NVME_CTRLR_STATE_SET_SUPPORTED_LOG_PAGES;
+	CU_ASSERT(nvme_ctrlr_process_init(&ctrlr) == 0);
+	CU_ASSERT(ctrlr.state == NVME_CTRLR_STATE_WAIT_FOR_SUPPORTED_LOG_PAGES);
+	SPDK_CU_ASSERT_FATAL(g_deferred_log_cb != NULL);
+
+	cb = g_deferred_log_cb;
+	g_deferred_log_cb = NULL;
+	cb(g_deferred_log_arg, &done);
+	CU_ASSERT(ctrlr.state == NVME_CTRLR_STATE_SET_SUPPORTED_FEATURES);
+	CU_ASSERT(g_wait_for_adminq_calls == 0);
+
+	g_defer_ana_log = false;
+	nvme_ctrlr_free_processes(&ctrlr);
+	nvme_ctrlr_destruct(&ctrlr);
+}

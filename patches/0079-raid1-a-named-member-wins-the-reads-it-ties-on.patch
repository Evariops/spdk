+/* Evariops 0079: the read preference names one configured member of a raid1, and
+ * leaves with it. The suite's own module stands in for raid1. */
+static void
+test_raid1_read_preference_names_one_configured_member(void)
+{
+	struct rpc_bdev_raid_create_ctx req;
+	struct rpc_bdev_raid_delete_ctx destroy_req;
+	struct raid_base_bdev_info *base_info;
+	struct raid_bdev *pbdev;
+	uint8_t i;
+
+	set_globals();
+	CU_ASSERT(raid_bdev_init() == 0);
+	create_raid_bdev_create_req(&req, "raid1", 0, true, 0, false);
+	rpc_bdev_raid_create(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	free_test_req(&req);
+
+	pbdev = raid_bdev_find_by_name("raid1");
+	SPDK_CU_ASSERT_FATAL(pbdev != NULL);
+
+	/* another level has no read selection to steer */
+	CU_ASSERT(raid_bdev_set_read_preference(pbdev, pbdev->base_bdev_info[1].name) == -ENOTSUP);
+
+	pbdev->level = SPDK_BDEV_RAID_LEVEL_RAID1;
+	pbdev->min_base_bdevs_operational = 1;
+
+	CU_ASSERT(raid_bdev_set_read_preference(pbdev, pbdev->base_bdev_info[1].name) == 0);
+	for (i = 0; i < pbdev->num_base_bdevs; i++) {
+		CU_ASSERT(pbdev->base_bdev_info[i].read_preferred == (i == 1));
+	}
+
+	/* naming another member takes it from the first */
+	CU_ASSERT(raid_bdev_set_read_preference(pbdev, pbdev->base_bdev_info[0].name) == 0);
+	for (i = 0; i < pbdev->num_base_bdevs; i++) {
+		CU_ASSERT(pbdev->base_bdev_info[i].read_preferred == (i == 0));
+	}
+
+	/* a name that is no member is refused, and changes nothing */
+	CU_ASSERT(raid_bdev_set_read_preference(pbdev, "NoSuchBdev") == -ENODEV);
+	CU_ASSERT(pbdev->base_bdev_info[0].read_preferred);
+
+	CU_ASSERT(raid_bdev_set_read_preference(pbdev, NULL) == 0);
+	for (i = 0; i < pbdev->num_base_bdevs; i++) {
+		CU_ASSERT(!pbdev->base_bdev_info[i].read_preferred);
+	}
+
+	/* the slot a preferred member frees comes back without the preference */
+	base_info = &pbdev->base_bdev_info[0];
+	CU_ASSERT(raid_bdev_set_read_preference(pbdev, base_info->name) == 0);
+	CU_ASSERT(raid_bdev_remove_base_bdev(spdk_bdev_desc_get_bdev(base_info->desc), NULL,
+					     NULL, NULL) == 0);
+	poll_app_thread();
+	CU_ASSERT(!base_info->is_configured);
+	CU_ASSERT(!base_info->read_preferred);
+
+	create_raid_bdev_delete_req(&destroy_req, "raid1", 0);
+	rpc_bdev_raid_delete(NULL, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	raid_bdev_exit();
+	base_bdevs_cleanup();
+	reset_globals();
+}

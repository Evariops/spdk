+/* Evariops 0079: bdev_raid_set_read_preference {name, base_bdev?} — the member of
+ * a raid1 that wins the reads it ties on; without base_bdev, none does. */
+struct rpc_bdev_raid_set_read_preference {
+	char	*name;
+	char	*base_bdev;
+};
+
+static const struct spdk_json_object_decoder rpc_bdev_raid_set_read_preference_decoders[] = {
+	{"name", offsetof(struct rpc_bdev_raid_set_read_preference, name), spdk_json_decode_string},
+	{"base_bdev", offsetof(struct rpc_bdev_raid_set_read_preference, base_bdev), spdk_json_decode_string, true},
+};
+
+static void
+rpc_bdev_raid_set_read_preference(struct spdk_jsonrpc_request *request,
+				  const struct spdk_json_val *params)
+{
+	struct rpc_bdev_raid_set_read_preference req = {};
+	struct raid_bdev *raid_bdev;
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_raid_set_read_preference_decoders,
+				    SPDK_COUNTOF(rpc_bdev_raid_set_read_preference_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "Invalid parameters");
+		goto cleanup;
+	}
+
+	raid_bdev = raid_bdev_find_by_name(req.name);
+	if (raid_bdev == NULL) {
+		spdk_jsonrpc_send_error_response_fmt(request, -ENODEV, "No such raid bdev: %s", req.name);
+		goto cleanup;
+	}
+
+	rc = raid_bdev_set_read_preference(raid_bdev, req.base_bdev);
+	if (rc != 0) {
+		spdk_jsonrpc_send_error_response_fmt(request, rc,
+						     "raid bdev %s: no read preference for %s: %s", req.name,
+						     req.base_bdev != NULL ? req.base_bdev : "(none)",
+						     spdk_strerror(-rc));
+		goto cleanup;
+	}
+
+	spdk_jsonrpc_send_bool_response(request, true);
+cleanup:
+	free(req.name);
+	free(req.base_bdev);
+}
+SPDK_RPC_REGISTER("bdev_raid_set_read_preference", rpc_bdev_raid_set_read_preference, SPDK_RPC_RUNTIME)

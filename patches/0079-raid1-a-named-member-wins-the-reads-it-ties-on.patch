+/* Evariops 0079: a raid1 reads from the member with the fewest read blocks in
+ * flight, and on a tie from the lowest slot: at queue depth one, always slot 0,
+ * which is the member served in this process only by the accident of the
+ * create's order, and not after that member is replaced. The control plane
+ * names the member to win the ties instead; under load the balance is the
+ * same. Kept in memory: a reassembly is named again by its agent. */
+int
+raid_bdev_set_read_preference(struct raid_bdev *raid_bdev, const char *base_bdev_name)
+{
+	struct raid_base_bdev_info *base_info, *preferred = NULL;
+
+	assert(spdk_get_thread() == spdk_thread_get_app_thread());
+
+	if (raid_bdev->level != SPDK_BDEV_RAID_LEVEL_RAID1) {
+		return -ENOTSUP;
+	}
+
+	if (base_bdev_name != NULL) {
+		RAID_FOR_EACH_BASE_BDEV(raid_bdev, base_info) {
+			if (base_info->is_configured && base_info->name != NULL &&
+			    strcmp(base_info->name, base_bdev_name) == 0) {
+				preferred = base_info;
+				break;
+			}
+		}
+		if (preferred == NULL) {
+			return -ENODEV;
+		}
+	}
+
+	RAID_FOR_EACH_BASE_BDEV(raid_bdev, base_info) {
+		__atomic_store_n(&base_info->read_preferred, base_info == preferred, __ATOMIC_RELAXED);
+	}
+
+	return 0;
+}

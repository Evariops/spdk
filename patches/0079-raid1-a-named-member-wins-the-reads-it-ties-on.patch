+/* Evariops 0079 */
+static void
+_test_raid1_read_preference(struct raid_bdev *raid_bdev, struct raid_bdev_io_channel *raid_ch)
+{
+	struct raid1_info *r1_info = raid_bdev->module_private;
+	struct raid1_io_channel *raid1_ch = raid_bdev_channel_get_module_ctx(raid_ch);
+	struct raid_base_bdev_info *preferred_info;
+	const uint64_t io_blocks = 4;
+	const uint8_t preferred = raid_bdev->num_base_bdevs - 1;
+	struct raid_bdev_io *raid_io;
+	uint8_t i;
+	int n;
+
+	preferred_info = &raid_bdev->base_bdev_info[preferred];
+	__atomic_store_n(&preferred_info->read_preferred, true, __ATOMIC_RELAXED);
+
+	/* at queue depth one every read ties, and the preferred member takes them all,
+	 * not slot 0 */
+	for (n = 0; n < 3; n++) {
+		raid_io = get_raid_io(r1_info, raid_ch, SPDK_BDEV_IO_TYPE_READ, io_blocks);
+		raid1_submit_read_request(raid_io);
+		CU_ASSERT(raid_io->base_bdev_io_submitted == preferred);
+		raid1_channel_dec_read_counters(raid_ch, raid_io->base_bdev_io_submitted, io_blocks);
+		put_raid_io(raid_io);
+	}
+
+	/* under load it wins the ties only: the reads still spread evenly */
+	for (n = 0; n < 3; n++) {
+		for (i = 0; i < raid_bdev->num_base_bdevs; i++) {
+			raid_io = get_raid_io(r1_info, raid_ch, SPDK_BDEV_IO_TYPE_READ, io_blocks);
+			raid1_submit_read_request(raid_io);
+			CU_ASSERT(raid_io->base_bdev_io_submitted == (i == 0 ? preferred : i - 1));
+			put_raid_io(raid_io);
+		}
+	}
+
+	for (i = 0; i < raid_bdev->num_base_bdevs; i++) {
+		CU_ASSERT(raid1_ch->read_blocks_outstanding[i] == n * io_blocks);
+		raid1_ch->read_blocks_outstanding[i] = 0;
+	}
+
+	/* a member kept out of reads is not read for its preference */
+	preferred_info->read_excluded = true;
+	raid_io = get_raid_io(r1_info, raid_ch, SPDK_BDEV_IO_TYPE_READ, io_blocks);
+	raid1_submit_read_request(raid_io);
+	CU_ASSERT(raid_io->base_bdev_io_submitted == 0);
+	raid1_channel_dec_read_counters(raid_ch, raid_io->base_bdev_io_submitted, io_blocks);
+	put_raid_io(raid_io);
+	preferred_info->read_excluded = false;
+
+	/* without a preference, slot 0 again */
+	__atomic_store_n(&preferred_info->read_preferred, false, __ATOMIC_RELAXED);
+	raid_io = get_raid_io(r1_info, raid_ch, SPDK_BDEV_IO_TYPE_READ, io_blocks);
+	raid1_submit_read_request(raid_io);
+	CU_ASSERT(raid_io->base_bdev_io_submitted == 0);
+	raid1_channel_dec_read_counters(raid_ch, raid_io->base_bdev_io_submitted, io_blocks);
+	put_raid_io(raid_io);
+}
+
+static void
+test_raid1_read_preference(void)
+{
+	run_for_each_raid1_config(_test_raid1_read_preference);
+}

+	writes = g_ut_sb_writes;
+
+	ut_journal("raid1", 6, UT_INCARNATION, NULL);
+	CU_ASSERT(g_rpc_err == 0);
+	CU_ASSERT(g_ut_sb_writes == writes + 1);
+	CU_ASSERT(raid_bdev->view_epoch == 6);
+	CU_ASSERT(sb->version.minor == 2);
+	CU_ASSERT(spdk_uuid_compare(&sb->lineage, &g_ut_lineage) == 0);
+	CU_ASSERT(strcmp((const char *)sb->owner, UT_INCARNATION) == 0);
+	CU_ASSERT(sb->view_epoch == 6);
+	CU_ASSERT(sb->base_bdevs[0].view_epoch == 6);
+	CU_ASSERT(sb->base_bdevs[1].view_epoch == 6);
+	CU_ASSERT(sb->base_bdevs[2].view_epoch == 0);
+	CU_ASSERT(raid_bdev->base_bdev_info[0].view_epoch == 6);

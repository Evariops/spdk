+				     (struct bdev_uring_task *)bdev_io->driver_ctx) == -ENOMEM) {
+			spdk_bdev_io_complete(bdev_io, SPDK_BDEV_IO_STATUS_NOMEM);
+		}
+		return 0;
 	default:
 		return -1;
 	}

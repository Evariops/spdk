+/* Evariops 0084: a flush makes durable what the device acknowledged: fdatasync on the file
+ * or the block device, which the kernel turns into a cache flush when the device has a
+ * volatile write cache. Without it, writes acknowledged by the disk's cache, fsync'ed by
+ * the filesystem above, could be lost with the power. */
+static int64_t
+bdev_uring_flush(struct bdev_uring *uring, struct spdk_io_channel *ch,
+		 struct bdev_uring_task *uring_task)
+{
+	struct bdev_uring_io_channel *uring_ch = spdk_io_channel_get_ctx(ch);
+	struct bdev_uring_group_channel *group_ch = uring_ch->group_ch;
+	struct io_uring_sqe *sqe;
+
+	sqe = io_uring_get_sqe(&group_ch->uring);
+	if (!sqe) {
+		URING_DEBUGLOG(uring, "get sqe failed as out of resource\n");
+		return -ENOMEM;
+	}
+
+	io_uring_prep_fsync(sqe, uring->fd, IORING_FSYNC_DATASYNC);
+	io_uring_sqe_set_data(sqe, uring_task);
+	uring_task->len = 0;
+	uring_task->ch = uring_ch;
+	__atomic_fetch_add(&uring->flushes, 1, __ATOMIC_RELAXED);
+
+	group_ch->io_pending++;
+	return 0;
+}
+
+/* Evariops 0084: a device with a volatile write cache says "write back" in sysfs. A file, or a
+ * device whose cache cannot be read, counts as having one: a flush then costs a syscall, and
+ * an acknowledged write is never left in a cache nobody flushes. */
+static bool
+bdev_uring_has_volatile_cache(int fd)
+{
+	struct stat st;
+	char path[96], state[32] = "";
+	FILE *f;
+
+	if (fstat(fd, &st) != 0 || !S_ISBLK(st.st_mode)) {
+		return true;
+	}
+	snprintf(path, sizeof(path), "/sys/dev/block/%u:%u/queue/write_cache",
+		 major(st.st_rdev), minor(st.st_rdev));
+	f = fopen(path, "r");
+	if (f == NULL) {
+		/* A partition has no queue of its own: its disk's. */
+		snprintf(path, sizeof(path), "/sys/dev/block/%u:%u/../queue/write_cache",
+			 major(st.st_rdev), minor(st.st_rdev));
+		f = fopen(path, "r");
+	}
+	if (f == NULL) {
+		return true;
+	}
+	if (fgets(state, sizeof(state), f) == NULL) {
+		state[0] = '\0';
+	}
+	fclose(f);
+	return strncmp(state, "write through", strlen("write through")) != 0;
+}
+
 static int

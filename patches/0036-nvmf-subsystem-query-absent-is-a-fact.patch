diff --git a/lib/nvmf/nvmf_rpc.c b/lib/nvmf/nvmf_rpc.c
--- a/lib/nvmf/nvmf_rpc.c
+++ b/lib/nvmf/nvmf_rpc.c
@@ -3176,9 +3176,14 @@ _rpc_nvmf_subsystem_query(struct spdk_jsonrpc_request *request,
 
 	subsystem = spdk_nvmf_tgt_find_subsystem(tgt, ctx->nqn);
 	if (!subsystem) {
+		/* Evariops 0036: a missing subsystem is a FACT (-ENODEV), not a caller
+		 * mistake. INVALID_PARAMS made "absent" indistinguishable from a bad
+		 * request, so every absent-tolerant caller misclassified it as fatal —
+		 * measured 2026-08-14: a teardown died because the subsystem was
+		 * already gone, and the recreate loop behind it ran for 7 hours. */
 		SPDK_ERRLOG("Unable to find subsystem with NQN %s\n", ctx->nqn);
-		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
-						 "Invalid parameters");
+		spdk_jsonrpc_send_error_response_fmt(request, -ENODEV,
+						     "No such subsystem: %s", ctx->nqn);
 		free_rpc_subsystem_query_ctx(ctx);
 		return;
 	}

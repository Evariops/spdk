diff --git a/lib/nvmf/nvmf_rpc.c b/lib/nvmf/nvmf_rpc.c
index d3b1e36..bdd05fe 100644
--- a/lib/nvmf/nvmf_rpc.c
+++ b/lib/nvmf/nvmf_rpc.c
@@ -3176,9 +3176,12 @@ _rpc_nvmf_subsystem_query(struct spdk_jsonrpc_request *request,
 
 	subsystem = spdk_nvmf_tgt_find_subsystem(tgt, ctx->nqn);
 	if (!subsystem) {
+		/* Evariops 0036: report absence as -ENODEV, not INVALID_PARAMS. Callers
+		 * that tolerate an already-gone subsystem (teardown, for one) need to
+		 * distinguish "not there" from "you asked wrongly". */
 		SPDK_ERRLOG("Unable to find subsystem with NQN %s\n", ctx->nqn);
-		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
-						 "Invalid parameters");
+		spdk_jsonrpc_send_error_response_fmt(request, -ENODEV,
+						     "No such subsystem: %s", ctx->nqn);
 		free_rpc_subsystem_query_ctx(ctx);
 		return;
 	}

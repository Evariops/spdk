+/* Evariops 0036: the query RPCs (get_controllers, get_qpairs, get_listeners) report
+ * an absent subsystem as -ENODEV, not INVALID_PARAMS. Callers that tolerate an
+ * already-gone subsystem (teardown, for one) need to distinguish "not there" from
+ * "you asked wrongly"; the other RPCs keep upstream's answer. Returns true when it
+ * answered the request. A missing target is left to _rpc_nvmf_get_subsystem. */
+static bool
+_rpc_nvmf_query_subsystem_absent(struct spdk_jsonrpc_request *request,
+				 const char *tgt_name, const char *nqn)
+{
+	struct spdk_nvmf_tgt *tgt = spdk_nvmf_get_tgt(tgt_name);
+
+	if (tgt == NULL || nqn == NULL || spdk_nvmf_tgt_find_subsystem(tgt, nqn) != NULL) {
+		return false;
+	}
+
+	SPDK_ERRLOG("Unable to find subsystem with NQN %s\n", nqn);
+	spdk_jsonrpc_send_error_response_fmt(request, -ENODEV, "No such subsystem: %s", nqn);
+	return true;
+}
+
 static int
 _rpc_nvmf_subsystem_pause(struct spdk_jsonrpc_request *request,
 			  const char *tgt_name, const char *nqn, uint32_t nsid,

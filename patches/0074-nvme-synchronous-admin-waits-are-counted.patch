diff --git a/lib/nvme/nvme.c b/lib/nvme/nvme.c
index 7b975b7..5643426 100644
--- a/lib/nvme/nvme.c
+++ b/lib/nvme/nvme.c
@@ -296,13 +296,34 @@ error:
 	return -ECANCELED;
 }
 
+/*
+ * Evariops 0074: the synchronous waits on an admin queue. A process that is also an NVMe-oF target
+ * answers nobody while it waits; since 0072 and 0073 none is reachable while the process serves.
+ * Each is counted, and the first ones (then one in 1024) logged with their caller, so a wait that
+ * an upstream change brings back shows in a test and in the logs, not as a freeze.
+ */
+static uint64_t g_nvme_sync_admin_waits;
+
+uint64_t
+nvme_sync_admin_wait_count(void)
+{
+	return __atomic_load_n(&g_nvme_sync_admin_waits, __ATOMIC_RELAXED);
+}
+
 int
 nvme_wait_for_adminq_completion(struct spdk_nvme_ctrlr *ctrlr,
 				struct nvme_completion_poll_status *status, bool release)
 {
 	uint64_t timeout_in_usecs = ctrlr->opts.admin_timeout_ms * 1000;
+	uint64_t waits;
 	int rc;
 
+	waits = __atomic_add_fetch(&g_nvme_sync_admin_waits, 1, __ATOMIC_RELAXED);
+	if (waits <= 16 || waits % 1024 == 0) {
+		NVME_CTRLR_WARNLOG(ctrlr, "synchronous wait #%" PRIu64 " on the admin queue, called "
+				   "from %p (Evariops 0074)\n", waits, __builtin_return_address(0));
+	}
+
 	if (timeout_in_usecs) {
 		status->timeout_tsc = spdk_get_ticks() + timeout_in_usecs *
 				      spdk_get_ticks_hz() / SPDK_SEC_TO_USEC;

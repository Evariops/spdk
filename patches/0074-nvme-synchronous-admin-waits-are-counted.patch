+++ b/test/unit/lib/nvme/nvme.c/nvme_ut.c
@@ -1440,6 +1440,30 @@ test_nvme_wait_for_completion(void)
 	CU_ASSERT(rc == 0);
 }
 
+/* Evariops 0074: every synchronous wait on an admin queue is counted, whatever its outcome. */
+static void
+test_nvme_sync_admin_waits_are_counted(void)
+{
+	struct spdk_nvme_qpair qpair = {};
+	struct spdk_nvme_ctrlr ctrlr = {.adminq = &qpair, .trid = {.trtype = SPDK_NVME_TRANSPORT_PCIE}};
+	uint64_t before;
+
+	qpair.ctrlr = &ctrlr;
+	before = nvme_sync_admin_wait_count();
+
+	memset(&g_status, 0, sizeof(g_status));
+	completion_delay_us = 1000000;
+	ctrlr.opts.admin_timeout_ms = 2000;
+	CU_ASSERT(nvme_wait_for_adminq_completion(&ctrlr, &g_status, false) == 0);
+	CU_ASSERT(nvme_sync_admin_wait_count() == before + 1);
+
+	memset(&g_status, 0, sizeof(g_status));
+	completion_delay_us = 2000000;
+	ctrlr.opts.admin_timeout_ms = 1000;
+	CU_ASSERT(nvme_wait_for_adminq_completion(&ctrlr, &g_status, false) == -ECANCELED);
+	CU_ASSERT(nvme_sync_admin_wait_count() == before + 2);
+}

+/*
+ * Evariops 0075: a clone grown larger than its snapshot reads zeroes past the snapshot. A read
+ * whose buffers live in a memory domain has the domain write those zeroes, never memset: its
+ * iovecs need not be memory of the process (ublk's zero copy).
+ */
+static void
+blob_clone_grown_reads_past_its_parent_through_the_domain(void)
+{
+	struct spdk_blob_store *bs = g_bs;
+	struct spdk_blob_opts opts;
+	struct spdk_blob *blob, *clone;
+	struct spdk_io_channel *channel;
+	spdk_blob_id snapshotid;
+	uint64_t units = spdk_bs_get_cluster_size(bs) / spdk_bs_get_io_unit_size(bs);
+	uint64_t len = 3 * spdk_bs_get_cluster_size(bs);
+	uint8_t *payload, *expected;
+	struct iovec iov;
+	struct spdk_blob_ext_io_opts ext_opts = {
+		.memory_domain = (struct spdk_memory_domain *)0xfeedbeef,
+		.memory_domain_ctx = (void *)0xf00df00d,
+		.size = sizeof(struct spdk_blob_ext_io_opts),
+	};
+
+	channel = spdk_bs_alloc_io_channel(bs);
+	SPDK_CU_ASSERT_FATAL(channel != NULL);
+	payload = malloc(len);
+	expected = calloc(1, len);
+	SPDK_CU_ASSERT_FATAL(payload != NULL && expected != NULL);
+
+	ut_spdk_blob_opts_init(&opts);
+	opts.num_clusters = 1;
+	blob = ut_blob_create_and_open(bs, &opts);
+	memset(expected, 0xa5, spdk_bs_get_cluster_size(bs));
+	spdk_blob_io_write(blob, channel, expected, 0, units, blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+
+	/* A snapshot of one cluster, a clone of it grown to three. */
+	spdk_bs_create_snapshot(bs, spdk_blob_get_id(blob), NULL, blob_op_with_id_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	snapshotid = g_blobid;
+	spdk_bs_create_clone(bs, snapshotid, NULL, blob_op_with_id_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	spdk_bs_open_blob(bs, g_blobid, blob_op_with_handle_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	SPDK_CU_ASSERT_FATAL(g_blob != NULL);
+	clone = g_blob;
+	spdk_blob_resize(clone, 3, blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+
+	/* The snapshot's cluster, then zeroes, written by the domain. */
+	memset(payload, 0xff, len);
+	iov.iov_base = payload;
+	iov.iov_len = len;
+	g_memory_domain_memzero_calls = 0;
+	spdk_blob_io_readv_ext(clone, channel, &iov, 1, 0, 3 * units, blob_op_complete, NULL, &ext_opts);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	CU_ASSERT(memcmp(payload, expected, len) == 0);
+	CU_ASSERT(g_memory_domain_memzero_calls > 0);
+
+	ut_blob_close_and_delete(bs, clone);
+	ut_blob_close_and_delete(bs, blob);
+	spdk_bs_delete_blob(bs, snapshotid, blob_op_complete, NULL);
+	poll_threads();
+	CU_ASSERT(g_bserrno == 0);
+	spdk_bs_free_io_channel(channel);
+	poll_threads();
+	free(payload);
+	free(expected);
+}

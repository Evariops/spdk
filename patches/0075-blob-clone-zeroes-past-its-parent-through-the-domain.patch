+/*
+ * Evariops 0075: a read past the end of a clone's parent (a clone grown larger than its snapshot)
+ * zeroes the part the parent does not hold. zero_trailing_bytes writes those zeroes with memset,
+ * which is right for buffers the process can reach. A request whose buffers live in a memory
+ * domain (ublk's zero copy, fork 0067) carries iovecs that are no memory of this process: memset
+ * into them killed it (SIGSEGV), at the kernel's first read past the parent, its partition scan
+ * of the device's end. Such a request has its domain zero that part
+ * (spdk_memory_domain_memzero), as the zeroes device does for an unallocated cluster, then reads
+ * the part the parent holds.
+ */
+struct blob_bs_dev_domain_read {
+	struct spdk_blob_bs_dev		*b;
+	struct spdk_io_channel		*channel;
+	struct iovec			*iov;
+	int				iovcnt;
+	uint64_t			lba;
+	uint32_t			lba_count;
+	struct spdk_bs_dev_cb_args	*cb_args;
+	struct spdk_blob_ext_io_opts	*ext_opts;
+	struct iovec			trailing[];
+};
+
+static void
+blob_bs_dev_domain_zeroed(void *ctx, int rc)
+{
+	struct blob_bs_dev_domain_read *r = ctx;
+	struct spdk_bs_dev_cb_args *cb_args = r->cb_args;
+
+	if (rc != 0 || r->lba_count == 0) {
+		free(r);
+		cb_args->cb_fn(cb_args->channel, cb_args->cb_arg, rc);
+		return;
+	}
+
+	spdk_blob_io_readv_ext(r->b->blob, r->channel, r->iov, r->iovcnt, r->lba, r->lba_count,
+			       blob_bs_dev_read_cpl, cb_args, r->ext_opts);
+	free(r);
+}
+
+static void
+blob_bs_dev_readv_domain(struct spdk_blob_bs_dev *b, struct spdk_io_channel *channel,
+			 struct iovec *iov, int iovcnt, uint64_t lba, uint32_t lba_count,
+			 struct spdk_bs_dev_cb_args *cb_args, struct spdk_blob_ext_io_opts *ext_opts)
+{
+	struct blob_bs_dev_domain_read *r;
+	uint32_t zero_lba_count;
+	uint64_t valid_bytes, zero_bytes;
+	int i, n = 0, rc;
+
+	zero_lba_count = spdk_min(lba_count, lba + lba_count - b->bs_dev.blockcnt);
+	zero_bytes = zero_lba_count * (uint64_t)b->bs_dev.blocklen;
+	valid_bytes = (lba_count - zero_lba_count) * (uint64_t)b->bs_dev.blocklen;
+
+	r = calloc(1, sizeof(*r) + iovcnt * sizeof(struct iovec));
+	if (r == NULL) {
+		cb_args->cb_fn(cb_args->channel, cb_args->cb_arg, -ENOMEM);
+		return;
+	}
+
+	/* The trailing part, as iovecs of the domain: the same bases, offset past the valid bytes. */
+	for (i = 0; i < iovcnt && zero_bytes > 0; i++) {
+		if (iov[i].iov_len <= valid_bytes) {
+			valid_bytes -= iov[i].iov_len;
+			continue;
+		}
+
+		r->trailing[n].iov_base = (uint8_t *)iov[i].iov_base + valid_bytes;
+		r->trailing[n].iov_len = spdk_min(iov[i].iov_len - valid_bytes, zero_bytes);
+		zero_bytes -= r->trailing[n].iov_len;
+		valid_bytes = 0;
+		n++;
+	}
+
+	r->b = b;
+	r->channel = channel;
+	r->iov = iov;
+	r->iovcnt = iovcnt;
+	r->lba = lba;
+	r->lba_count = lba_count - zero_lba_count;
+	r->cb_args = cb_args;
+	r->ext_opts = ext_opts;
+
+	rc = spdk_memory_domain_memzero(ext_opts->memory_domain, ext_opts->memory_domain_ctx,
+					r->trailing, n, blob_bs_dev_domain_zeroed, r);
+	if (rc != 0) {
+		free(r);
+		cb_args->cb_fn(cb_args->channel, cb_args->cb_arg, rc);
+	}
+}
+
 static inline void
 blob_bs_dev_readv_ext(struct spdk_bs_dev *dev, struct spdk_io_channel *channel,
 		      struct iovec *iov, int iovcnt,
@@ -143,6 +234,12 @@ blob_bs_dev_readv_ext(struct spdk_bs_dev *dev, struct spdk_io_channel *channel,
 {
 	struct spdk_blob_bs_dev *b = (struct spdk_blob_bs_dev *)dev;
 
+	if (ext_opts != NULL && ext_opts->memory_domain != NULL &&
+	    spdk_unlikely(lba + lba_count > b->bs_dev.blockcnt)) {
+		blob_bs_dev_readv_domain(b, channel, iov, iovcnt, lba, lba_count, cb_args, ext_opts);
+		return;
+	}
+
 	/* The backing blob may be smaller than this blob, so zero any trailing bytes. */
 	zero_trailing_bytes(b, iov, iovcnt, lba, &lba_count);
 

+/* Evariops 0075: a domain's memzero, on buffers a test can reach, completed at once; counted. */
+static uint32_t g_memory_domain_memzero_calls;
+
+int
+spdk_memory_domain_memzero(struct spdk_memory_domain *src_domain, void *src_domain_ctx,
+			   struct iovec *iov, uint32_t iovcnt, void (*cpl_cb)(void *, int), void *cpl_cb_arg)
+{
+	uint32_t i;
+
+	g_memory_domain_memzero_calls++;
+	for (i = 0; i < iovcnt; i++) {
+		memset(iov[i].iov_base, 0, iov[i].iov_len);
+	}
+
+	cpl_cb(cpl_cb_arg, 0);
+	return 0;
+}
 

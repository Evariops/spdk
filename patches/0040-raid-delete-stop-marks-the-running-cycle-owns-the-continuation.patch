--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -3116,14 +3116,20 @@ raid_bdev_process_finish(struct raid_bdev_process *process, int status)
 	assert(process->state == RAID_PROCESS_STATE_RUNNING);
 	process->state = RAID_PROCESS_STATE_STOPPING;
 
-	/* Evariops 0035: the abort edge is a fact worth a line — a silent stop made
-	 * "the rebuild is still running" and "the rebuild is winding down" identical
-	 * to every observer. */
 	SPDK_NOTICELOG("raid bdev '%s': %s stopping (status: %s) (Evariops 0035)\n",
 		       process->raid_bdev->bdev.name,
 		       raid_bdev_process_to_str(process->type),
 		       spdk_strerror(-process->status));
 
+	/* Evariops 0040: with window requests in flight, the drain owns the
+	 * continuation. raid_bdev_process_request_complete() reaches zero and rides
+	 * the normal channel-update/unlock path, whose thread_run observes STOPPING.
+	 * Driving the unlock from here would unquiesce the range UNDER the in-flight
+	 * requests. */
+	if (process->window_remaining > 0) {
+		return;
+	}
+
 	if (process->window_range_locked) {
 		raid_bdev_process_unlock_window_range(process);
 	} else {
@@ -3131,15 +3137,38 @@ raid_bdev_process_finish(struct raid_bdev_process *process, int status)
 	}
 }
 
-/* Evariops 0035: the delete-side stop rides a thread message because the
- * process state machine is single-threaded on process->thread; the finish
- * path itself handles an already-STOPPING process as a no-op. */
+/* Evariops 0035: the delete-side stop rides a thread message — the process
+ * state machine is single-threaded on process->thread.
+ *
+ * Evariops 0040: this stop MARKS, it never DRIVES. raid_bdev_process_finish()
+ * drives the window machinery (unlock / thread_run), which is only correct from
+ * the cycle's own continuation points, and this message can land BETWEEN any
+ * two of them: it would unquiesce a range under in-flight requests and free the
+ * process beneath their completions, or double-drive a quiesce or channel
+ * update already in flight. Every resting state of the cycle has a pending
+ * continuation that observes STOPPING, so the running cycle owns the follow-up. */
 static void
 raid_bdev_delete_stop_process(void *ctx)
 {
 	struct raid_bdev_process *process = ctx;
 
-	raid_bdev_process_finish(process, -ECANCELED);
+	assert(spdk_get_thread() == process->thread);
+
+	if (process->status == 0) {
+		process->status = -ECANCELED;
+	}
+
+	if (process->state >= RAID_PROCESS_STATE_STOPPING) {
+		return;
+	}
+
+	assert(process->state == RAID_PROCESS_STATE_RUNNING);
+	process->state = RAID_PROCESS_STATE_STOPPING;
+
+	SPDK_NOTICELOG("raid bdev '%s': %s stopping (status: %s) — the running cycle owns the continuation (Evariops 0035/0040)\n",
+		       process->raid_bdev->bdev.name,
+		       raid_bdev_process_to_str(process->type),
+		       spdk_strerror(-process->status));
 }
 
 static void
@@ -3149,6 +3178,13 @@ raid_bdev_process_window_range_unlocked(void *ctx, int status)
 
 	if (status != 0) {
 		SPDK_ERRLOG("Failed to unlock LBA range: %s\n", spdk_strerror(-status));
+		/* Evariops 0040: already STOPPING, so finish() would no-op on its early
+		 * return and nothing else is pending — conclude directly. */
+		if (process->state >= RAID_PROCESS_STATE_STOPPING) {
+			process->window_range_locked = false;
+			raid_bdev_process_do_finish(process);
+			return;
+		}
 		raid_bdev_process_finish(process, status);
 		return;
 	}
@@ -3216,7 +3252,11 @@ raid_bdev_process_request_complete(struct raid_bdev_process_request *process_req
 
 	process->window_remaining -= process_req->num_blocks;
 	if (process->window_remaining == 0) {
-		if (process->window_status != 0) {
+		/* Evariops 0040: when the stop landed mid-window, finish() would
+		 * no-op on its >=STOPPING early return and leak the locked window.
+		 * Ride the normal unlock path instead; thread_run sees STOPPING. */
+		if (process->window_status != 0 &&
+		    process->state < RAID_PROCESS_STATE_STOPPING) {
 			raid_bdev_process_finish(process, process->window_status);
 			return;
 		}
@@ -3335,6 +3375,13 @@ raid_bdev_process_window_range_locked(void *ctx, int status)
 
 	if (status != 0) {
 		SPDK_ERRLOG("Failed to lock LBA range: %s\n", spdk_strerror(-status));
+		/* Evariops 0040: the stop landed while the quiesce was in flight.
+		 * finish() would no-op and nothing else is pending, so conclude
+		 * directly — the range is not locked. */
+		if (process->state >= RAID_PROCESS_STATE_STOPPING) {
+			raid_bdev_process_do_finish(process);
+			return;
+		}
 		raid_bdev_process_finish(process, status);
 		return;
 	}

@@ -43,6 +44,57 @@ SPDK_BDEV_MODULE_REGISTER(lvol, &g_lvol_if)
 
 static void _vbdev_lvol_destroy(struct spdk_lvol *lvol, spdk_lvol_op_complete cb_fn, void *cb_arg);
 
+/* Evariops 0041: fill-accounting bridge to bdev_tier. The composite knows only
+ * geometry; which blocks are LIVE is the blobstore's. When an lvolstore sits on
+ * a tier composite, this provider answers bdev_tier_get_bands' per-band
+ * used_blocks by counting the allocated clusters intersecting the band's LBA
+ * range. Synchronous, called on the app/RPC thread. */
+static int
+vbdev_lvs_tier_band_usage(void *ctx, uint64_t lba_start, uint64_t num_blocks,
+			  uint64_t *used_blocks_out)
+{
+	struct lvol_store_bdev *lvs_bdev = ctx;
+	struct spdk_blob_store *bs = lvs_bdev->lvs->blobstore;
+	uint32_t blocklen = spdk_bdev_get_block_size(lvs_bdev->bdev);
+	uint64_t cluster_blocks, used_blocks;
+
+	if (blocklen == 0 || spdk_bs_get_cluster_size(bs) < blocklen) {
+		return -EINVAL;
+	}
+	cluster_blocks = spdk_bs_get_cluster_size(bs) / blocklen;
+	used_blocks = spdk_bs_count_allocated_clusters_in_lba_range(bs, lba_start, num_blocks) *
+		      cluster_blocks;
+	/* Band boundaries are cluster-aligned by the tier module's construction; the
+	 * clip keeps the answer bounded by the band even if they were not. */
+	if (used_blocks > num_blocks) {
+		used_blocks = num_blocks;
+	}
+	*used_blocks_out = used_blocks;
+	return 0;
+}
+
+static void
+vbdev_lvs_tier_usage_register(struct lvol_store_bdev *lvs_bdev)
+{
+	struct vbdev_tier *tier = vbdev_tier_get_by_name(spdk_bdev_get_name(lvs_bdev->bdev));
+
+	if (tier == NULL || lvs_bdev->bdev != &tier->bdev) {
+		return;		/* this lvolstore does not sit on a tier composite */
+	}
+	vbdev_tier_set_usage_provider(tier->bdev.name, vbdev_lvs_tier_band_usage, lvs_bdev);
+}
+
+static void
+vbdev_lvs_tier_usage_unregister(struct lvol_store_bdev *lvs_bdev)
+{
+	struct vbdev_tier *tier = vbdev_tier_get_by_name(spdk_bdev_get_name(lvs_bdev->bdev));
+
+	if (tier == NULL || lvs_bdev->bdev != &tier->bdev || tier->usage_ctx != lvs_bdev) {
+		return;
+	}
+	vbdev_tier_clear_usage_provider(tier->bdev.name);
+}

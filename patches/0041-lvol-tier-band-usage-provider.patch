+/* Evariops 0041: fill accounting over a fixed LBA region — count the allocated
+ * clusters in [lba_start, lba_start + lba_count). Both bounds must be
+ * cluster-aligned and the end must not wrap u64 (the tier caller aligns band
+ * boundaries to the blobstore cluster and refuses overflowing ranges at
+ * assembly): bs_lba_to_cluster asserts alignment, and the EXCLUSIVE end form is
+ * the only one whose argument stays aligned — the inclusive last LBA never is,
+ * and aborts every assert-enabled build (same convention as patch 0004).
+ * The count is one masked popcount per 64 clusters under used_lock — a
+ * whole-disk band stays microseconds; a bit-by-bit walk here would monopolize
+ * the single reactor for milliseconds per band at every poll (this series
+ * already paid that bug once, see 0004's word-wise rewrite). */
+uint64_t
+spdk_bs_count_allocated_clusters_in_lba_range(struct spdk_blob_store *bs, uint64_t lba_start,
+					      uint64_t lba_count)
+{
+	uint32_t c_start, c_end, cap;
+	uint64_t count;
+
+	if (lba_count == 0) {
+		return 0;
+	}
+	c_start = (uint32_t)bs_lba_to_cluster(bs, lba_start);
+	c_end = (uint32_t)bs_lba_to_cluster(bs, lba_start + lba_count);
+	cap = spdk_bit_pool_capacity(bs->used_clusters);
+	if (c_end > cap) {
+		c_end = cap;
+	}
+	if (c_start >= c_end) {
+		return 0;
+	}
+	spdk_spin_lock(&bs->used_lock);
+	count = spdk_bit_pool_count_allocated_in_range(bs->used_clusters, c_start, c_end - c_start);
+	spdk_spin_unlock(&bs->used_lock);
+	return count;
+}

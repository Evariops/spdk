+/* Evariops 0041: fill-accounting bridge to bdev_tier. The composite knows only
+ * geometry; which blocks are LIVE is the blobstore's. When an lvolstore sits on
+ * a tier composite, this provider answers bdev_tier_get_bands' per-band
+ * used_blocks by counting the allocated clusters in the band's LBA range.
+ * Synchronous, called on the app/RPC thread. */
+static int
+vbdev_lvs_tier_band_usage(void *ctx, uint64_t lba_start, uint64_t num_blocks,
+			  uint64_t *used_blocks_out)
+{
+	struct lvol_store_bdev *lvs_bdev = ctx;
+	struct spdk_blob_store *bs = lvs_bdev->lvs->blobstore;
+	uint32_t blocklen = spdk_bdev_get_block_size(lvs_bdev->bdev);
+	uint64_t cluster_blocks, used_blocks;
+
+	if (blocklen == 0 || spdk_bs_get_cluster_size(bs) < blocklen) {
+		return -EINVAL;
+	}
+	cluster_blocks = spdk_bs_get_cluster_size(bs) / blocklen;
+	used_blocks = spdk_bs_count_allocated_clusters_in_lba_range(bs, lba_start, num_blocks) *
+		      cluster_blocks;
+	/* Registration proved the band grain is a multiple of the blobstore cluster,
+	 * so no cluster straddles a band boundary and the sum over bands cannot
+	 * exceed the composite. The clip is therefore an invariant assert in
+	 * disguise, kept cheap. */
+	if (used_blocks > num_blocks) {
+		used_blocks = num_blocks;
+	}
+	*used_blocks_out = used_blocks;
+	return 0;
+}
+
+static void
+vbdev_lvs_tier_usage_register(struct lvol_store_bdev *lvs_bdev)
+{
+	struct vbdev_tier *tier = vbdev_tier_get_by_name(spdk_bdev_get_name(lvs_bdev->bdev));
+	struct spdk_blob_store *bs;
+	uint32_t blocklen;
+	uint64_t lvs_cluster_blocks;
+
+	if (tier == NULL || lvs_bdev->bdev != &tier->bdev) {
+		return;		/* this lvolstore does not sit on a tier composite */
+	}
+	/* The counting helper requires band boundaries to be blobstore-cluster
+	 * aligned. Band boundaries are aligned to the TIER grain (cluster_blocks),
+	 * so the requirement is: a real grain (>= 2 — the legacy 0 grain guarantees
+	 * no alignment at all) that is a whole multiple of the lvolstore cluster.
+	 * Nothing couples the two at lvs creation, so enforce it HERE, the first
+	 * point where both are known: a composite failing it gets NO provider and
+	 * reports used_blocks=0 + usage_valid=false (honest unknown) instead of
+	 * tripping the alignment assert or splitting a cluster across two bands. */
+	bs = lvs_bdev->lvs->blobstore;
+	blocklen = spdk_bdev_get_block_size(lvs_bdev->bdev);
+	if (blocklen == 0 || spdk_bs_get_cluster_size(bs) % blocklen != 0) {
+		SPDK_ERRLOG("lvol on tier '%s': blobstore cluster %" PRIu64 " not a multiple "
+			    "of blocklen %u — no usage provider\n", tier->bdev.name,
+			    spdk_bs_get_cluster_size(bs), blocklen);
+		return;
+	}
+	lvs_cluster_blocks = spdk_bs_get_cluster_size(bs) / blocklen;
+	if (tier->cluster_blocks < 2 || tier->cluster_blocks % lvs_cluster_blocks != 0) {
+		SPDK_ERRLOG("lvol on tier '%s': tier grain %" PRIu64 " blocks is not a "
+			    "multiple of the lvolstore cluster %" PRIu64 " blocks — band "
+			    "usage cannot be counted, no usage provider (used_blocks will "
+			    "report as unknown)\n", tier->bdev.name, tier->cluster_blocks,
+			    lvs_cluster_blocks);
+		return;
+	}
+	vbdev_tier_set_usage_provider(tier, vbdev_lvs_tier_band_usage, lvs_bdev);
+}
+
+/* Called at teardown INITIATION (remove/destroy entry, shutdown unload starts),
+ * BEFORE spdk_lvs_unload/spdk_lvs_destroy: those free the lvol store
+ * synchronously while the blobstore teardown is still an async I/O chain, and a
+ * bdev_tier_get_bands poll landing in that window would drive the provider into
+ * the freed store. Unregistering here closes the window; the completion
+ * callbacks free lvs_bdev only after this already ran. */
+static void
+vbdev_lvs_tier_usage_unregister(struct lvol_store_bdev *lvs_bdev)
+{
+	struct vbdev_tier *tier = vbdev_tier_get_by_name(spdk_bdev_get_name(lvs_bdev->bdev));
+
+	/* usage_ctx != lvs_bdev subsumes any bdev-pointer comparison: only the
+	 * register path above can have stored this ctx, and it proved the bdev. */
+	if (tier == NULL || tier->usage_ctx != lvs_bdev) {
+		return;
+	}
+	vbdev_tier_clear_usage_provider(tier);
+}

+uint32_t
+spdk_bit_array_count_set_in_range(const struct spdk_bit_array *ba, uint32_t start_bit_index,
+				  uint32_t count)
+{
+	uint32_t end, first_word, last_word, w;
+	uint32_t set_count = 0;
+	spdk_bit_array_word word;
+
+	/* Clamp to capacity (bits past bit_count are guaranteed clear by resize, but
+	 * the WORDS past the last one are not readable). */
+	if (start_bit_index >= ba->bit_count || count == 0) {
+		return 0;
+	}
+	if (count > ba->bit_count - start_bit_index) {
+		count = ba->bit_count - start_bit_index;
+	}
+	end = start_bit_index + count;	/* exclusive; <= bit_count so no overflow */
+
+	first_word = start_bit_index >> SPDK_BIT_ARRAY_WORD_INDEX_SHIFT;
+	last_word = (end - 1) >> SPDK_BIT_ARRAY_WORD_INDEX_SHIFT;
+
+	for (w = first_word; w <= last_word; w++) {
+		word = ba->words[w];
+		if (w == first_word) {
+			/* Drop the bits below start (their count in low positions). */
+			word &= ~((SPDK_BIT_ARRAY_WORD_C(1) <<
+				   (start_bit_index & SPDK_BIT_ARRAY_WORD_INDEX_MASK)) - 1);
+		}
+		if (w == last_word && (end & SPDK_BIT_ARRAY_WORD_INDEX_MASK) != 0) {
+			/* Keep only the bits below end. */
+			word &= (SPDK_BIT_ARRAY_WORD_C(1) <<
+				 (end & SPDK_BIT_ARRAY_WORD_INDEX_MASK)) - 1;
+		}
+		set_count += SPDK_BIT_ARRAY_WORD_POPCNT(word);
+	}
+
+	return set_count;
+}

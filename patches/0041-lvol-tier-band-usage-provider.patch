+/**
+ * Count the allocated clusters whose physical extent intersects
+ * [lba_start, lba_start + lba_count) on the underlying bs_dev. Fill accounting
+ * for a device that carves its address space into fixed regions (bands): the
+ * region's used bytes are count * cluster size, clipped to the region.
+ *
+ * \param bs Blobstore to query.
+ * \param lba_start Start of the LBA range.
+ * \param lba_count Length of the LBA range.
+ *
+ * \return number of allocated clusters intersecting the range.
+ */
+uint64_t spdk_bs_count_allocated_clusters_in_lba_range(struct spdk_blob_store *bs,
+		uint64_t lba_start, uint64_t lba_count);
+
 /**
  * Hold all I/O submitted to this blob. I/O released by the matching unfreeze
  * re-executes the blob-to-LBA translation, so a cluster relocated meanwhile is
diff --git a/lib/blob/blobstore.c b/lib/blob/blobstore.c
index e1daf9c..42bef8d 100644
--- a/lib/blob/blobstore.c
+++ b/lib/blob/blobstore.c
@@ -9136,6 +9136,41 @@ spdk_blob_release_cluster_lba(struct spdk_blob *blob, uint64_t lba)
 	spdk_spin_unlock(&bs->used_lock);
 }
 
+/* Evariops 0041: fill accounting over a fixed LBA region — count the allocated
+ * clusters whose extent intersects [lba_start, lba_start + lba_count). The scan
+ * walks used_clusters under used_lock, so the answer is a consistent snapshot;
+ * it is bounded by the region's cluster count, which a caller sizing bands
+ * already keeps modest. */
+uint64_t
+spdk_bs_count_allocated_clusters_in_lba_range(struct spdk_blob_store *bs, uint64_t lba_start,
+					      uint64_t lba_count)
+{
+	uint32_t c_start, c_end, cap, i;
+	uint64_t count = 0;
+
+	if (lba_count == 0) {
+		return 0;
+	}
+	c_start = (uint32_t)bs_lba_to_cluster(bs, lba_start);
+	/* Last LBA of the range, avoiding overflow on an end-of-space range. */
+	if (lba_start > UINT64_MAX - lba_count) {
+		lba_count = UINT64_MAX - lba_start;
+	}
+	c_end = (uint32_t)bs_lba_to_cluster(bs, lba_start + lba_count - 1) + 1;
+	cap = spdk_bit_pool_capacity(bs->used_clusters);
+	if (c_end > cap) {
+		c_end = cap;
+	}
+	spdk_spin_lock(&bs->used_lock);
+	for (i = c_start; i < c_end; i++) {
+		if (spdk_bit_pool_is_allocated(bs->used_clusters, i)) {
+			count++;
+		}
+	}
+	spdk_spin_unlock(&bs->used_lock);
+	return count;
+}

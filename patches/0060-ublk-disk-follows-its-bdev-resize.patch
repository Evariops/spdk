+static int ublk_bdev_resize_retry(void *arg);
+
+/* Evariops 0060: the bdev grew (an lvol resized to expand a volume), and the disk
+ * follows with UBLK_U_CMD_UPDATE_SIZE, so the kernel device, and the filesystem on
+ * it, see the new size. Upstream ignored the event: an online expansion of a
+ * volume served through ublk grew nothing. A disk busy with another control
+ * command (start, recovery, stop) is retried until it is idle. */
+static void
+ublk_bdev_resize(struct spdk_ublk_dev *ublk)
+{
+	int rc;
+
+	ublk->dev_params.basic.dev_sectors = spdk_bdev_get_num_blocks(ublk->bdev) <<
+					     ublk->sector_per_block_shift;
+	if (!g_ublk_tgt.update_size) {
+		SPDK_WARNLOG("ublk %u: bdev %s resized, which ublk_drv cannot follow (Evariops 0060)\n",
+			     ublk->ublk_id, spdk_bdev_get_name(ublk->bdev));
+		return;
+	}
+	if (ublk->is_closing) {
+		return;
+	}
+	if (ublk->ctrl_ops_in_progress > 0 || ublk->ctrl_cb != NULL || ublk->is_recovering ||
+	    ublk->online_num_queues < ublk->num_queues) {
+		if (ublk->resize_poller == NULL) {
+			ublk->resize_poller = SPDK_POLLER_REGISTER(ublk_bdev_resize_retry, ublk, 100000);
+		}
+		return;
+	}
+
+	rc = ublk_ctrl_cmd_submit(ublk, UBLK_CMD_UPDATE_SIZE);
+	if (rc < 0) {
+		SPDK_ERRLOG("ublk %u: size update failed to submit: %s (Evariops 0060)\n",
+			    ublk->ublk_id, spdk_strerror(-rc));
+	}
+}
+
+static int
+ublk_bdev_resize_retry(void *arg)
+{
+	struct spdk_ublk_dev *ublk = arg;
+
+	spdk_poller_unregister(&ublk->resize_poller);
+	ublk_bdev_resize(ublk);
+
+	return SPDK_POLLER_BUSY;
+}

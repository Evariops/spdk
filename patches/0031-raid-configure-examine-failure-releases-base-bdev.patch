diff --git a/module/bdev/raid/bdev_raid.c b/module/bdev/raid/bdev_raid.c
index feebb76..b8193b7 100644
--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -4432,6 +4432,14 @@ raid_bdev_configure_base_bdev_check_sb_cb(const struct raid_bdev_superblock *sb,
 	default:
 		SPDK_ERRLOG("Failed to examine bdev %s: %s\n",
 			    base_info->name, spdk_strerror(-status));
+		/* Evariops 0031: release everything raid_bdev_configure_base_bdev took —
+		 * desc, module claim, app-thread io channel — exactly like the
+		 * UUID-mismatch branch above. Keeping them leaves the slot squatting as
+		 * "configuring" and the open desc pins the member's nvme_ctrlr destruct
+		 * indefinitely. Reached when the superblock read fails against a member
+		 * that is dying, which is routine after a node power-cycle. */
+		base_info->configure_cb = NULL;
+		raid_bdev_free_base_bdev_resource(base_info);
 		break;
 	}
 

+/* Evariops 0029: format the non-zero holder categories ("base:1 ns:1 qpair:2").
+ * Caller holds nvme_ctrlr->mutex. */
+static const char *
+nvme_ctrlr_ref_holders_str(struct nvme_ctrlr *nvme_ctrlr, char *buf, size_t len)
+{
+	size_t off = 0;
+	int i, n;
+
+	buf[0] = '\0';
+	for (i = 0; i < NVME_CTRLR_REF_HOLDER_COUNT; i++) {
+		if (nvme_ctrlr->ref_by[i] == 0) {
+			continue;
+		}
+		n = snprintf(buf + off, len - off, "%s%s:%d",
+			     off > 0 ? " " : "",
+			     g_nvme_ctrlr_ref_holder_names[i], nvme_ctrlr->ref_by[i]);
+		if (n < 0 || (size_t)n >= len - off) {
+			break;
+		}
+		off += (size_t)n;
+	}
+	if (buf[0] == '\0') {
+		snprintf(buf, len, "none");
+	}
+	return buf;

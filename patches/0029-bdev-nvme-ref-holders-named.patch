+/* Evariops 0029: every ref taken on an nvme_ctrlr belongs to a named holder
+ * category — when a destruct defers on "ref N", the log must name the holders,
+ * not print an opaque integer (turing runs 13-14: a dead ctrlr sat on "ref 2"
+ * for the whole run and nothing could say who held them). */
+enum nvme_ctrlr_ref_holder {
+	NVME_CTRLR_REF_BASE = 0,	/* creation ref, released by _nvme_ctrlr_destruct */
+	NVME_CTRLR_REF_NS,		/* one per populated namespace (nvme_ns) */
+	NVME_CTRLR_REF_QPAIR,		/* one per nvme_qpair (io channel) */
+	NVME_CTRLR_REF_DISABLE,		/* disable operation in flight */
+	NVME_CTRLR_REF_CACHE_CLEAR,	/* io_path cache clearing in flight */
+	NVME_CTRLR_REF_ANA,		/* ANA log page update in flight */
+	NVME_CTRLR_REF_KEYS,		/* set-keys / authenticate iteration */
+	NVME_CTRLR_REF_HOLDER_COUNT
+};

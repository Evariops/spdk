+++ b/module/bdev/raid/bdev_raid.h
@@ -232,6 +232,11 @@ typedef void (*raid_bdev_configure_cb)(void *cb_ctx, int rc);
  * and the information related to any raid bdev either configured or
  * in configuring list. io device is created on this.
  */
+/* Evariops 0034: verify token length — mirrors RAID_REBUILD_TOKEN_MAX
+ * (bdev_raid_outcomes.h), duplicated rather than included so this header keeps
+ * no dependency on the outcome registry. */
+#define RAID_VERIFY_TOKEN_MAX		192
+

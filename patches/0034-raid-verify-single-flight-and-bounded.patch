+	/* Evariops 0023: how much this raid has served in degraded mode. Written
+	 * on the raid5f I/O paths with relaxed atomics, read by get_bdevs. The
+	 * slots are level-agnostic so other levels can feed them. 0 = never. */
+	uint64_t			reconstruct_reads_absent;	/* member missing */
+	uint64_t			reconstruct_reads_error;	/* member present but erroring */
 	uint64_t			degraded_write_stripes;		/* stripes written at zero margin */
 	int64_t				last_degraded_ts;		/* unix seconds of the last event */
 
+	/* Evariops 0034: the single in-flight verify_ranges on this raid; a second
+	 * one is refused. A verify takes an LBA-range lock per chunk and drops it
+	 * between chunks, and a whole-device quiesce (member removal) is only
+	 * promoted inside such a gap. Two concurrent verifies interleave so that no
+	 * instant is lock-free, and the quiesce then never completes. A client

 	/* raid bdev device, this will get registered in bdev layer */
 	struct spdk_bdev		bdev;
@@ -317,6 +322,19 @@ struct raid_bdev {
 	uint64_t			degraded_write_stripes;		/* stripes written at zero margin */
 	int64_t				last_degraded_ts;		/* unix seconds of the last event */
 
+	/* Evariops 0034 (SPEC-77L Q-024-1): THE SINGLE in-flight verify_ranges on
+	 * this raid. A verify holds an LBA-range lock per chunk and releases it
+	 * between chunks — alone, it leaves gaps, and a whole-device quiesce (the
+	 * member-removal path) is promoted in one of them. TWO of them interleave so
+	 * that no instant is ever lock-free, and the quiesce is then NEVER promoted:
+	 * measured on turing run 42, where a detach stayed "in flight" for the
+	 * raid's entire life behind ~10 stacked verifies, each leaked by a client
+	 * deadline that does not cancel server-side work. One at a time — and it
+	 * NAMES its holder, because an invisible lock cost an hour of deduction. */
+	bool				verify_active;
+	char				verify_token[RAID_VERIFY_TOKEN_MAX];
+	int64_t				verify_since;		/* unix seconds, 0 = none */
+
 	/* Callback and context for raid_bdev configuration */
 	raid_bdev_configure_cb		configure_cb;
 	void				*configure_cb_ctx;

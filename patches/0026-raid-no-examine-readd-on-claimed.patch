diff --git a/module/bdev/raid/bdev_raid.c b/module/bdev/raid/bdev_raid.c
index dd3cb51..feebb76 100644
--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -4849,6 +4849,12 @@ out:
 	raid_bdev_examine_others_done(ctx, status);
 }
 
+/* Evariops 0026: forward-declared so raid_bdev_examine_sb can tell its two
+ * callers apart — the bdev-module examine chain passes this callback, a
+ * control-plane add passes the requester's. The re-add guard applies only to
+ * the examine chain. */
+static void raid_bdev_examine_done(void *ctx, int status);
+
 static void
 raid_bdev_examine_sb(const struct raid_bdev_superblock *sb, struct spdk_bdev *bdev,
 		     raid_base_bdev_cb cb_fn, void *cb_ctx)
@@ -4858,6 +4864,10 @@ raid_bdev_examine_sb(const struct raid_bdev_superblock *sb, struct spdk_bdev *bd
 	struct raid_base_bdev_info *iter, *base_info;
 	uint8_t i;
 	int rc;
+	/* Evariops 0026: capture the caller HERE, at entry. cb_fn is reassigned to
+	 * raid_bdev_examine_others further down, so testing it at the guard below
+	 * would read the wrong caller. */
+	const bool discovered = (cb_fn == raid_bdev_examine_done);
 
 	if (sb->block_size != spdk_bdev_get_data_block_size(bdev)) {
 		SPDK_WARNLOG("Bdev %s block size (%u) does not match the value in superblock (%u)\n",
@@ -4948,6 +4958,22 @@ raid_bdev_examine_sb(const struct raid_bdev_superblock *sb, struct spdk_bdev *bd
 	}
 
 	if (raid_bdev->state == RAID_BDEV_STATE_ONLINE) {
+		/* Evariops 0026: never auto re-add a returning member into a CLAIMED
+		 * raid. Re-admission belongs to the control plane (write_only attach
+		 * plus seeded rebuild); an examine-driven re-add races the controller's
+		 * own attach on a live raid. An UNCLAIMED raid keeps upstream behaviour,
+		 * since reassembly at boot is the superblock's whole purpose.
+		 *
+		 * The `discovered` test is load-bearing: without it the guard also
+		 * refuses the control plane, whose add reaches here through
+		 * raid_bdev_configure_base_bdev_check_sb_cb and would get -EPERM. */
+		if (raid_bdev->incarnation != NULL && discovered) {
+			SPDK_NOTICELOG("Not re-adding bdev %s to claimed raid bdev %s (incarnation '%s') — "
+				       "member re-admission belongs to the control plane (Evariops 0026)\n",
+				       bdev->name, raid_bdev->bdev.name, raid_bdev->incarnation);
+			rc = -EPERM;
+			goto out;
+		}
 		assert(sb_base_bdev->slot < raid_bdev->num_base_bdevs);
 		base_info = &raid_bdev->base_bdev_info[sb_base_bdev->slot];
 		assert(base_info->is_configured == false);

+/* CBT emits coalesced dirty ranges; the 1 MiB process window makes finer
+ * granularity worthless, so the orchestrator folds any excess (same cap as
+ * bdev_raid_rebuild_ranges). */
+#define RAID_SEEDED_REBUILD_MAX_RANGES 4096u

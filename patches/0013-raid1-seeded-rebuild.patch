+{
+	const struct spdk_json_object_decoder decoders[] = {
+		{"offset_blocks", offsetof(struct raid_bdev_seed_range, offset_blocks), spdk_json_decode_uint64},
+		{"length_blocks", offsetof(struct raid_bdev_seed_range, num_blocks), spdk_json_decode_uint64},
+	};
+
+	return spdk_json_decode_object(val, decoders, SPDK_COUNTOF(decoders),
+				       (struct raid_bdev_seed_range *)out) ? -1 : 0;
+}
+
+static int
+decode_seed_ranges(const struct spdk_json_val *val, void *out)
+{
+	struct rpc_bdev_raid_start_seeded_rebuild *req =
+		SPDK_CONTAINEROF(out, struct rpc_bdev_raid_start_seeded_rebuild, ranges);
+
+	if (req->ranges == NULL) {
+		req->ranges = calloc(RAID_SEEDED_REBUILD_MAX_RANGES, sizeof(struct raid_bdev_seed_range));
+		if (req->ranges == NULL) {
+			return -ENOMEM;
+		}
+	}
+	return spdk_json_decode_array(val, decode_seed_range, req->ranges,
+				      RAID_SEEDED_REBUILD_MAX_RANGES, &req->num_ranges,
+				      sizeof(struct raid_bdev_seed_range));

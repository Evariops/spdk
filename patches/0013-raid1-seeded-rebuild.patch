+raid_bdev_process_window_seeded_clean(struct raid_bdev_process *process)
+{
+	uint64_t offset = process->window_offset;
+	uint64_t offset_end = spdk_min(offset + process->max_window_size,
+				       process->raid_bdev->bdev.blockcnt);

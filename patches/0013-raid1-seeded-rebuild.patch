+static int
+seed_range_cmp(const void *a, const void *b)
+{
+	const struct raid_bdev_seed_range *ra = a;
+	const struct raid_bdev_seed_range *rb = b;
+
+	if (ra->offset_blocks < rb->offset_blocks) {
+		return -1;
+	}
+	if (ra->offset_blocks > rb->offset_blocks) {
+		return 1;
+	}
+	return 0;
+}

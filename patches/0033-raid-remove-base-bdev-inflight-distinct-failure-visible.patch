diff --git a/module/bdev/raid/bdev_raid.c b/module/bdev/raid/bdev_raid.c
index b8193b7..228233a 100644
--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -513,6 +513,9 @@ raid_bdev_free_base_bdev_resource(struct raid_base_bdev_info *base_info)
 		spdk_uuid_set_null(&base_info->uuid);
 	}
 	base_info->is_failed = false;
+	/* Evariops 0033: reset remove_error with is_failed, so a reused slot never
+	 * inherits the previous incarnation's removal failure. */
+	base_info->remove_error = 0;
 	raid_bdev_base_bdev_state_touch(base_info);
 
 	/* clear `data_offset` to allow it to be recalculated during configuration */
@@ -1280,14 +1283,16 @@ raid_bdev_write_info_json(struct raid_bdev *raid_bdev, struct spdk_json_write_ct
 		spdk_json_write_named_bool(w, "is_configured", base_info->is_configured);
 		spdk_json_write_named_uint64(w, "data_offset", base_info->data_offset);
 		spdk_json_write_named_uint64(w, "data_size", base_info->data_size);
-		/* Evariops 0014.6 (RPC-CONTRACT §3): the control-plane's member
-		 * observation — derived state + hysteresis stamp + V-2 generation
-		 * facts + the wrapping cbt's live-epoch facts (EpochObservation
-		 * source; absent when the member is not cbt-wrapped or tracks no
-		 * epoch). */
+		/* Evariops 0017: the per-member observation the control plane reads —
+		 * derived state, hysteresis stamp, generation facts, and the wrapping
+		 * cbt's live epoch. The epoch fields are absent when the member is not
+		 * cbt-wrapped or tracks no epoch; absent is a fact, not an error. */
 		spdk_json_write_named_string(w, "state",
 					     raid_bdev_base_bdev_state_name(base_info));
 		spdk_json_write_named_int64(w, "since", base_info->state_since);
+		/* Evariops 0033: the member carries its own failed-removal errno;
+		 * 0 means no removal has failed. */
+		spdk_json_write_named_int32(w, "remove_error", base_info->remove_error);
 		spdk_json_write_named_uint64(w, "content_generation",
 					     base_info->content_generation);
 		spdk_json_write_named_uint64(w, "view_epoch", base_info->view_epoch);
@@ -2457,7 +2462,24 @@ _raid_bdev_remove_base_bdev(struct raid_base_bdev_info *base_info,
 
 	assert(spdk_get_thread() == spdk_thread_get_app_thread());
 
-	if (base_info->remove_scheduled || !base_info->is_configured) {
+	/* Evariops 0033: the two refusals must not share one errno. -EALREADY means
+	 * a removal is in flight, so the caller has to wait and observe; -ENODEV
+	 * means the bdev is not a member and the end state IS reached. Upstream
+	 * returned -ENODEV for both, so a caller could read "on its way out" as
+	 * "already gone" and declare the detach complete while the slot was still
+	 * configured. */
+	if (base_info->remove_scheduled) {
+		SPDK_NOTICELOG("remove_base_bdev '%s' of raid bdev '%s' slot %d: a removal is ALREADY in flight — "
+			       "-EALREADY (configured %d failed %d remove_error %d); the caller must wait and observe, "
+			       "not conclude (Evariops 0033)\n",
+			       base_info->name != NULL ? base_info->name : "(null)",
+			       raid_bdev->bdev.name, raid_bdev_base_bdev_slot(base_info),
+			       (int)base_info->is_configured, (int)base_info->is_failed,
+			       base_info->remove_error);
+		return -EALREADY;
+	}
+
+	if (!base_info->is_configured) {
 		return -ENODEV;
 	}
 
@@ -2545,12 +2567,38 @@ static void
 raid_bdev_fail_base_remove_cb(void *ctx, int status)
 {
 	struct raid_base_bdev_info *base_info = ctx;
+	struct raid_bdev *raid_bdev = base_info->raid_bdev;
 
-	if (status != 0) {
-		SPDK_WARNLOG("Failed to remove base bdev %s\n", base_info->name);
-		base_info->is_failed = false;
-		raid_bdev_base_bdev_state_touch(base_info);
+	if (status == 0) {
+		return;
+	}
+
+	if (status == -EALREADY) {
+		/* Evariops 0033: a removal was already scheduled, so the ejection is
+		 * proceeding and nothing failed. Leave the member FAILED and do not
+		 * re-arm: the blanket reset below would advertise a healthy full
+		 * member that is in fact on its way out. */
+		SPDK_NOTICELOG("Failing base bdev in slot %d ('%s') of raid bdev '%s': its removal was already "
+			       "in flight — the ejection proceeds, the member stays FAILED (Evariops 0033)\n",
+			       raid_bdev_base_bdev_slot(base_info),
+			       base_info->name != NULL ? base_info->name : "(null)",
+			       raid_bdev->bdev.name);
+		return;
 	}
+
+	/* Evariops 0033: a removal that did NOT happen must not look like a member
+	 * that never failed. The member stays FAILED and carries the errno, so
+	 * putting it back in service is a control-plane decision rather than a
+	 * local reflex. Service I/O is unaffected either way: raid1 routes on the
+	 * slot's channel, never on is_failed. */
+	base_info->remove_error = status;
+	raid_bdev_base_bdev_state_touch(base_info);
+
+	SPDK_NOTICELOG("Failed to remove failed base bdev '%s' from raid bdev '%s' slot %d: %s (%d) — the member "
+		       "stays FAILED and still in the raid; the local fail path is re-armed for a later attempt and "
+		       "re-admission belongs to the control plane (Evariops 0033)\n",
+		       base_info->name != NULL ? base_info->name : "(null)", raid_bdev->bdev.name,
+		       raid_bdev_base_bdev_slot(base_info), spdk_strerror(-status), status);
 }
 
 static void
@@ -2559,9 +2607,14 @@ _raid_bdev_fail_base_bdev(void *ctx)
 	struct raid_base_bdev_info *base_info = ctx;
 	int rc;
 
-	if (base_info->is_failed) {
+	/* Evariops 0033: explicit re-entry latch. Re-failing an already-failed member
+	 * is allowed for exactly one reason: its previous removal attempt genuinely
+	 * failed (remove_error != 0). A removal merely in flight (remove_error == 0)
+	 * short-circuits, so retrying never requires clearing is_failed. */
+	if (base_info->is_failed && base_info->remove_error == 0) {
 		return;
 	}
+	base_info->remove_error = 0;
 	base_info->is_failed = true;
 	raid_bdev_base_bdev_state_touch(base_info);
 
@@ -2673,7 +2726,13 @@ raid_bdev_event_base_bdev(enum spdk_bdev_event_type type, struct spdk_bdev *bdev
 	switch (type) {
 	case SPDK_BDEV_EVENT_REMOVE:
 		rc = raid_bdev_remove_base_bdev(bdev, NULL, NULL, NULL);
-		if (rc != 0) {
+		if (rc == -EALREADY) {
+			/* Evariops 0033: the hot-unplug event and the control plane's own
+			 * detach raced. That is benign — the removal is in flight — so it
+			 * must not be reported as an error. */
+			SPDK_NOTICELOG("Base bdev %s removed: a removal was already in flight (Evariops 0033)\n",
+				       spdk_bdev_get_name(bdev));
+		} else if (rc != 0) {
 			SPDK_ERRLOG("Failed to remove base bdev %s: %s\n",
 				    spdk_bdev_get_name(bdev), spdk_strerror(-rc));
 		}
@@ -2827,8 +2886,23 @@ raid_bdev_process_finish_target_removed(void *ctx, int status)
 {
 	struct raid_bdev_process *process = ctx;
 
-	if (status != 0) {
-		SPDK_ERRLOG("Failed to remove target bdev: %s\n", spdk_strerror(-status));
+	/* Evariops 0033: the registry entry sealed below reports the rebuild's own
+	 * outcome; a target that also refused to leave the raid is a separate fact,
+	 * so the member carries it as remove_error. -EALREADY is not a failure —
+	 * the ejection is in flight. */
+	if (status != 0 && status != -EALREADY) {
+		process->target->remove_error = status;
+		raid_bdev_base_bdev_state_touch(process->target);
+		SPDK_ERRLOG("Failed to remove target bdev '%s' after a failed %s on raid bdev '%s': %s — the target "
+			    "stays in the raid and now carries remove_error (Evariops 0033)\n",
+			    process->target->name != NULL ? process->target->name : "(null)",
+			    raid_bdev_process_to_str(process->type), process->raid_bdev->bdev.name,
+			    spdk_strerror(-status));
+	} else if (status == -EALREADY) {
+		SPDK_NOTICELOG("Target bdev '%s' of raid bdev '%s': removal already in flight after a failed %s "
+			       "(Evariops 0033)\n",
+			       process->target->name != NULL ? process->target->name : "(null)",
+			       process->raid_bdev->bdev.name, raid_bdev_process_to_str(process->type));
 	}
 
 	spdk_thread_send_msg(process->thread, _raid_bdev_process_finish_done, process);
diff --git a/module/bdev/raid/bdev_raid.h b/module/bdev/raid/bdev_raid.h
index d137c1a..44066af 100644
--- a/module/bdev/raid/bdev_raid.h
+++ b/module/bdev/raid/bdev_raid.h
@@ -110,6 +110,12 @@ struct raid_base_bdev_info {
 	/* Set to true to indicate that the base bdev is being removed because of a failure */
 	bool			is_failed;
 
+	/* Evariops 0033: errno of the last removal attempt that actually failed on
+	 * this member; 0 = none, and -EALREADY never lands here since an in-flight
+	 * removal is not a failure. It is reported per-member by get_bdevs and is
+	 * the only thing that re-arms the local fail path. */
+	int			remove_error;
+
 	/* callback for base bdev configuration */
 	raid_base_bdev_cb	configure_cb;
 
@@ -354,6 +360,12 @@ enum raid_bdev_state raid_bdev_str_to_state(const char *str);
 const char *raid_bdev_state_to_str(enum raid_bdev_state state);
 const char *raid_bdev_process_to_str(enum raid_process_type value);
 void raid_bdev_write_info_json(struct raid_bdev *raid_bdev, struct spdk_json_write_ctx *w);
+/* Evariops 0033 — callers must distinguish these:
+ *   0         removal accepted; cb_fn reports its completion.
+ *   -EALREADY a removal is already in flight on this member. The wanted end
+ *             state is arriving: wait and observe, never conclude "removed".
+ *   -ENODEV   the bdev is not a member of any raid, or the slot is not
+ *             configured — the end state is already reached. */
 int raid_bdev_remove_base_bdev(struct spdk_bdev *base_bdev, const char *expected_incarnation,
 			       raid_base_bdev_cb cb_fn, void *cb_ctx);
 

+static int
+nvme_local_ctrlr_get_memory_domains(const struct spdk_nvme_ctrlr *ctrlr,
+				    struct spdk_memory_domain **domains, int array_size)
+{
+	/* Says the transport takes I/O described by a memory domain: it hands the domain over. */
+	if (domains != NULL && array_size > 0) {
+		domains[0] = spdk_memory_domain_get_system_domain();
+	}
+
+	return 1;
+}

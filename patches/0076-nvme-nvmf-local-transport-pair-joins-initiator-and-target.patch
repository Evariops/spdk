+
+/* A qpair in the group's disconnected list waits there for the target's slots. */
+static bool
+nvme_local_qpair_check_disconnected(struct spdk_nvme_qpair *qpair)
+{
+	if (nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTING) {
+		spdk_nvme_qpair_process_completions(qpair, 0);
+	}
+
+	return nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTED;
+}
+
+static void
+nvme_local_poll_group_check_disconnected_qpairs(struct spdk_nvme_transport_poll_group *tgroup,
+		spdk_nvme_disconnected_qpair_cb disconnected_qpair_cb)
+{
+	struct spdk_nvme_qpair *qpair, *tmp;
+
+	STAILQ_FOREACH_SAFE(qpair, &tgroup->disconnected_qpairs, poll_group_stailq, tmp) {
+		if (nvme_local_qpair_check_disconnected(qpair)) {
+			disconnected_qpair_cb(qpair, tgroup->group->ctx);
+		}
+	}
+}
+
+static int64_t
+nvme_local_poll_group_process_completions(struct spdk_nvme_transport_poll_group *tgroup,
+		uint32_t completions_per_qpair, spdk_nvme_disconnected_qpair_cb disconnected_qpair_cb)
+{
+	struct spdk_nvme_qpair *qpair, *tmp;
+	int64_t num_completions = 0;
+	int32_t rc;
+
+	nvme_local_poll_group_check_disconnected_qpairs(tgroup, disconnected_qpair_cb);
+
+	STAILQ_FOREACH_SAFE(qpair, &tgroup->connected_qpairs, poll_group_stailq, tmp) {
+		rc = spdk_nvme_qpair_process_completions(qpair, completions_per_qpair);
+		if (spdk_unlikely(rc < 0)) {
+			num_completions = -ENXIO;
+		} else if (num_completions >= 0) {
+			num_completions += rc;
+		}
+	}
+
+	return num_completions;
+}
+
+static int
+nvme_local_poll_group_destroy(struct spdk_nvme_transport_poll_group *tgroup)
+{
+	if (!STAILQ_EMPTY(&tgroup->connected_qpairs) || !STAILQ_EMPTY(&tgroup->disconnected_qpairs)) {
+		return -EBUSY;
+	}
+
+	free(SPDK_CONTAINEROF(tgroup, struct nvme_local_poll_group, group));
+	return 0;
+}
+
+const struct spdk_nvme_transport_ops local_ops = {
+	.name = NVME_LOCAL_TRSTRING,
+	.type = SPDK_NVME_TRANSPORT_CUSTOM_FABRICS,
+	.ctrlr_construct = nvme_local_ctrlr_construct,
+	.ctrlr_scan = nvme_fabric_ctrlr_scan,
+	.ctrlr_destruct = nvme_local_ctrlr_destruct,
+	.ctrlr_enable = nvme_local_ctrlr_enable,
+
+	.ctrlr_set_reg_4 = nvme_fabric_ctrlr_set_reg_4,
+	.ctrlr_set_reg_8 = nvme_fabric_ctrlr_set_reg_8,
+	.ctrlr_get_reg_4 = nvme_fabric_ctrlr_get_reg_4,
+	.ctrlr_get_reg_8 = nvme_fabric_ctrlr_get_reg_8,
+	.ctrlr_set_reg_4_async = nvme_fabric_ctrlr_set_reg_4_async,
+	.ctrlr_set_reg_8_async = nvme_fabric_ctrlr_set_reg_8_async,
+	.ctrlr_get_reg_4_async = nvme_fabric_ctrlr_get_reg_4_async,
+	.ctrlr_get_reg_8_async = nvme_fabric_ctrlr_get_reg_8_async,
+
+	.ctrlr_get_max_xfer_size = nvme_local_ctrlr_get_max_xfer_size,
+	.ctrlr_get_max_sges = nvme_local_ctrlr_get_max_sges,
+
+	.ctrlr_create_io_qpair = nvme_local_ctrlr_create_io_qpair,
+	.ctrlr_delete_io_qpair = nvme_local_ctrlr_delete_io_qpair,
+	.ctrlr_connect_qpair = nvme_local_ctrlr_connect_qpair,
+	.ctrlr_disconnect_qpair = nvme_local_ctrlr_disconnect_qpair,
+
+	.ctrlr_get_memory_domains = nvme_local_ctrlr_get_memory_domains,
+
+	.qpair_abort_reqs = nvme_local_qpair_abort_reqs,
+	.qpair_reset = nvme_local_qpair_reset,
+	.qpair_submit_request = nvme_local_qpair_submit_request,
+	.qpair_process_completions = nvme_local_qpair_process_completions,
+	.qpair_iterate_requests = nvme_local_qpair_iterate_requests,
+	.admin_qpair_abort_aers = nvme_local_admin_qpair_abort_aers,
+
+	.poll_group_create = nvme_local_poll_group_create,
+	.poll_group_process_completions = nvme_local_poll_group_process_completions,
+	.poll_group_check_disconnected_qpairs = nvme_local_poll_group_check_disconnected_qpairs,
+	.poll_group_destroy = nvme_local_poll_group_destroy,
+};
+
+SPDK_NVME_TRANSPORT_REGISTER(local, &local_ops);

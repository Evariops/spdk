diff --git a/test/unit/lib/nvme/nvme_local.c/nvme_local_ut.c b/test/unit/lib/nvme/nvme_local.c/nvme_local_ut.c
new file mode 100644
index 0000000..81027b7
--- /dev/null
+++ b/test/unit/lib/nvme/nvme_local.c/nvme_local_ut.c
@@ -0,0 +1,500 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (c) 2026 Evariops.
+ */
+
+/*
+ * The LOCAL initiator (Evariops 0076) against a target the test plays itself: it takes the slots
+ * the initiator hands over, completes them, frees them or closes, through the shared connection.
+ */
+
+#include "spdk/stdinc.h"
+#include "spdk/nvme.h"
+
+#include "spdk_internal/cunit.h"
+
+#include "nvme/nvme_internal.h"
+#include "common/lib/nvme/common_stubs.h"
+
+/* The generic layer's state changes, which the stubs above do not make. */
+static void ut_disconnect_qpair_done(struct spdk_nvme_qpair *qpair);
+#define nvme_transport_ctrlr_disconnect_qpair_done ut_disconnect_qpair_done
+static void ut_ctrlr_disconnect_qpair(struct spdk_nvme_qpair *qpair);
+#define nvme_ctrlr_disconnect_qpair ut_ctrlr_disconnect_qpair
+
+#include "nvme/nvme_local.c"
+
+SPDK_LOG_REGISTER_COMPONENT(nvme)
+
+DEFINE_STUB_V(nvme_qpair_resubmit_requests, (struct spdk_nvme_qpair *qpair,
+		uint32_t num_requests));
+DEFINE_STUB_V(spdk_nvme_qpair_print_command, (struct spdk_nvme_qpair *qpair,
+		struct spdk_nvme_cmd *cmd));
+DEFINE_STUB_V(spdk_nvme_qpair_print_completion_ext, (const struct spdk_nvme_qpair *qpair,
+		const struct spdk_nvme_cpl *cpl, uint8_t opc));
+DEFINE_STUB(spdk_memory_domain_get_system_domain, struct spdk_memory_domain *, (void), NULL);
+
+static void
+ut_disconnect_qpair_done(struct spdk_nvme_qpair *qpair)
+{
+	nvme_qpair_set_state(qpair, NVME_QPAIR_DISCONNECTED);
+}
+
+static void
+ut_ctrlr_disconnect_qpair(struct spdk_nvme_qpair *qpair)
+{
+	if (nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTING ||
+	    nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTED) {
+		return;
+	}
+
+	nvme_qpair_set_state(qpair, NVME_QPAIR_DISCONNECTING);
+	nvme_local_ctrlr_disconnect_qpair(qpair->ctrlr, qpair);
+}
+
+/* ── The target the test plays ── */
+
+static struct nvme_local_conn *g_accepted;
+static int g_accept_rc;
+
+static int
+ut_accept(void *ctx, struct nvme_local_conn *conn)
+{
+	if (g_accept_rc != 0) {
+		return g_accept_rc;
+	}
+
+	nvme_local_conn_get(conn);
+	g_accepted = conn;
+	return 0;
+}
+
+static struct nvme_local_slot *
+ut_take(struct nvme_local_conn *conn)
+{
+	void *slot = NULL;
+
+	return nvme_local_ring_take(&conn->sq, &slot, 1) == 1 ? slot : NULL;
+}
+
+static void
+ut_hand_back(struct nvme_local_conn *conn, struct nvme_local_slot *slot, uint8_t sct, uint8_t sc)
+{
+	memset(&slot->cpl, 0, sizeof(slot->cpl));
+	slot->cpl.cid = slot->cmd.cid;
+	slot->cpl.status.sct = sct;
+	slot->cpl.status.sc = sc;
+	CU_ASSERT(nvme_local_ring_put(&conn->cq, slot));
+}
+
+static void
+ut_target_close(struct nvme_local_conn *conn)
+{
+	__atomic_store_n(&conn->target_closed, true, __ATOMIC_RELEASE);
+	spdk_nvme_local_conn_put(conn);
+}
+
+/* ── The initiator side ── */
+
+struct ut_done {
+	int			called;
+	struct spdk_nvme_cpl	cpl;
+};
+
+static void
+ut_cb(void *arg, const struct spdk_nvme_cpl *cpl)
+{
+	struct ut_done *done = arg;
+
+	done->called++;
+	done->cpl = *cpl;
+}
+
+static struct spdk_nvme_transport_id g_trid = { .trtype = SPDK_NVME_TRANSPORT_CUSTOM };
+static struct spdk_nvme_ctrlr g_ctrlr;
+
+static void
+ut_setup(void)
+{
+	memset(&g_ctrlr, 0, sizeof(g_ctrlr));
+	snprintf(g_trid.trstring, sizeof(g_trid.trstring), "%s", NVME_LOCAL_TRSTRING);
+	snprintf(g_trid.traddr, sizeof(g_trid.traddr), "node0");
+	snprintf(g_trid.trsvcid, sizeof(g_trid.trsvcid), "1");
+	g_ctrlr.trid = g_trid;
+	g_accepted = NULL;
+	g_accept_rc = 0;
+	CU_ASSERT(spdk_nvme_local_listen(&g_trid, ut_accept, NULL) == 0);
+}
+
+static void
+ut_teardown(void)
+{
+	spdk_nvme_local_stop_listen(&g_trid);
+}
+
+/* A qpair connected the way the generic layer drives it: connect, then polls until CONNECTED. */
+static struct spdk_nvme_qpair *
+ut_qpair_connected(uint16_t qid, uint32_t qsize)
+{
+	struct spdk_nvme_qpair *qpair;
+
+	qpair = nvme_local_ctrlr_create_qpair(&g_ctrlr, qid, qsize, 0, qsize, true);
+	SPDK_CU_ASSERT_FATAL(qpair != NULL);
+	nvme_qpair_set_state(qpair, NVME_QPAIR_CONNECTING);
+	CU_ASSERT(nvme_local_ctrlr_connect_qpair(&g_ctrlr, qpair) == 0);
+	SPDK_CU_ASSERT_FATAL(g_accepted != NULL);
+	CU_ASSERT(g_accepted->num_slots == qsize - 1);
+	CU_ASSERT(g_accepted->qid == qid);
+	/* Sends the Fabrics CONNECT (stubbed), then polls it (stubbed: done). */
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 0);
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 0);
+	CU_ASSERT(nvme_qpair_get_state(qpair) == NVME_QPAIR_CONNECTED);
+	nvme_qpair_set_state(qpair, NVME_QPAIR_ENABLED);
+	return qpair;
+}
+
+static void
+ut_req(struct nvme_request *req, struct spdk_nvme_qpair *qpair, uint8_t opc, struct ut_done *done)
+{
+	req->cmd.opc = opc;
+	req->cmd.nsid = 1;
+	req->qpair = qpair;
+	qpair->num_outstanding_reqs++;
+	memset(done, 0, sizeof(*done));
+}
+
+static void
+ut_qpair_delete(struct spdk_nvme_qpair *qpair)
+{
+	CU_ASSERT(nvme_local_ctrlr_delete_io_qpair(&g_ctrlr, qpair) == 0);
+}
+
+/* ── Tests ── */
+
+static void
+test_listen_and_refuse(void)
+{
+	struct spdk_nvme_transport_id other = g_trid;
+	struct spdk_nvme_qpair *qpair;
+
+	ut_setup();
+
+	/* One listener per address. */
+	CU_ASSERT(spdk_nvme_local_listen(&g_trid, ut_accept, NULL) == -EADDRINUSE);
+
+	/* No listener there: refused, and nothing accepted. */
+	qpair = nvme_local_ctrlr_create_qpair(&g_ctrlr, 1, 4, 0, 4, true);
+	SPDK_CU_ASSERT_FATAL(qpair != NULL);
+	snprintf(other.trsvcid, sizeof(other.trsvcid), "2");
+	g_ctrlr.trid = other;
+	CU_ASSERT(nvme_local_ctrlr_connect_qpair(&g_ctrlr, qpair) == -ECONNREFUSED);
+	CU_ASSERT(g_accepted == NULL);
+
+	/* The target refuses: its error, and nothing accepted. */
+	g_ctrlr.trid = g_trid;
+	g_accept_rc = -ENOMEM;
+	CU_ASSERT(nvme_local_ctrlr_connect_qpair(&g_ctrlr, qpair) == -ENOMEM);
+	CU_ASSERT(g_accepted == NULL);
+
+	/* Stopped: refused. */
+	g_accept_rc = 0;
+	spdk_nvme_local_stop_listen(&g_trid);
+	CU_ASSERT(nvme_local_ctrlr_connect_qpair(&g_ctrlr, qpair) == -ECONNREFUSED);
+	ut_qpair_delete(qpair);
+}
+
+static void
+test_qpairs_are_async_only(void)
+{
+	ut_setup();
+	/* A synchronous wait spins a reactor the target may share. */
+	CU_ASSERT(nvme_local_ctrlr_create_qpair(&g_ctrlr, 1, 4, 0, 4, false) == NULL);
+	ut_teardown();
+}
+
+static void
+test_io_data_stay_in_the_users_buffers(void)
+{
+	struct spdk_nvme_ns_cmd_ext_io_opts opts = { .size = sizeof(opts) };
+	struct spdk_memory_domain *domain = (struct spdk_memory_domain *)0xD0;
+	char buf0[512], buf1[1024];
+	struct iovec iov[2] = { { buf0, sizeof(buf0) }, { buf1, sizeof(buf1) } };
+	struct spdk_nvme_qpair *qpair;
+	struct nvme_local_conn *conn;
+	struct nvme_local_slot *slot;
+	struct nvme_request req = {};
+	struct ut_done done;
+
+	ut_setup();
+	qpair = ut_qpair_connected(1, 4);
+	conn = g_accepted;
+
+	/* An I/O of two iovecs, from the second byte of the first, with a memory domain. */
+	NVME_INIT_REQUEST_IOV((&req), ut_cb, &done, iov, 2, NULL, sizeof(buf0) + sizeof(buf1) - 1, 0,
+			      1, 0);
+	ut_req(&req, qpair, SPDK_NVME_OPC_WRITE, &done);
+	opts.memory_domain = domain;
+	opts.memory_domain_ctx = (void *)0xC7;
+	req.payload.opts = &opts;
+	CU_ASSERT(nvme_local_qpair_submit_request(qpair, &req) == 0);
+
+	slot = ut_take(conn);
+	SPDK_CU_ASSERT_FATAL(slot != NULL);
+	CU_ASSERT(slot->cmd.opc == SPDK_NVME_OPC_WRITE);
+	CU_ASSERT(slot->cmd.cid == slot->index);
+	CU_ASSERT(req.cmd.cid == slot->index);
+	CU_ASSERT(slot->cmd.psdt == SPDK_NVME_PSDT_SGL_MPTR_CONTIG);
+	CU_ASSERT(slot->cmd.dptr.sgl1.unkeyed.type == SPDK_NVME_SGL_TYPE_TRANSPORT_DATA_BLOCK);
+	CU_ASSERT(slot->cmd.dptr.sgl1.unkeyed.length == sizeof(buf0) + sizeof(buf1) - 1);
+	/* Zero copy: the target is given the user's own buffers. */
+	CU_ASSERT(slot->bounce == NULL);
+	CU_ASSERT(slot->iovcnt == 2);
+	CU_ASSERT(slot->iov[0].iov_base == buf0 + 1);
+	CU_ASSERT(slot->iov[0].iov_len == sizeof(buf0) - 1);
+	CU_ASSERT(slot->iov[1].iov_base == buf1);
+	CU_ASSERT(slot->iov[1].iov_len == sizeof(buf1));
+	CU_ASSERT(slot->memory_domain == domain);
+	CU_ASSERT(slot->memory_domain_ctx == (void *)0xC7);
+
+	/* Nothing completes before the target hands the slot back. */
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 0);
+	CU_ASSERT(done.called == 0);
+	ut_hand_back(conn, slot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 1);
+	CU_ASSERT(done.called == 1);
+	CU_ASSERT(spdk_nvme_cpl_is_success(&done.cpl));
+	CU_ASSERT(done.cpl.cid == req.cmd.cid);
+	CU_ASSERT(nvme_local_qpair(qpair)->in_flight == 0);
+
+	/* The target's reference, then the initiator's. */
+	ut_target_close(conn);
+	ut_qpair_delete(qpair);
+	ut_teardown();
+}
+
+static void
+test_slots_run_out(void)
+{
+	struct nvme_request req[4] = {};
+	struct ut_done done[4];
+	struct spdk_nvme_qpair *qpair;
+	struct nvme_local_slot *slot;
+	int i;
+
+	ut_setup();
+	/* A queue of 4 entries carries 3 commands. */
+	qpair = ut_qpair_connected(1, 4);
+	for (i = 0; i < 4; i++) {
+		NVME_INIT_REQUEST_CONTIG((&req[i]), ut_cb, &done[i], NULL, NULL, 0, 0, 0, 0);
+		ut_req(&req[i], qpair, SPDK_NVME_OPC_FLUSH, &done[i]);
+	}
+	for (i = 0; i < 3; i++) {
+		CU_ASSERT(nvme_local_qpair_submit_request(qpair, &req[i]) == 0);
+	}
+	CU_ASSERT(nvme_local_qpair_submit_request(qpair, &req[3]) == -EAGAIN);
+
+	/* One back: room for one. */
+	slot = ut_take(g_accepted);
+	SPDK_CU_ASSERT_FATAL(slot != NULL);
+	ut_hand_back(g_accepted, slot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 1);
+	CU_ASSERT(nvme_local_qpair_submit_request(qpair, &req[3]) == 0);
+
+	/* The target closes: what it holds and what it never took come back aborted. */
+	ut_target_close(g_accepted);
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == -ENXIO);
+	for (i = 1; i < 4; i++) {
+		CU_ASSERT(done[i].called == 1);
+		CU_ASSERT(spdk_nvme_cpl_is_aborted_sq_deletion(&done[i].cpl));
+	}
+	CU_ASSERT(nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTED);
+	ut_qpair_delete(qpair);
+	ut_teardown();
+}
+
+static void
+test_admin_data_go_through_the_slot(void)
+{
+	uint8_t out[4096], in[64];
+	struct nvme_request get = {}, set = {};
+	struct ut_done get_done, set_done;
+	struct spdk_nvme_qpair *adminq;
+	struct nvme_local_slot *slot;
+
+	ut_setup();
+	adminq = ut_qpair_connected(0, 4);
+
+	/* Controller to host: the target writes into the slot's buffer, copied back. */
+	memset(out, 0, sizeof(out));
+	NVME_INIT_REQUEST_CONTIG((&get), ut_cb, &get_done, out, NULL, sizeof(out), 0, 0, 0);
+	ut_req(&get, adminq, SPDK_NVME_OPC_IDENTIFY, &get_done);
+	CU_ASSERT(nvme_local_qpair_submit_request(adminq, &get) == 0);
+	slot = ut_take(g_accepted);
+	SPDK_CU_ASSERT_FATAL(slot != NULL);
+	SPDK_CU_ASSERT_FATAL(slot->bounce != NULL);
+	CU_ASSERT(slot->iovcnt == 1 && slot->iov[0].iov_base == slot->bounce);
+	CU_ASSERT(slot->iov[0].iov_len == sizeof(out));
+	memset(slot->bounce, 0xA5, sizeof(out));
+	ut_hand_back(g_accepted, slot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	CU_ASSERT(nvme_local_qpair_process_completions(adminq, 0) == 1);
+	CU_ASSERT(get_done.called == 1);
+	CU_ASSERT(out[0] == 0xA5 && out[sizeof(out) - 1] == 0xA5);
+	CU_ASSERT(slot->bounce == NULL);
+
+	/* Host to controller: the slot's buffer holds the user's data when handed over. */
+	memset(in, 0x3C, sizeof(in));
+	NVME_INIT_REQUEST_CONTIG((&set), ut_cb, &set_done, in, NULL, sizeof(in), 0, 0, 0);
+	ut_req(&set, adminq, SPDK_NVME_OPC_SET_FEATURES, &set_done);
+	CU_ASSERT(nvme_local_qpair_submit_request(adminq, &set) == 0);
+	slot = ut_take(g_accepted);
+	SPDK_CU_ASSERT_FATAL(slot != NULL && slot->bounce != NULL);
+	CU_ASSERT(((uint8_t *)slot->bounce)[0] == 0x3C && ((uint8_t *)slot->bounce)[63] == 0x3C);
+	ut_hand_back(g_accepted, slot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	CU_ASSERT(nvme_local_qpair_process_completions(adminq, 0) == 1);
+	CU_ASSERT(set_done.called == 1);
+
+	ut_target_close(g_accepted);
+	ut_qpair_delete(adminq);
+	ut_teardown();
+}
+
+static void
+test_aer_aborted_early_comes_back_to_nobody(void)
+{
+	struct nvme_request aer = {};
+	struct ut_done done;
+	struct spdk_nvme_qpair *adminq;
+	struct nvme_local_slot *slot;
+
+	ut_setup();
+	adminq = ut_qpair_connected(0, 4);
+	NVME_INIT_REQUEST_CONTIG((&aer), ut_cb, &done, NULL, NULL, 0, 0, 0, 0);
+	ut_req(&aer, adminq, SPDK_NVME_OPC_ASYNC_EVENT_REQUEST, &done);
+	CU_ASSERT(nvme_local_qpair_submit_request(adminq, &aer) == 0);
+	slot = ut_take(g_accepted);
+	SPDK_CU_ASSERT_FATAL(slot != NULL);
+
+	/* A reset aborts the AERs: completed at once, while the target still holds the slot. */
+	nvme_local_admin_qpair_abort_aers(adminq);
+	CU_ASSERT(done.called == 1);
+	CU_ASSERT(spdk_nvme_cpl_is_aborted_sq_deletion(&done.cpl));
+	CU_ASSERT(nvme_local_qpair(adminq)->in_flight == 1);
+
+	/* The slot comes back (the target freed the AER): no second completion. */
+	ut_hand_back(g_accepted, slot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_ABORTED_SQ_DELETION);
+	CU_ASSERT(nvme_local_qpair_process_completions(adminq, 0) == 1);
+	CU_ASSERT(done.called == 1);
+	CU_ASSERT(nvme_local_qpair(adminq)->in_flight == 0);
+
+	ut_target_close(g_accepted);
+	ut_qpair_delete(adminq);
+	ut_teardown();
+}
+
+static void
+test_disconnect_waits_for_the_targets_slots(void)
+{
+	char buf[512];
+	struct nvme_request write = {}, flush = {};
+	struct ut_done write_done, flush_done;
+	struct spdk_nvme_qpair *qpair;
+	struct nvme_local_conn *conn;
+	struct nvme_local_slot *wslot, *fslot;
+
+	ut_setup();
+	qpair = ut_qpair_connected(1, 4);
+	conn = g_accepted;
+	NVME_INIT_REQUEST_CONTIG((&write), ut_cb, &write_done, buf, NULL, sizeof(buf), 0, 0, 0);
+	ut_req(&write, qpair, SPDK_NVME_OPC_WRITE, &write_done);
+	NVME_INIT_REQUEST_CONTIG((&flush), ut_cb, &flush_done, NULL, NULL, 0, 0, 0, 0);
+	ut_req(&flush, qpair, SPDK_NVME_OPC_FLUSH, &flush_done);
+	CU_ASSERT(nvme_local_qpair_submit_request(qpair, &write) == 0);
+	CU_ASSERT(nvme_local_qpair_submit_request(qpair, &flush) == 0);
+	wslot = ut_take(conn);
+	fslot = ut_take(conn);
+	SPDK_CU_ASSERT_FATAL(wslot != NULL && fslot != NULL);
+
+	/* An abort completes only what holds none of the user's memory: the flush. */
+	nvme_local_qpair_abort_reqs(qpair, 0);
+	CU_ASSERT(flush_done.called == 1);
+	CU_ASSERT(write_done.called == 0);
+
+	/* Disconnecting: the target is told, and the qpair waits for the write it holds. */
+	ut_ctrlr_disconnect_qpair(qpair);
+	CU_ASSERT(__atomic_load_n(&conn->initiator_leaving, __ATOMIC_ACQUIRE));
+	CU_ASSERT(nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTING);
+	CU_ASSERT(nvme_local_qpair_submit_request(qpair, &write) == -ENXIO);
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 0);
+	CU_ASSERT(nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTING);
+
+	/* The write comes back with its own outcome; the flush, to nobody; then the qpair is out. */
+	ut_hand_back(conn, wslot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	ut_hand_back(conn, fslot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	CU_ASSERT(nvme_local_qpair_process_completions(qpair, 0) == 2);
+	CU_ASSERT(write_done.called == 1 && spdk_nvme_cpl_is_success(&write_done.cpl));
+	CU_ASSERT(flush_done.called == 1);
+	CU_ASSERT(nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTED);
+	CU_ASSERT(nvme_local_qpair(qpair)->conn == NULL);
+	/* Only the target's reference is left. */
+	CU_ASSERT(conn->refs == 1);
+
+	ut_target_close(conn);
+	ut_qpair_delete(qpair);
+	ut_teardown();
+}
+
+static void
+test_admin_qpair_deleted_with_a_command_in_flight(void)
+{
+	uint8_t out[4096];
+	struct nvme_request get = {};
+	struct ut_done done;
+	struct spdk_nvme_qpair *adminq;
+	struct nvme_local_conn *conn;
+	struct nvme_local_slot *slot;
+
+	ut_setup();
+	adminq = ut_qpair_connected(0, 4);
+	conn = g_accepted;
+	NVME_INIT_REQUEST_CONTIG((&get), ut_cb, &done, out, NULL, sizeof(out), 0, 0, 0);
+	ut_req(&get, adminq, SPDK_NVME_OPC_GET_LOG_PAGE, &done);
+	CU_ASSERT(nvme_local_qpair_submit_request(adminq, &get) == 0);
+	slot = ut_take(conn);
+	SPDK_CU_ASSERT_FATAL(slot != NULL);
+
+	/* A controller destroyed with an admin command in flight (its destruction does not wait):
+	 * the command is aborted at once, as the target writes into the slot's buffer only. */
+	ut_qpair_delete(adminq);
+	CU_ASSERT(done.called == 1);
+	CU_ASSERT(spdk_nvme_cpl_is_aborted_sq_deletion(&done.cpl));
+	CU_ASSERT(conn->initiator_leaving);
+	CU_ASSERT(conn->refs == 1);
+
+	/* The target finishes later, into the connection's memory, and lets go: freed. */
+	memset(slot->bounce, 0xEE, sizeof(out));
+	ut_hand_back(conn, slot, SPDK_NVME_SCT_GENERIC, SPDK_NVME_SC_SUCCESS);
+	ut_target_close(conn);
+	ut_teardown();
+}
+
+int
+main(int argc, char **argv)
+{
+	CU_pSuite suite = NULL;
+	unsigned int num_failures;
+
+	CU_initialize_registry();
+
+	suite = CU_add_suite("nvme_local", NULL, NULL);
+	CU_ADD_TEST(suite, test_listen_and_refuse);
+	CU_ADD_TEST(suite, test_qpairs_are_async_only);
+	CU_ADD_TEST(suite, test_io_data_stay_in_the_users_buffers);
+	CU_ADD_TEST(suite, test_slots_run_out);
+	CU_ADD_TEST(suite, test_admin_data_go_through_the_slot);
+	CU_ADD_TEST(suite, test_aer_aborted_early_comes_back_to_nobody);
+	CU_ADD_TEST(suite, test_disconnect_waits_for_the_targets_slots);
+	CU_ADD_TEST(suite, test_admin_qpair_deleted_with_a_command_in_flight);
+
+	num_failures = spdk_ut_run_tests(argc, argv, NULL);
+	CU_cleanup_registry();
+	return num_failures;
+}

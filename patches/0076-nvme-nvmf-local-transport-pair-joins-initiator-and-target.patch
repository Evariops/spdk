diff --git a/include/spdk_internal/nvme_local.h b/include/spdk_internal/nvme_local.h
new file mode 100644
index 0000000..0c65266
--- /dev/null
+++ b/include/spdk_internal/nvme_local.h
@@ -0,0 +1,173 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (c) 2026 Evariops.
+ */
+
+/** \file
+ * The LOCAL transport pair (Evariops 0076).
+ *
+ * An NVMe initiator qpair (lib/nvme/nvme_local.c) and an NVMe-oF target qpair (lib/nvmf/local.c)
+ * of the same process share a connection. A command is a slot handed over a ring; its data stay in
+ * the initiator's buffers; the target hands the slot back on a second ring with its completion.
+ * The target side is an ordinary NVMe-oF controller: the subsystem's hosts, its reservations, its
+ * pause and its list of controllers apply to it as to a controller reached over a network.
+ *
+ * Ownership. A slot belongs to the side that last took it. The initiator writes the command and
+ * the description of the data, then hands the slot over; from then on only the target touches
+ * the slot and the data, until it hands the slot back. Every slot handed over comes back once:
+ * completed, or aborted when the target frees its request without completing it. The exception
+ * is a target that closes: once it has set target_closed it touches no slot again, and the
+ * initiator takes back every slot still out (those the target never took).
+ *
+ * The connection has two references, one per side; the side that drops the last frees it.
+ */
+
+#ifndef SPDK_INTERNAL_NVME_LOCAL_H
+#define SPDK_INTERNAL_NVME_LOCAL_H
+
+#include "spdk/stdinc.h"
+#include "spdk/nvme.h"
+#include "spdk/util.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define NVME_LOCAL_TRSTRING	"LOCAL"
+
+/* Fewer than the iovecs of an spdk_nvmf_request (NVMF_REQ_MAX_BUFFERS). */
+#define NVME_LOCAL_MAX_SGES	32
+
+/*
+ * A single-producer single-consumer ring of pointers, in ordinary memory: no DPDK memzone per
+ * connection. The counters run free; the producer owns tail, the consumer owns head. A side may
+ * change thread between calls only under a lock (the admin queue's), which orders the accesses.
+ */
+struct nvme_local_ring {
+	void		**entries;
+	uint32_t	mask;
+	uint32_t	tail;
+	uint8_t		pad[SPDK_CACHE_LINE_SIZE - sizeof(uint32_t)];
+	uint32_t	head;
+};
+
+static inline int
+nvme_local_ring_init(struct nvme_local_ring *ring, uint32_t count)
+{
+	uint32_t size = spdk_align32pow2(spdk_max(count, 1u));
+
+	ring->entries = calloc(size, sizeof(*ring->entries));
+	if (ring->entries == NULL) {
+		return -ENOMEM;
+	}
+
+	ring->mask = size - 1;
+	ring->tail = 0;
+	ring->head = 0;
+	return 0;
+}
+
+static inline void
+nvme_local_ring_fini(struct nvme_local_ring *ring)
+{
+	free(ring->entries);
+	ring->entries = NULL;
+}
+
+static inline bool
+nvme_local_ring_put(struct nvme_local_ring *ring, void *obj)
+{
+	uint32_t tail = __atomic_load_n(&ring->tail, __ATOMIC_RELAXED);
+	uint32_t head = __atomic_load_n(&ring->head, __ATOMIC_ACQUIRE);
+
+	if (spdk_unlikely(tail - head > ring->mask)) {
+		return false;
+	}
+
+	ring->entries[tail & ring->mask] = obj;
+	/* Publishes the entry and everything written to the object before it. */
+	__atomic_store_n(&ring->tail, tail + 1, __ATOMIC_RELEASE);
+	return true;
+}
+
+static inline uint32_t
+nvme_local_ring_take(struct nvme_local_ring *ring, void **objs, uint32_t max)
+{
+	uint32_t head = __atomic_load_n(&ring->head, __ATOMIC_RELAXED);
+	uint32_t tail = __atomic_load_n(&ring->tail, __ATOMIC_ACQUIRE);
+	uint32_t i, n = spdk_min(tail - head, max);
+
+	for (i = 0; i < n; i++) {
+		objs[i] = ring->entries[(head + i) & ring->mask];
+	}
+
+	/* Gives the entries back to the producer. */
+	__atomic_store_n(&ring->head, head + n, __ATOMIC_RELEASE);
+	return n;
+}
+
+struct nvme_local_slot {
+	/* Written by the initiator before the handover. */
+	struct spdk_nvme_cmd		cmd;
+	/* Written by the target before the handback. */
+	struct spdk_nvme_cpl		cpl;
+	uint16_t			index;
+	uint16_t			iovcnt;
+	uint32_t			length;
+	struct spdk_memory_domain	*memory_domain;
+	void				*memory_domain_ctx;
+	/*
+	 * Admin queue only: the data go through this buffer, which the connection owns. An
+	 * initiator that leaves while the target still holds the slot (a controller destroyed with
+	 * an admin command in flight) never leaves the target writing into memory it freed.
+	 */
+	void				*bounce;
+	struct iovec			iov[NVME_LOCAL_MAX_SGES];
+};
+
+struct nvme_local_conn {
+	/* Slots the initiator hands over; the target takes them. */
+	struct nvme_local_ring		sq;
+	/* Slots the target hands back; the initiator takes them. */
+	struct nvme_local_ring		cq;
+	struct nvme_local_slot		*slots;
+	uint16_t			num_slots;
+	uint16_t			qid;
+	/* The listener's own transport ID: the address the target's qpair reports. */
+	struct spdk_nvme_transport_id	trid;
+	/* The initiator asks the target to disconnect its qpair (set once, release). */
+	bool				initiator_leaving;
+	/* The target touches no slot again (set once, release). */
+	bool				target_closed;
+	uint32_t			refs;
+};
+
+static inline void
+nvme_local_conn_get(struct nvme_local_conn *conn)
+{
+	__atomic_add_fetch(&conn->refs, 1, __ATOMIC_RELAXED);
+}
+
+/* Drops one reference; the last frees the connection, its rings, its slots and their buffers. */
+void spdk_nvme_local_conn_put(struct nvme_local_conn *conn);
+
+/*
+ * Called with the registry's lock held, on the connecting initiator's thread: takes its own
+ * reference on success, must not block, and must not call into the registry.
+ */
+typedef int (*spdk_nvme_local_accept_cb)(void *ctx, struct nvme_local_conn *conn);
+
+/*
+ * Listens on trid (its traddr and trsvcid): an initiator whose controller names that address
+ * connects through accept. -EADDRINUSE if the address is already listened on.
+ */
+int spdk_nvme_local_listen(const struct spdk_nvme_transport_id *trid,
+			   spdk_nvme_local_accept_cb accept, void *ctx);
+
+/* Once it returns, accept is not running and is not called again for trid. */
+void spdk_nvme_local_stop_listen(const struct spdk_nvme_transport_id *trid);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SPDK_INTERNAL_NVME_LOCAL_H */

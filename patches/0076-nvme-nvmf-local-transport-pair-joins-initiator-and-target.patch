diff --git a/lib/nvmf/local.c b/lib/nvmf/local.c
new file mode 100644
index 0000000..69847ca
--- /dev/null
+++ b/lib/nvmf/local.c
@@ -0,0 +1,498 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (c) 2026 Evariops.
+ */
+
+/*
+ * The LOCAL NVMe-oF transport (Evariops 0076): the target side of the in-memory pair. An initiator
+ * of the same process (lib/nvme/nvme_local.c) connects to a listener of this transport; each
+ * connection becomes an ordinary qpair of an nvmf poll group, and each of its commands an ordinary
+ * nvmf request whose data are the initiator's buffers. spdk_internal/nvme_local.h describes the
+ * connection.
+ */
+
+#include "spdk/stdinc.h"
+
+#include "spdk/log.h"
+#include "spdk/nvmf_transport.h"
+#include "spdk/string.h"
+#include "spdk/thread.h"
+#include "spdk/util.h"
+#include "spdk_internal/nvme_local.h"
+
+#define NVMF_LOCAL_DEFAULT_MAX_QUEUE_DEPTH		128
+#define NVMF_LOCAL_DEFAULT_MAX_QPAIRS_PER_CTRLR		128
+#define NVMF_LOCAL_DEFAULT_MAX_IO_SIZE			131072
+#define NVMF_LOCAL_DEFAULT_MAX_ADMIN_QUEUE_DEPTH	128
+#define NVMF_LOCAL_DEFAULT_ABORT_TIMEOUT_SEC		1
+#define NVMF_LOCAL_POLL_BATCH				32
+
+SPDK_STATIC_ASSERT(NVME_LOCAL_MAX_SGES <= NVMF_REQ_MAX_BUFFERS, "a slot's iovecs fit a request's");
+SPDK_STATIC_ASSERT(sizeof(union nvmf_h2c_msg) == sizeof(struct spdk_nvme_cmd), "a slot's command");
+SPDK_STATIC_ASSERT(sizeof(union nvmf_c2h_msg) == sizeof(struct spdk_nvme_cpl), "a slot's completion");
+
+struct nvmf_local_req {
+	struct spdk_nvmf_request	req;
+	struct nvme_local_slot		*slot;
+};
+
+struct nvmf_local_qpair {
+	struct spdk_nvmf_qpair		qpair;
+	struct nvme_local_conn		*conn;
+	/* One request per slot of conn, by slot index. */
+	struct nvmf_local_req		*reqs;
+	/* The listener's address, kept past the connection for the qpair's last reports. */
+	struct spdk_nvme_transport_id	trid;
+	/* The qpair asked nvmf to disconnect it: its initiator leaves. */
+	bool				disconnecting;
+	/* qpair_fini ran: the qpair touches no slot again, and a message frees it. */
+	bool				closed;
+	TAILQ_ENTRY(nvmf_local_qpair)	link;
+};
+
+struct nvmf_local_poll_group {
+	struct spdk_nvmf_transport_poll_group	group;
+	TAILQ_HEAD(, nvmf_local_qpair)		qpairs;
+};
+
+struct nvmf_local_transport {
+	struct spdk_nvmf_transport	transport;
+	struct spdk_poller		*accept_poller;
+	/* Connections accepted on an initiator's thread, given to the target by the poller. */
+	pthread_mutex_t			lock;
+	TAILQ_HEAD(, nvmf_local_qpair)	pending;
+};
+
+static void nvmf_local_hand_back(struct spdk_nvmf_request *req);
+
+static inline struct nvmf_local_transport *
+nvmf_local_transport(struct spdk_nvmf_transport *transport)
+{
+	return SPDK_CONTAINEROF(transport, struct nvmf_local_transport, transport);
+}
+
+static inline struct nvmf_local_qpair *
+nvmf_local_qpair(struct spdk_nvmf_qpair *qpair)
+{
+	return SPDK_CONTAINEROF(qpair, struct nvmf_local_qpair, qpair);
+}
+
+static inline struct nvmf_local_poll_group *
+nvmf_local_poll_group(struct spdk_nvmf_transport_poll_group *group)
+{
+	return SPDK_CONTAINEROF(group, struct nvmf_local_poll_group, group);
+}
+
+/* The target lets go of the connection: no slot of it is touched again. */
+static void
+nvmf_local_conn_close(struct nvmf_local_qpair *lqpair)
+{
+	struct nvme_local_conn *conn = lqpair->conn;
+
+	lqpair->closed = true;
+	lqpair->conn = NULL;
+	__atomic_store_n(&conn->target_closed, true, __ATOMIC_RELEASE);
+	spdk_nvme_local_conn_put(conn);
+}
+
+static void
+nvmf_local_qpair_free(void *ctx)
+{
+	struct nvmf_local_qpair *lqpair = ctx;
+
+	free(lqpair->reqs);
+	free(lqpair);
+}
+
+/* ── Accepting ── */
+
+/* On the connecting initiator's thread, with the registry's lock held. */
+static int
+nvmf_local_accept_conn(void *ctx, struct nvme_local_conn *conn)
+{
+	struct nvmf_local_transport *ltransport = ctx;
+	struct nvmf_local_qpair *lqpair;
+	struct nvmf_local_req *lreq;
+	uint16_t i;
+
+	lqpair = calloc(1, sizeof(*lqpair));
+	if (lqpair == NULL) {
+		return -ENOMEM;
+	}
+
+	lqpair->reqs = calloc(conn->num_slots, sizeof(*lqpair->reqs));
+	if (lqpair->reqs == NULL) {
+		free(lqpair);
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < conn->num_slots; i++) {
+		lreq = &lqpair->reqs[i];
+		lreq->slot = &conn->slots[i];
+		lreq->req.qpair = &lqpair->qpair;
+		lreq->req.cmd = (union nvmf_h2c_msg *)&conn->slots[i].cmd;
+		lreq->req.rsp = (union nvmf_c2h_msg *)&conn->slots[i].cpl;
+	}
+
+	lqpair->qpair.transport = &ltransport->transport;
+	lqpair->trid = conn->trid;
+	nvme_local_conn_get(conn);
+	lqpair->conn = conn;
+
+	pthread_mutex_lock(&ltransport->lock);
+	TAILQ_INSERT_TAIL(&ltransport->pending, lqpair, link);
+	pthread_mutex_unlock(&ltransport->lock);
+	return 0;
+}
+
+/* spdk_nvmf_tgt_new_qpair() wants the transport's thread. */
+static int
+nvmf_local_accept(void *ctx)
+{
+	struct nvmf_local_transport *ltransport = ctx;
+	TAILQ_HEAD(, nvmf_local_qpair) accepted = TAILQ_HEAD_INITIALIZER(accepted);
+	struct nvmf_local_qpair *lqpair;
+
+	pthread_mutex_lock(&ltransport->lock);
+	TAILQ_CONCAT(&accepted, &ltransport->pending, link);
+	pthread_mutex_unlock(&ltransport->lock);
+
+	if (TAILQ_EMPTY(&accepted)) {
+		return SPDK_POLLER_IDLE;
+	}
+
+	while ((lqpair = TAILQ_FIRST(&accepted)) != NULL) {
+		TAILQ_REMOVE(&accepted, lqpair, link);
+		spdk_nvmf_tgt_new_qpair(ltransport->transport.tgt, &lqpair->qpair);
+	}
+
+	return SPDK_POLLER_BUSY;
+}
+
+/* ── The transport ── */
+
+static void
+nvmf_local_opts_init(struct spdk_nvmf_transport_opts *opts)
+{
+	opts->max_queue_depth = NVMF_LOCAL_DEFAULT_MAX_QUEUE_DEPTH;
+	opts->max_qpairs_per_ctrlr = NVMF_LOCAL_DEFAULT_MAX_QPAIRS_PER_CTRLR;
+	/* No capsule carries data: they stay in the initiator's buffers. */
+	opts->in_capsule_data_size = 0;
+	opts->max_io_size = NVMF_LOCAL_DEFAULT_MAX_IO_SIZE;
+	opts->max_aq_depth = NVMF_LOCAL_DEFAULT_MAX_ADMIN_QUEUE_DEPTH;
+	/* No buffer of its own: no iobuf cache per poll group. */
+	opts->iobuf_small_cache_size = 0;
+	opts->iobuf_large_cache_size = 0;
+	opts->dif_insert_or_strip = false;
+	opts->abort_timeout_sec = NVMF_LOCAL_DEFAULT_ABORT_TIMEOUT_SEC;
+	opts->transport_specific = NULL;
+}
+
+static struct spdk_nvmf_transport *
+nvmf_local_create(struct spdk_nvmf_transport_opts *opts)
+{
+	struct nvmf_local_transport *ltransport;
+
+	ltransport = calloc(1, sizeof(*ltransport));
+	if (ltransport == NULL) {
+		return NULL;
+	}
+
+	pthread_mutex_init(&ltransport->lock, NULL);
+	TAILQ_INIT(&ltransport->pending);
+	ltransport->accept_poller = SPDK_POLLER_REGISTER(nvmf_local_accept, ltransport,
+				    opts->acceptor_poll_rate);
+	if (ltransport->accept_poller == NULL) {
+		pthread_mutex_destroy(&ltransport->lock);
+		free(ltransport);
+		return NULL;
+	}
+
+	SPDK_NOTICELOG("*** LOCAL Transport Init ***\n");
+	return &ltransport->transport;
+}
+
+static void
+nvmf_local_destroy(struct spdk_nvmf_transport *transport,
+		   spdk_nvmf_transport_destroy_done_cb cb_fn, void *cb_arg)
+{
+	struct nvmf_local_transport *ltransport = nvmf_local_transport(transport);
+	struct nvmf_local_qpair *lqpair;
+
+	/* The listeners are stopped already (spdk_nvmf_transport_destroy): nothing is accepted
+	 * anymore, and what was never given to the target is closed here. */
+	spdk_poller_unregister(&ltransport->accept_poller);
+	while ((lqpair = TAILQ_FIRST(&ltransport->pending)) != NULL) {
+		TAILQ_REMOVE(&ltransport->pending, lqpair, link);
+		nvmf_local_conn_close(lqpair);
+		nvmf_local_qpair_free(lqpair);
+	}
+
+	pthread_mutex_destroy(&ltransport->lock);
+	free(ltransport);
+	if (cb_fn != NULL) {
+		cb_fn(cb_arg);
+	}
+}
+
+static int
+nvmf_local_listen(struct spdk_nvmf_transport *transport, const struct spdk_nvme_transport_id *trid,
+		  struct spdk_nvmf_listen_opts *listen_opts)
+{
+	int rc;
+
+	rc = spdk_nvme_local_listen(trid, nvmf_local_accept_conn, nvmf_local_transport(transport));
+	if (rc != 0) {
+		SPDK_ERRLOG("LOCAL listen on %s:%s failed: %s\n", trid->traddr, trid->trsvcid,
+			    spdk_strerror(-rc));
+		return rc;
+	}
+
+	SPDK_NOTICELOG("*** NVMe/LOCAL Target Listening on %s port %s ***\n", trid->traddr,
+		       trid->trsvcid);
+	return 0;
+}
+
+static void
+nvmf_local_stop_listen(struct spdk_nvmf_transport *transport,
+		       const struct spdk_nvme_transport_id *trid)
+{
+	spdk_nvme_local_stop_listen(trid);
+}
+
+static void
+nvmf_local_listener_discover(struct spdk_nvmf_transport *transport,
+			     struct spdk_nvme_transport_id *trid,
+			     struct spdk_nvmf_discovery_log_page_entry *entry)
+{
+	/* The specification's loopback transport: only a host of the same process reaches it. */
+	entry->trtype = SPDK_NVMF_TRTYPE_INTRA_HOST;
+	entry->adrfam = SPDK_NVMF_ADRFAM_INTRA_HOST;
+	entry->treq.secure_channel = SPDK_NVMF_TREQ_SECURE_CHANNEL_NOT_SPECIFIED;
+	spdk_strcpy_pad(entry->trsvcid, trid->trsvcid, sizeof(entry->trsvcid), ' ');
+	spdk_strcpy_pad(entry->traddr, trid->traddr, sizeof(entry->traddr), ' ');
+}
+
+/* ── The poll group ── */
+
+static struct spdk_nvmf_transport_poll_group *
+nvmf_local_poll_group_create(struct spdk_nvmf_transport *transport,
+			     struct spdk_nvmf_poll_group *group)
+{
+	struct nvmf_local_poll_group *lgroup;
+
+	lgroup = calloc(1, sizeof(*lgroup));
+	if (lgroup == NULL) {
+		return NULL;
+	}
+
+	TAILQ_INIT(&lgroup->qpairs);
+	return &lgroup->group;
+}
+
+static void
+nvmf_local_poll_group_destroy(struct spdk_nvmf_transport_poll_group *group)
+{
+	struct nvmf_local_poll_group *lgroup = nvmf_local_poll_group(group);
+
+	assert(TAILQ_EMPTY(&lgroup->qpairs));
+	free(lgroup);
+}
+
+static int
+nvmf_local_poll_group_add(struct spdk_nvmf_transport_poll_group *group,
+			  struct spdk_nvmf_qpair *qpair)
+{
+	TAILQ_INSERT_TAIL(&nvmf_local_poll_group(group)->qpairs, nvmf_local_qpair(qpair), link);
+	return 0;
+}
+
+static int
+nvmf_local_poll_group_remove(struct spdk_nvmf_transport_poll_group *group,
+			     struct spdk_nvmf_qpair *qpair)
+{
+	TAILQ_REMOVE(&nvmf_local_poll_group(group)->qpairs, nvmf_local_qpair(qpair), link);
+	return 0;
+}
+
+static void
+nvmf_local_req_exec(struct nvmf_local_qpair *lqpair, struct nvme_local_slot *slot)
+{
+	struct spdk_nvmf_request *req = &lqpair->reqs[slot->index].req;
+
+	memset(&slot->cpl, 0, sizeof(slot->cpl));
+	lqpair->qpair.queue_depth++;
+
+	/* As TCP refuses an SGL longer than the MDTS it announced. */
+	if (spdk_unlikely(slot->length > lqpair->qpair.transport->opts.max_io_size)) {
+		slot->cpl.cid = slot->cmd.cid;
+		slot->cpl.status.sct = SPDK_NVME_SCT_GENERIC;
+		slot->cpl.status.sc = SPDK_NVME_SC_DATA_SGL_LENGTH_INVALID;
+		slot->cpl.status.dnr = 1;
+		nvmf_local_hand_back(req);
+		return;
+	}
+
+	req->raw = 0;
+	req->zcopy_phase = NVMF_ZCOPY_PHASE_NONE;
+	req->cmd_cb_fn = NULL;
+	req->accel_sequence = NULL;
+	req->length = slot->length;
+	req->iovcnt = slot->iovcnt;
+	memcpy(req->iov, slot->iov, slot->iovcnt * sizeof(*slot->iov));
+	req->memory_domain = slot->memory_domain;
+	req->memory_domain_ctx = slot->memory_domain_ctx;
+	req->xfer = spdk_nvmf_req_get_xfer(req);
+
+	spdk_nvmf_request_exec(req);
+}
+
+static int
+nvmf_local_qpair_poll(struct nvmf_local_qpair *lqpair)
+{
+	struct nvme_local_conn *conn = lqpair->conn;
+	void *batch[NVMF_LOCAL_POLL_BATCH];
+	uint32_t i, n;
+
+	/* Finished while the group's poll held it as the next one. */
+	if (spdk_unlikely(lqpair->closed)) {
+		return 0;
+	}
+
+	if (spdk_unlikely(__atomic_load_n(&conn->initiator_leaving, __ATOMIC_ACQUIRE))) {
+		/* nvmf completes what it holds, frees its AERs (handed back as aborted), then
+		 * finishes the qpair. What the initiator handed over since stays in the ring: the
+		 * initiator takes it back once the qpair is closed. */
+		if (!lqpair->disconnecting) {
+			lqpair->disconnecting = true;
+			spdk_nvmf_qpair_disconnect(&lqpair->qpair);
+		}
+		return 0;
+	}
+
+	if (spdk_unlikely(!spdk_nvmf_qpair_is_active(&lqpair->qpair))) {
+		return 0;
+	}
+
+	n = nvme_local_ring_take(&conn->sq, batch, NVMF_LOCAL_POLL_BATCH);
+	for (i = 0; i < n; i++) {
+		/* A request completed in place may finish the qpair: the rest of the batch is the
+		 * initiator's again. */
+		if (spdk_unlikely(lqpair->closed)) {
+			break;
+		}
+		nvmf_local_req_exec(lqpair, batch[i]);
+	}
+
+	return n;
+}
+
+static int
+nvmf_local_poll_group_poll(struct spdk_nvmf_transport_poll_group *group)
+{
+	struct nvmf_local_poll_group *lgroup = nvmf_local_poll_group(group);
+	struct nvmf_local_qpair *lqpair, *tmp;
+	int count = 0;
+
+	TAILQ_FOREACH_SAFE(lqpair, &lgroup->qpairs, link, tmp) {
+		count += nvmf_local_qpair_poll(lqpair);
+	}
+
+	return count;
+}
+
+/* ── Requests ── */
+
+static void
+nvmf_local_hand_back(struct spdk_nvmf_request *req)
+{
+	struct nvmf_local_req *lreq = SPDK_CONTAINEROF(req, struct nvmf_local_req, req);
+	struct nvmf_local_qpair *lqpair = nvmf_local_qpair(req->qpair);
+
+	assert(lqpair->conn != NULL);
+	lqpair->qpair.queue_depth--;
+	if (spdk_unlikely(!nvme_local_ring_put(&lqpair->conn->cq, lreq->slot))) {
+		/* A place per slot: never full. */
+		assert(false);
+	}
+}
+
+static void
+nvmf_local_req_complete(struct spdk_nvmf_request *req)
+{
+	nvmf_local_hand_back(req);
+}
+
+/* nvmf frees a request without completing it on a qpair it takes down (its AERs, the requests a
+ * paused subsystem queued): the slot goes back as aborted, so that every slot comes back. */
+static void
+nvmf_local_req_free(struct spdk_nvmf_request *req)
+{
+	struct spdk_nvme_cpl *cpl = &req->rsp->nvme_cpl;
+
+	memset(cpl, 0, sizeof(*cpl));
+	cpl->cid = req->cmd->nvme_cmd.cid;
+	cpl->sqid = req->qpair->qid;
+	cpl->status.sct = SPDK_NVME_SCT_GENERIC;
+	cpl->status.sc = SPDK_NVME_SC_ABORTED_SQ_DELETION;
+	nvmf_local_hand_back(req);
+}
+
+static void
+nvmf_local_qpair_fini(struct spdk_nvmf_qpair *qpair, spdk_nvmf_transport_qpair_fini_cb cb_fn,
+		      void *cb_arg)
+{
+	struct nvmf_local_qpair *lqpair = nvmf_local_qpair(qpair);
+
+	if (lqpair->conn != NULL) {
+		nvmf_local_conn_close(lqpair);
+	}
+
+	/* Freed once the poll that may hold it in its batch has returned. */
+	spdk_thread_send_msg(spdk_get_thread(), nvmf_local_qpair_free, lqpair);
+	if (cb_fn != NULL) {
+		cb_fn(cb_arg);
+	}
+}
+
+static int
+nvmf_local_qpair_get_trid(struct spdk_nvmf_qpair *qpair, struct spdk_nvme_transport_id *trid)
+{
+	*trid = nvmf_local_qpair(qpair)->trid;
+	return 0;
+}
+
+/* The transport holds no request of its own: each runs as it arrives. */
+static void
+nvmf_local_qpair_abort_request(struct spdk_nvmf_qpair *qpair, struct spdk_nvmf_request *req)
+{
+	spdk_nvmf_request_complete(req);
+}
+
+const struct spdk_nvmf_transport_ops spdk_nvmf_transport_local = {
+	.name = NVME_LOCAL_TRSTRING,
+	.type = SPDK_NVME_TRANSPORT_CUSTOM_FABRICS,
+	.opts_init = nvmf_local_opts_init,
+	.create = nvmf_local_create,
+	.destroy = nvmf_local_destroy,
+
+	.listen = nvmf_local_listen,
+	.stop_listen = nvmf_local_stop_listen,
+	.listener_discover = nvmf_local_listener_discover,
+
+	.poll_group_create = nvmf_local_poll_group_create,
+	.poll_group_destroy = nvmf_local_poll_group_destroy,
+	.poll_group_add = nvmf_local_poll_group_add,
+	.poll_group_remove = nvmf_local_poll_group_remove,
+	.poll_group_poll = nvmf_local_poll_group_poll,
+
+	.req_free = nvmf_local_req_free,
+	.req_complete = nvmf_local_req_complete,
+
+	.qpair_fini = nvmf_local_qpair_fini,
+	.qpair_get_peer_trid = nvmf_local_qpair_get_trid,
+	.qpair_get_local_trid = nvmf_local_qpair_get_trid,
+	.qpair_get_listen_trid = nvmf_local_qpair_get_trid,
+	.qpair_abort_request = nvmf_local_qpair_abort_request,
+};
+
+SPDK_NVMF_TRANSPORT_REGISTER(local, &spdk_nvmf_transport_local);

diff --git a/test/unit/lib/nvmf/local.c/local_ut.c b/test/unit/lib/nvmf/local.c/local_ut.c
new file mode 100644
index 0000000..816c237
--- /dev/null
+++ b/test/unit/lib/nvmf/local.c/local_ut.c
@@ -0,0 +1,478 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (c) 2026 Evariops.
+ */
+
+/*
+ * The LOCAL target (Evariops 0076) against an initiator the test plays itself: it fills slots,
+ * hands them over, and reads what comes back, through the shared connection. nvmf's own request
+ * handling is stubbed: what is checked is what the transport gives nvmf and gives back.
+ */
+
+#include "spdk/stdinc.h"
+#include "spdk_internal/cunit.h"
+
+#include "common/lib/test_env.c"
+
+#include "nvmf/local.c"
+
+SPDK_LOG_REGISTER_COMPONENT(nvmf)
+
+DEFINE_STUB_V(spdk_nvmf_transport_register, (const struct spdk_nvmf_transport_ops *ops));
+
+/* ── The registry and the connection, which lib/nvme holds ── */
+
+static struct spdk_nvme_transport_id g_listened;
+static spdk_nvme_local_accept_cb g_accept;
+static void *g_accept_ctx;
+
+int
+spdk_nvme_local_listen(const struct spdk_nvme_transport_id *trid,
+		       spdk_nvme_local_accept_cb accept, void *ctx)
+{
+	g_listened = *trid;
+	g_accept = accept;
+	g_accept_ctx = ctx;
+	return 0;
+}
+
+void
+spdk_nvme_local_stop_listen(const struct spdk_nvme_transport_id *trid)
+{
+	g_accept = NULL;
+}
+
+static int g_conns;
+
+void
+spdk_nvme_local_conn_put(struct nvme_local_conn *conn)
+{
+	if (__atomic_sub_fetch(&conn->refs, 1, __ATOMIC_ACQ_REL) != 0) {
+		return;
+	}
+
+	nvme_local_ring_fini(&conn->sq);
+	nvme_local_ring_fini(&conn->cq);
+	free(conn->slots);
+	free(conn);
+	g_conns--;
+}
+
+/* As the initiator creates one: its reference, the slots, the two rings. */
+static struct nvme_local_conn *
+ut_conn(uint16_t num_slots)
+{
+	struct nvme_local_conn *conn = calloc(1, sizeof(*conn));
+	uint16_t i;
+
+	SPDK_CU_ASSERT_FATAL(conn != NULL);
+	conn->slots = calloc(num_slots, sizeof(*conn->slots));
+	SPDK_CU_ASSERT_FATAL(conn->slots != NULL);
+	CU_ASSERT(nvme_local_ring_init(&conn->sq, num_slots) == 0);
+	CU_ASSERT(nvme_local_ring_init(&conn->cq, num_slots) == 0);
+	for (i = 0; i < num_slots; i++) {
+		conn->slots[i].index = i;
+	}
+	conn->num_slots = num_slots;
+	conn->qid = 1;
+	conn->refs = 1;
+	snprintf(conn->trid.traddr, sizeof(conn->trid.traddr), "node0");
+	g_conns++;
+	return conn;
+}
+
+/* ── nvmf, stubbed ── */
+
+static struct spdk_nvmf_qpair *g_new_qpair;
+static int g_disconnects;
+static struct spdk_nvmf_request *g_exec[8];
+static int g_execs;
+static bool g_fini_on_exec;
+static struct nvmf_local_poll_group *g_lgroup;
+
+void
+spdk_nvmf_tgt_new_qpair(struct spdk_nvmf_tgt *tgt, struct spdk_nvmf_qpair *qpair)
+{
+	g_new_qpair = qpair;
+}
+
+int
+spdk_nvmf_qpair_disconnect(struct spdk_nvmf_qpair *qpair)
+{
+	g_disconnects++;
+	return 0;
+}
+
+static void
+ut_fini_done(void *arg)
+{
+	(*(int *)arg)++;
+}
+
+static int g_fini_done;
+
+void
+spdk_nvmf_request_exec(struct spdk_nvmf_request *req)
+{
+	SPDK_CU_ASSERT_FATAL(g_execs < (int)SPDK_COUNTOF(g_exec));
+	g_exec[g_execs++] = req;
+	if (g_fini_on_exec) {
+		/* nvmf finishing the qpair from within a request, as a completion in place may. */
+		nvmf_local_poll_group_remove(&g_lgroup->group, req->qpair);
+		nvmf_local_qpair_fini(req->qpair, ut_fini_done, &g_fini_done);
+	}
+}
+
+int
+spdk_nvmf_request_complete(struct spdk_nvmf_request *req)
+{
+	nvmf_local_req_complete(req);
+	return 0;
+}
+
+/* ── Helpers ── */
+
+static struct spdk_thread *g_thread;
+static struct nvmf_local_transport *g_ltransport;
+
+static void
+ut_setup(void)
+{
+	struct spdk_nvmf_transport_opts opts = {};
+	struct spdk_nvmf_transport *transport;
+
+	g_thread = spdk_thread_create(NULL, NULL);
+	SPDK_CU_ASSERT_FATAL(g_thread != NULL);
+	spdk_set_thread(g_thread);
+
+	nvmf_local_opts_init(&opts);
+	opts.acceptor_poll_rate = 0;
+	transport = nvmf_local_create(&opts);
+	SPDK_CU_ASSERT_FATAL(transport != NULL);
+	transport->opts = opts;
+	g_ltransport = nvmf_local_transport(transport);
+	g_lgroup = nvmf_local_poll_group(nvmf_local_poll_group_create(transport, NULL));
+	SPDK_CU_ASSERT_FATAL(g_lgroup != NULL);
+	g_lgroup->group.transport = transport;
+
+	g_new_qpair = NULL;
+	g_disconnects = 0;
+	g_execs = 0;
+	g_fini_on_exec = false;
+	g_fini_done = 0;
+}
+
+static void
+ut_teardown(void)
+{
+	nvmf_local_poll_group_destroy(&g_lgroup->group);
+	nvmf_local_destroy(&g_ltransport->transport, NULL, NULL);
+	while (spdk_thread_poll(g_thread, 0, 0) > 0) {}
+	spdk_thread_exit(g_thread);
+	while (!spdk_thread_is_exited(g_thread)) {
+		spdk_thread_poll(g_thread, 0, 0);
+	}
+	spdk_thread_destroy(g_thread);
+	spdk_set_thread(NULL);
+	CU_ASSERT(g_conns == 0);
+}
+
+/* Accepted, given to the target and in its poll group, enabled. */
+static struct nvmf_local_qpair *
+ut_qpair(struct nvme_local_conn *conn)
+{
+	struct nvmf_local_qpair *lqpair;
+
+	CU_ASSERT(nvmf_local_accept_conn(g_ltransport, conn) == 0);
+	CU_ASSERT(nvmf_local_accept(g_ltransport) == SPDK_POLLER_BUSY);
+	SPDK_CU_ASSERT_FATAL(g_new_qpair != NULL);
+	lqpair = nvmf_local_qpair(g_new_qpair);
+	g_new_qpair = NULL;
+	CU_ASSERT(nvmf_local_poll_group_add(&g_lgroup->group, &lqpair->qpair) == 0);
+	lqpair->qpair.state = SPDK_NVMF_QPAIR_ENABLED;
+	return lqpair;
+}
+
+static void
+ut_hand_over(struct nvme_local_conn *conn, struct nvme_local_slot *slot)
+{
+	CU_ASSERT(nvme_local_ring_put(&conn->sq, slot));
+}
+
+static struct nvme_local_slot *
+ut_back(struct nvme_local_conn *conn)
+{
+	void *slot = NULL;
+
+	return nvme_local_ring_take(&conn->cq, &slot, 1) == 1 ? slot : NULL;
+}
+
+/* What the initiator does at the end: lets go. */
+static void
+ut_initiator_leaves(struct nvme_local_conn *conn)
+{
+	__atomic_store_n(&conn->initiator_leaving, true, __ATOMIC_RELEASE);
+	spdk_nvme_local_conn_put(conn);
+}
+
+static void
+ut_finish(struct nvmf_local_qpair *lqpair)
+{
+	nvmf_local_poll_group_remove(&g_lgroup->group, &lqpair->qpair);
+	nvmf_local_qpair_fini(&lqpair->qpair, NULL, NULL);
+}
+
+/* ── Tests ── */
+
+static void
+test_listen_and_accept(void)
+{
+	struct spdk_nvme_transport_id trid = {};
+	struct nvme_local_conn *conn;
+	struct nvmf_local_qpair *lqpair;
+
+	ut_setup();
+	snprintf(trid.traddr, sizeof(trid.traddr), "node0");
+	CU_ASSERT(nvmf_local_listen(&g_ltransport->transport, &trid, NULL) == 0);
+	CU_ASSERT(g_accept == nvmf_local_accept_conn);
+	CU_ASSERT(g_accept_ctx == g_ltransport);
+
+	/* Accepted on the initiator's thread: a reference, and pending until the poller. */
+	conn = ut_conn(4);
+	CU_ASSERT(g_accept(g_accept_ctx, conn) == 0);
+	CU_ASSERT(conn->refs == 2);
+	CU_ASSERT(g_new_qpair == NULL);
+	CU_ASSERT(!TAILQ_EMPTY(&g_ltransport->pending));
+
+	/* On the transport's thread: given to the target. */
+	CU_ASSERT(nvmf_local_accept(g_ltransport) == SPDK_POLLER_BUSY);
+	SPDK_CU_ASSERT_FATAL(g_new_qpair != NULL);
+	CU_ASSERT(TAILQ_EMPTY(&g_ltransport->pending));
+	CU_ASSERT(nvmf_local_accept(g_ltransport) == SPDK_POLLER_IDLE);
+	lqpair = nvmf_local_qpair(g_new_qpair);
+	CU_ASSERT(lqpair->conn == conn);
+	CU_ASSERT(lqpair->qpair.transport == &g_ltransport->transport);
+	CU_ASSERT(strcmp(lqpair->trid.traddr, "node0") == 0);
+
+	nvmf_local_stop_listen(&g_ltransport->transport, &trid);
+	CU_ASSERT(g_accept == NULL);
+	nvmf_local_qpair_fini(&lqpair->qpair, NULL, NULL);
+	ut_initiator_leaves(conn);
+	ut_teardown();
+}
+
+static void
+test_requests_are_the_initiators_slots(void)
+{
+	char buf0[512], buf1[512];
+	struct spdk_memory_domain *domain = (struct spdk_memory_domain *)0xD0;
+	struct nvme_local_conn *conn;
+	struct nvmf_local_qpair *lqpair;
+	struct nvme_local_slot *slot;
+	struct spdk_nvmf_request *req;
+
+	ut_setup();
+	conn = ut_conn(4);
+	lqpair = ut_qpair(conn);
+
+	slot = &conn->slots[2];
+	slot->cmd.opc = SPDK_NVME_OPC_WRITE;
+	slot->cmd.cid = 2;
+	slot->cmd.dptr.sgl1.unkeyed.type = SPDK_NVME_SGL_TYPE_TRANSPORT_DATA_BLOCK;
+	slot->cmd.dptr.sgl1.unkeyed.length = sizeof(buf0) + sizeof(buf1);
+	slot->length = sizeof(buf0) + sizeof(buf1);
+	slot->iovcnt = 2;
+	slot->iov[0].iov_base = buf0;
+	slot->iov[0].iov_len = sizeof(buf0);
+	slot->iov[1].iov_base = buf1;
+	slot->iov[1].iov_len = sizeof(buf1);
+	slot->memory_domain = domain;
+	slot->memory_domain_ctx = (void *)0xC7;
+	ut_hand_over(conn, slot);
+
+	CU_ASSERT(nvmf_local_poll_group_poll(&g_lgroup->group) == 1);
+	SPDK_CU_ASSERT_FATAL(g_execs == 1);
+	req = g_exec[0];
+	/* The command and its completion are the slot's own; the data, the initiator's buffers. */
+	CU_ASSERT((void *)req->cmd == (void *)&slot->cmd);
+	CU_ASSERT((void *)req->rsp == (void *)&slot->cpl);
+	CU_ASSERT(req->length == sizeof(buf0) + sizeof(buf1));
+	CU_ASSERT(req->iovcnt == 2);
+	CU_ASSERT(req->iov[0].iov_base == buf0 && req->iov[1].iov_base == buf1);
+	CU_ASSERT(req->memory_domain == domain && req->memory_domain_ctx == (void *)0xC7);
+	CU_ASSERT(req->xfer == SPDK_NVME_DATA_HOST_TO_CONTROLLER);
+	CU_ASSERT(!req->data_from_pool);
+	CU_ASSERT(lqpair->qpair.queue_depth == 1);
+
+	/* nvmf completes it: the slot goes back, with what nvmf wrote in its completion. */
+	CU_ASSERT(ut_back(conn) == NULL);
+	req->rsp->nvme_cpl.cid = 2;
+	req->rsp->nvme_cpl.cdw0 = 0x5A;
+	nvmf_local_req_complete(req);
+	CU_ASSERT(ut_back(conn) == slot);
+	CU_ASSERT(slot->cpl.cid == 2 && slot->cpl.cdw0 == 0x5A);
+	CU_ASSERT(lqpair->qpair.queue_depth == 0);
+
+	ut_finish(lqpair);
+	ut_initiator_leaves(conn);
+	ut_teardown();
+}
+
+static void
+test_a_command_above_the_mdts_comes_back_refused(void)
+{
+	struct nvme_local_conn *conn;
+	struct nvmf_local_qpair *lqpair;
+	struct nvme_local_slot *slot;
+
+	ut_setup();
+	conn = ut_conn(4);
+	lqpair = ut_qpair(conn);
+	slot = &conn->slots[0];
+	slot->cmd.opc = SPDK_NVME_OPC_READ;
+	slot->cmd.cid = 0;
+	slot->length = g_ltransport->transport.opts.max_io_size + 4096;
+	ut_hand_over(conn, slot);
+
+	CU_ASSERT(nvmf_local_poll_group_poll(&g_lgroup->group) == 1);
+	CU_ASSERT(g_execs == 0);
+	CU_ASSERT(ut_back(conn) == slot);
+	CU_ASSERT(slot->cpl.status.sct == SPDK_NVME_SCT_GENERIC);
+	CU_ASSERT(slot->cpl.status.sc == SPDK_NVME_SC_DATA_SGL_LENGTH_INVALID);
+	CU_ASSERT(slot->cpl.status.dnr == 1);
+	CU_ASSERT(lqpair->qpair.queue_depth == 0);
+
+	ut_finish(lqpair);
+	ut_initiator_leaves(conn);
+	ut_teardown();
+}
+
+static void
+test_a_request_freed_comes_back_aborted(void)
+{
+	struct nvme_local_conn *conn;
+	struct nvmf_local_qpair *lqpair;
+	struct nvme_local_slot *slot;
+
+	ut_setup();
+	conn = ut_conn(4);
+	lqpair = ut_qpair(conn);
+	lqpair->qpair.qid = 0;
+	slot = &conn->slots[1];
+	slot->cmd.opc = SPDK_NVME_OPC_ASYNC_EVENT_REQUEST;
+	slot->cmd.cid = 1;
+	ut_hand_over(conn, slot);
+	CU_ASSERT(nvmf_local_poll_group_poll(&g_lgroup->group) == 1);
+	SPDK_CU_ASSERT_FATAL(g_execs == 1);
+
+	/* nvmf frees an AER it will never complete (its qpair goes down): the slot still comes back. */
+	nvmf_local_req_free(g_exec[0]);
+	CU_ASSERT(ut_back(conn) == slot);
+	CU_ASSERT(slot->cpl.cid == 1);
+	CU_ASSERT(spdk_nvme_cpl_is_aborted_sq_deletion(&slot->cpl));
+
+	ut_finish(lqpair);
+	ut_initiator_leaves(conn);
+	ut_teardown();
+}
+
+static void
+test_an_initiator_that_leaves_disconnects_the_qpair(void)
+{
+	struct nvme_local_conn *conn;
+	struct nvmf_local_qpair *lqpair;
+
+	ut_setup();
+	conn = ut_conn(4);
+	lqpair = ut_qpair(conn);
+	ut_hand_over(conn, &conn->slots[0]);
+	__atomic_store_n(&conn->initiator_leaving, true, __ATOMIC_RELEASE);
+
+	/* Disconnected once; what was handed over since is not taken: the initiator takes it back. */
+	CU_ASSERT(nvmf_local_poll_group_poll(&g_lgroup->group) == 0);
+	CU_ASSERT(nvmf_local_poll_group_poll(&g_lgroup->group) == 0);
+	CU_ASSERT(g_disconnects == 1);
+	CU_ASSERT(g_execs == 0);
+
+	/* nvmf finishes the qpair: closed, the target's reference dropped, freed later. */
+	nvmf_local_poll_group_remove(&g_lgroup->group, &lqpair->qpair);
+	nvmf_local_qpair_fini(&lqpair->qpair, ut_fini_done, &g_fini_done);
+	CU_ASSERT(g_fini_done == 1);
+	CU_ASSERT(__atomic_load_n(&conn->target_closed, __ATOMIC_ACQUIRE));
+	CU_ASSERT(conn->refs == 1);
+	spdk_nvme_local_conn_put(conn);
+	ut_teardown();
+}
+
+static void
+test_a_qpair_finished_in_a_batch_takes_no_more(void)
+{
+	struct nvme_local_conn *conn;
+
+	ut_setup();
+	conn = ut_conn(4);
+	ut_qpair(conn);
+	ut_hand_over(conn, &conn->slots[0]);
+	ut_hand_over(conn, &conn->slots[1]);
+	ut_hand_over(conn, &conn->slots[2]);
+
+	/* The first request finishes the qpair: the two others stay the initiator's. */
+	g_fini_on_exec = true;
+	CU_ASSERT(nvmf_local_poll_group_poll(&g_lgroup->group) == 3);
+	CU_ASSERT(g_execs == 1);
+	CU_ASSERT(g_fini_done == 1);
+	CU_ASSERT(__atomic_load_n(&conn->target_closed, __ATOMIC_ACQUIRE));
+	CU_ASSERT(TAILQ_EMPTY(&g_lgroup->qpairs));
+	ut_initiator_leaves(conn);
+	ut_teardown();
+}
+
+static void
+test_destroy_closes_what_was_never_given(void)
+{
+	struct nvme_local_conn *conn;
+
+	ut_setup();
+	conn = ut_conn(4);
+	CU_ASSERT(nvmf_local_accept_conn(g_ltransport, conn) == 0);
+	CU_ASSERT(conn->refs == 2);
+
+	/* The transport goes before its poller ran: the connection is closed, not leaked. */
+	nvmf_local_poll_group_destroy(&g_lgroup->group);
+	nvmf_local_destroy(&g_ltransport->transport, NULL, NULL);
+	CU_ASSERT(__atomic_load_n(&conn->target_closed, __ATOMIC_ACQUIRE));
+	CU_ASSERT(conn->refs == 1);
+	ut_initiator_leaves(conn);
+
+	while (spdk_thread_poll(g_thread, 0, 0) > 0) {}
+	spdk_thread_exit(g_thread);
+	while (!spdk_thread_is_exited(g_thread)) {
+		spdk_thread_poll(g_thread, 0, 0);
+	}
+	spdk_thread_destroy(g_thread);
+	spdk_set_thread(NULL);
+	CU_ASSERT(g_conns == 0);
+}
+
+int
+main(int argc, char **argv)
+{
+	CU_pSuite suite = NULL;
+	unsigned int num_failures;
+
+	CU_initialize_registry();
+	spdk_thread_lib_init(NULL, 0);
+
+	suite = CU_add_suite("nvmf_local", NULL, NULL);
+	CU_ADD_TEST(suite, test_listen_and_accept);
+	CU_ADD_TEST(suite, test_requests_are_the_initiators_slots);
+	CU_ADD_TEST(suite, test_a_command_above_the_mdts_comes_back_refused);
+	CU_ADD_TEST(suite, test_a_request_freed_comes_back_aborted);
+	CU_ADD_TEST(suite, test_an_initiator_that_leaves_disconnects_the_qpair);
+	CU_ADD_TEST(suite, test_a_qpair_finished_in_a_batch_takes_no_more);
+	CU_ADD_TEST(suite, test_destroy_closes_what_was_never_given);
+
+	num_failures = spdk_ut_run_tests(argc, argv, NULL);
+	spdk_thread_lib_fini();
+	CU_cleanup_registry();
+	return num_failures;
+}

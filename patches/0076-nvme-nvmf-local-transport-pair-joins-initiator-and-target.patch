diff --git a/lib/nvme/nvme_local.c b/lib/nvme/nvme_local.c
new file mode 100644
index 0000000..0c259c1
--- /dev/null
+++ b/lib/nvme/nvme_local.c
@@ -0,0 +1,1076 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Copyright (c) 2026 Evariops.
+ */
+
+/*
+ * The LOCAL NVMe transport (Evariops 0076): an initiator whose controller is an NVMe-oF controller
+ * of the same process (lib/nvmf/local.c). spdk_internal/nvme_local.h describes the connection; the
+ * registry where the target's listeners are found lives here, in the library both sides link.
+ *
+ * The data are not copied: the target's bdevs read and write the initiator's buffers. A slot that
+ * carries data is therefore never completed to its user while the target holds it, and a
+ * disconnect waits, through process_completions and the poll group, until nothing is in flight.
+ * Qpairs are asynchronous only: a synchronous wait would spin a reactor the target may need.
+ */
+
+#include "nvme_internal.h"
+
+#include "spdk/dma.h"
+#include "spdk/env.h"
+#include "spdk/nvmf_spec.h"
+#include "spdk/string.h"
+#include "spdk_internal/nvme_local.h"
+
+#define NVME_LOCAL_REAP_BATCH	32
+
+struct nvme_local_listener {
+	struct spdk_nvme_transport_id		trid;
+	spdk_nvme_local_accept_cb		accept;
+	void					*ctx;
+	TAILQ_ENTRY(nvme_local_listener)	link;
+};
+
+static pthread_mutex_t g_nvme_local_lock = PTHREAD_MUTEX_INITIALIZER;
+static TAILQ_HEAD(, nvme_local_listener) g_nvme_local_listeners =
+	TAILQ_HEAD_INITIALIZER(g_nvme_local_listeners);
+
+enum nvme_local_qpair_state {
+	NVME_LOCAL_QPAIR_IDLE = 0,
+	NVME_LOCAL_QPAIR_CONNECT_SEND,
+	NVME_LOCAL_QPAIR_CONNECT_POLL,
+	NVME_LOCAL_QPAIR_RUNNING,
+	/* Disconnecting: waits for the slots the target holds. */
+	NVME_LOCAL_QPAIR_QUIESCING,
+};
+
+struct nvme_local_req {
+	struct nvme_request		*req;
+	uint16_t			index;
+	/* Handed over and not handed back: the slot, and its data, are the target's. */
+	bool				in_flight;
+	/*
+	 * Completed to its user while the target still holds the slot (an AER that a reset or a
+	 * destruction aborts, an admin command of a qpair deleted): the slot comes back to nobody.
+	 */
+	bool				user_done;
+	TAILQ_ENTRY(nvme_local_req)	link;
+};
+
+struct nvme_local_qpair {
+	struct spdk_nvme_qpair		qpair;
+	uint16_t			num_entries;
+	uint16_t			in_flight;
+	uint8_t				state;
+	struct nvme_local_conn		*conn;
+	struct nvme_local_req		*reqs;
+	TAILQ_HEAD(, nvme_local_req)	free_reqs;
+};
+
+struct nvme_local_ctrlr {
+	struct spdk_nvme_ctrlr		ctrlr;
+};
+
+struct nvme_local_poll_group {
+	struct spdk_nvme_transport_poll_group	group;
+};
+
+static int nvme_local_ctrlr_delete_io_qpair(struct spdk_nvme_ctrlr *ctrlr,
+		struct spdk_nvme_qpair *qpair);
+
+static inline struct nvme_local_qpair *
+nvme_local_qpair(struct spdk_nvme_qpair *qpair)
+{
+	return SPDK_CONTAINEROF(qpair, struct nvme_local_qpair, qpair);
+}
+
+static inline struct nvme_local_ctrlr *
+nvme_local_ctrlr(struct spdk_nvme_ctrlr *ctrlr)
+{
+	return SPDK_CONTAINEROF(ctrlr, struct nvme_local_ctrlr, ctrlr);
+}
+
+/* ── The registry ── */
+
+static struct nvme_local_listener *
+nvme_local_find_listener(const struct spdk_nvme_transport_id *trid)
+{
+	struct nvme_local_listener *listener;
+
+	TAILQ_FOREACH(listener, &g_nvme_local_listeners, link) {
+		if (strcasecmp(listener->trid.traddr, trid->traddr) == 0 &&
+		    strcasecmp(listener->trid.trsvcid, trid->trsvcid) == 0) {
+			return listener;
+		}
+	}
+
+	return NULL;
+}
+
+int
+spdk_nvme_local_listen(const struct spdk_nvme_transport_id *trid,
+		       spdk_nvme_local_accept_cb accept, void *ctx)
+{
+	struct nvme_local_listener *listener;
+	int rc = 0;
+
+	pthread_mutex_lock(&g_nvme_local_lock);
+	if (nvme_local_find_listener(trid) != NULL) {
+		rc = -EADDRINUSE;
+		goto out;
+	}
+
+	listener = calloc(1, sizeof(*listener));
+	if (listener == NULL) {
+		rc = -ENOMEM;
+		goto out;
+	}
+
+	listener->trid = *trid;
+	listener->accept = accept;
+	listener->ctx = ctx;
+	TAILQ_INSERT_TAIL(&g_nvme_local_listeners, listener, link);
+out:
+	pthread_mutex_unlock(&g_nvme_local_lock);
+	return rc;
+}
+
+void
+spdk_nvme_local_stop_listen(const struct spdk_nvme_transport_id *trid)
+{
+	struct nvme_local_listener *listener;
+
+	pthread_mutex_lock(&g_nvme_local_lock);
+	listener = nvme_local_find_listener(trid);
+	if (listener != NULL) {
+		TAILQ_REMOVE(&g_nvme_local_listeners, listener, link);
+		free(listener);
+	}
+	pthread_mutex_unlock(&g_nvme_local_lock);
+}
+
+/* ── The connection ── */
+
+static struct nvme_local_conn *
+nvme_local_conn_create(uint16_t qid, uint16_t num_slots)
+{
+	struct nvme_local_conn *conn;
+	uint16_t i;
+
+	conn = calloc(1, sizeof(*conn));
+	if (conn == NULL) {
+		return NULL;
+	}
+
+	conn->slots = calloc(num_slots, sizeof(*conn->slots));
+	if (conn->slots == NULL ||
+	    nvme_local_ring_init(&conn->sq, num_slots) != 0 ||
+	    nvme_local_ring_init(&conn->cq, num_slots) != 0) {
+		nvme_local_ring_fini(&conn->sq);
+		nvme_local_ring_fini(&conn->cq);
+		free(conn->slots);
+		free(conn);
+		return NULL;
+	}
+
+	for (i = 0; i < num_slots; i++) {
+		conn->slots[i].index = i;
+	}
+
+	conn->num_slots = num_slots;
+	conn->qid = qid;
+	conn->refs = 1;
+	return conn;
+}
+
+void
+spdk_nvme_local_conn_put(struct nvme_local_conn *conn)
+{
+	uint16_t i;
+
+	if (__atomic_sub_fetch(&conn->refs, 1, __ATOMIC_ACQ_REL) != 0) {
+		return;
+	}
+
+	for (i = 0; i < conn->num_slots; i++) {
+		spdk_free(conn->slots[i].bounce);
+	}
+
+	nvme_local_ring_fini(&conn->sq);
+	nvme_local_ring_fini(&conn->cq);
+	free(conn->slots);
+	free(conn);
+}
+
+static inline bool
+nvme_local_target_closed(struct nvme_local_conn *conn)
+{
+	return __atomic_load_n(&conn->target_closed, __ATOMIC_ACQUIRE);
+}
+
+/* ── Requests and slots ── */
+
+static enum spdk_nvme_data_transfer
+nvme_local_xfer(const struct nvme_request *req)
+{
+	if (req->cmd.opc == SPDK_NVME_OPC_FABRIC) {
+		const struct spdk_nvmf_capsule_cmd *nvmf_cmd = (const void *)&req->cmd;
+
+		return spdk_nvme_opc_get_data_transfer(nvmf_cmd->fctype);
+	}
+
+	return spdk_nvme_opc_get_data_transfer(req->cmd.opc);
+}
+
+/*
+ * The user's buffers of req, as iovecs: what the target reads and writes on an I/O queue, or what
+ * the admin queue's bounce buffer is filled from and copied back to.
+ */
+static int
+nvme_local_payload_iovs(struct nvme_request *req, struct iovec *iov, uint32_t max,
+			uint32_t *iovcnt)
+{
+	uint32_t remaining = req->payload.size, cnt = 0, len, skip, i;
+	void *addr;
+
+	switch (nvme_req_payload_type(req)) {
+	case NVME_PAYLOAD_TYPE_CONTIG:
+		iov[0].iov_base = (void *)((uintptr_t)req->payload.contig_or_cb_arg + req->payload.offset);
+		iov[0].iov_len = remaining;
+		cnt = 1;
+		break;
+	case NVME_PAYLOAD_TYPE_SGL:
+		req->payload.reset_sgl_fn(req->payload.contig_or_cb_arg, req->payload.offset);
+		while (remaining > 0) {
+			if (cnt == max) {
+				return -E2BIG;
+			}
+			if (req->payload.next_sge_fn(req->payload.contig_or_cb_arg, &addr, &len) != 0 ||
+			    len == 0) {
+				return -EINVAL;
+			}
+			len = spdk_min(len, remaining);
+			iov[cnt].iov_base = addr;
+			iov[cnt].iov_len = len;
+			cnt++;
+			remaining -= len;
+		}
+		break;
+	case NVME_PAYLOAD_TYPE_IOV:
+		skip = req->payload.offset;
+		for (i = 0; i < req->payload.iov_count && remaining > 0; i++) {
+			const struct iovec *src = &req->payload.iov[i];
+
+			if (skip >= src->iov_len) {
+				skip -= src->iov_len;
+				continue;
+			}
+			if (cnt == max) {
+				return -E2BIG;
+			}
+			len = spdk_min(src->iov_len - skip, remaining);
+			iov[cnt].iov_base = (uint8_t *)src->iov_base + skip;
+			iov[cnt].iov_len = len;
+			cnt++;
+			remaining -= len;
+			skip = 0;
+		}
+		if (remaining > 0) {
+			return -EINVAL;
+		}
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	*iovcnt = cnt;
+	return 0;
+}
+
+static int
+nvme_local_slot_fill(struct nvme_local_qpair *lqpair, struct nvme_local_slot *slot,
+		     struct nvme_request *req)
+{
+	struct iovec iov[NVME_LOCAL_MAX_SGES];
+	enum spdk_nvme_data_transfer xfer;
+	uint32_t iovcnt;
+	int rc;
+
+	slot->cmd = req->cmd;
+	slot->cmd.psdt = SPDK_NVME_PSDT_SGL_MPTR_CONTIG;
+	slot->cmd.dptr.sgl1.address = 0;
+	slot->cmd.dptr.sgl1.unkeyed.type = SPDK_NVME_SGL_TYPE_TRANSPORT_DATA_BLOCK;
+	slot->cmd.dptr.sgl1.unkeyed.subtype = SPDK_NVME_SGL_SUBTYPE_TRANSPORT;
+	slot->cmd.dptr.sgl1.unkeyed.length = req->payload.size;
+	slot->length = req->payload.size;
+	slot->iovcnt = 0;
+	slot->memory_domain = NULL;
+	slot->memory_domain_ctx = NULL;
+	assert(slot->bounce == NULL);
+
+	if (req->payload.size == 0) {
+		return 0;
+	}
+
+	if (spdk_likely(!nvme_qpair_is_admin_queue(&lqpair->qpair))) {
+		rc = nvme_local_payload_iovs(req, slot->iov, NVME_LOCAL_MAX_SGES, &iovcnt);
+		if (spdk_unlikely(rc != 0)) {
+			return rc;
+		}
+
+		slot->iovcnt = iovcnt;
+		/* The target's bdevs pull and push through the domain where they cannot use it. */
+		if (req->payload.opts != NULL && req->payload.opts->memory_domain != NULL) {
+			slot->memory_domain = req->payload.opts->memory_domain;
+			slot->memory_domain_ctx = req->payload.opts->memory_domain_ctx;
+		}
+		return 0;
+	}
+
+	slot->bounce = spdk_zmalloc(req->payload.size, 0x1000, NULL, SPDK_ENV_NUMA_ID_ANY,
+				    SPDK_MALLOC_DMA);
+	if (slot->bounce == NULL) {
+		return -ENOMEM;
+	}
+
+	xfer = nvme_local_xfer(req);
+	if (xfer == SPDK_NVME_DATA_HOST_TO_CONTROLLER || xfer == SPDK_NVME_DATA_BIDIRECTIONAL) {
+		rc = nvme_local_payload_iovs(req, iov, NVME_LOCAL_MAX_SGES, &iovcnt);
+		if (rc != 0) {
+			spdk_free(slot->bounce);
+			slot->bounce = NULL;
+			return rc;
+		}
+		spdk_copy_iovs_to_buf(slot->bounce, req->payload.size, iov, iovcnt);
+	}
+
+	slot->iov[0].iov_base = slot->bounce;
+	slot->iov[0].iov_len = req->payload.size;
+	slot->iovcnt = 1;
+	return 0;
+}
+
+/* An admin slot is back: its data go to the user's buffers, and its bounce buffer away. */
+static void
+nvme_local_bounce_back(struct nvme_request *req, struct nvme_local_slot *slot, bool copy)
+{
+	enum spdk_nvme_data_transfer xfer;
+	struct iovec iov[NVME_LOCAL_MAX_SGES];
+	uint32_t iovcnt;
+
+	if (copy) {
+		xfer = nvme_local_xfer(req);
+		if ((xfer == SPDK_NVME_DATA_CONTROLLER_TO_HOST || xfer == SPDK_NVME_DATA_BIDIRECTIONAL) &&
+		    nvme_local_payload_iovs(req, iov, NVME_LOCAL_MAX_SGES, &iovcnt) == 0) {
+			spdk_copy_buf_to_iovs(iov, iovcnt, slot->bounce, req->payload.size);
+		}
+	}
+
+	spdk_free(slot->bounce);
+	slot->bounce = NULL;
+}
+
+static void
+nvme_local_req_put(struct nvme_local_qpair *lqpair, struct nvme_local_req *lreq)
+{
+	assert(lreq->in_flight);
+	lqpair->in_flight--;
+	lreq->req = NULL;
+	lreq->in_flight = false;
+	lreq->user_done = false;
+	TAILQ_INSERT_HEAD(&lqpair->free_reqs, lreq, link);
+}
+
+static void
+nvme_local_req_complete(struct nvme_local_qpair *lqpair, struct nvme_request *req,
+			struct spdk_nvme_cpl *cpl)
+{
+	struct spdk_nvme_qpair *qpair = &lqpair->qpair;
+
+	qpair->queue_depth--;
+	if (spdk_unlikely(spdk_nvme_cpl_is_error(cpl)) && !qpair->ctrlr->opts.disable_error_logging &&
+	    !spdk_nvme_cpl_is_aborted_sq_deletion(cpl)) {
+		spdk_nvme_qpair_print_command(qpair, &req->cmd);
+		spdk_nvme_qpair_print_completion_ext(qpair, cpl, req->cmd.opc);
+	}
+
+	nvme_complete_request(req->cb_fn, req->cb_arg, qpair, req, cpl);
+}
+
+/* The target handed the slot back; slot->cpl holds its completion. */
+static void
+nvme_local_slot_back(struct nvme_local_qpair *lqpair, struct nvme_local_slot *slot)
+{
+	struct nvme_local_req *lreq = &lqpair->reqs[slot->index];
+	struct nvme_request *req = lreq->req;
+	struct spdk_nvme_cpl cpl = slot->cpl;
+	bool user_done = lreq->user_done;
+
+	assert(lreq->in_flight);
+	if (slot->bounce != NULL) {
+		nvme_local_bounce_back(req, slot, !user_done && !spdk_nvme_cpl_is_error(&cpl));
+	}
+
+	/* Free before the user's callback, which may submit into this very slot. */
+	nvme_local_req_put(lqpair, lreq);
+	if (user_done) {
+		return;
+	}
+
+	cpl.cid = req->cmd.cid;
+	nvme_local_req_complete(lqpair, req, &cpl);
+}
+
+/*
+ * Completes, as aborted, the requests of the slots chosen by pick while the target still holds
+ * them. Two passes: a callback may submit, and must not see its new request picked.
+ */
+static void
+nvme_local_user_abort(struct nvme_local_qpair *lqpair, uint32_t dnr,
+		      bool (*pick)(struct nvme_local_qpair *lqpair, struct nvme_local_req *lreq))
+{
+	STAILQ_HEAD(, nvme_request) aborted = STAILQ_HEAD_INITIALIZER(aborted);
+	struct spdk_nvme_cpl cpl = {};
+	struct nvme_local_req *lreq;
+	struct nvme_request *req;
+	uint16_t i;
+
+	for (i = 0; i < lqpair->num_entries; i++) {
+		lreq = &lqpair->reqs[i];
+		if (lreq->in_flight && !lreq->user_done && pick(lqpair, lreq)) {
+			lreq->user_done = true;
+			STAILQ_INSERT_TAIL(&aborted, lreq->req, stailq);
+			lreq->req = NULL;
+		}
+	}
+
+	cpl.sqid = lqpair->qpair.id;
+	cpl.status.sct = SPDK_NVME_SCT_GENERIC;
+	cpl.status.sc = SPDK_NVME_SC_ABORTED_SQ_DELETION;
+	cpl.status.dnr = dnr;
+	while ((req = STAILQ_FIRST(&aborted)) != NULL) {
+		STAILQ_REMOVE_HEAD(&aborted, stailq);
+		cpl.cid = req->cmd.cid;
+		nvme_local_req_complete(lqpair, req, &cpl);
+	}
+}
+
+static bool
+nvme_local_pick_aer(struct nvme_local_qpair *lqpair, struct nvme_local_req *lreq)
+{
+	return lreq->req->cmd.opc == SPDK_NVME_OPC_ASYNC_EVENT_REQUEST;
+}
+
+/* What holds none of the user's memory: an admin command (its data are the slot's) or one
+ * without data. */
+static bool
+nvme_local_pick_memoryless(struct nvme_local_qpair *lqpair, struct nvme_local_req *lreq)
+{
+	return nvme_qpair_is_admin_queue(&lqpair->qpair) || lreq->req->payload.size == 0;
+}
+
+static bool
+nvme_local_pick_all(struct nvme_local_qpair *lqpair, struct nvme_local_req *lreq)
+{
+	return true;
+}
+
+static uint32_t
+nvme_local_reap(struct nvme_local_qpair *lqpair, uint32_t max)
+{
+	void *batch[NVME_LOCAL_REAP_BATCH];
+	uint32_t i, n, total = 0;
+
+	/* A callback may disconnect the qpair: once nothing is in flight, it lets go of conn. */
+	while (total < max && lqpair->conn != NULL && lqpair->in_flight > 0) {
+		n = nvme_local_ring_take(&lqpair->conn->cq, batch,
+					 spdk_min(max - total, NVME_LOCAL_REAP_BATCH));
+		for (i = 0; i < n; i++) {
+			nvme_local_slot_back(lqpair, batch[i]);
+		}
+		total += n;
+		if (n < NVME_LOCAL_REAP_BATCH) {
+			break;
+		}
+	}
+
+	return total;
+}
+
+/*
+ * The target closed: it touches no slot again, and what it handed back was taken first. A slot
+ * still in flight was never taken (or freed by a target that closed before it could hand it
+ * back): the slot is ours again and its request is aborted.
+ */
+static void
+nvme_local_take_back(struct nvme_local_qpair *lqpair)
+{
+	struct nvme_local_req *lreq;
+	uint16_t i;
+
+	/* The aborted requests' callbacks may submit: not to a target that closed. */
+	lqpair->state = NVME_LOCAL_QPAIR_QUIESCING;
+	nvme_local_user_abort(lqpair, 0, nvme_local_pick_all);
+	for (i = 0; i < lqpair->num_entries; i++) {
+		lreq = &lqpair->reqs[i];
+		if (lreq->in_flight) {
+			spdk_free(lqpair->conn->slots[i].bounce);
+			lqpair->conn->slots[i].bounce = NULL;
+			nvme_local_req_put(lqpair, lreq);
+		}
+	}
+}
+
+/* The initiator lets go of the connection; the target frees it if it already did. */
+static void
+nvme_local_qpair_leave(struct nvme_local_qpair *lqpair)
+{
+	struct nvme_local_conn *conn = lqpair->conn;
+
+	lqpair->conn = NULL;
+	lqpair->state = NVME_LOCAL_QPAIR_IDLE;
+	__atomic_store_n(&conn->initiator_leaving, true, __ATOMIC_RELEASE);
+	spdk_nvme_local_conn_put(conn);
+}
+
+static void
+nvme_local_qpair_try_finish_disconnect(struct nvme_local_qpair *lqpair)
+{
+	assert(nvme_qpair_get_state(&lqpair->qpair) == NVME_QPAIR_DISCONNECTING);
+	if (lqpair->in_flight > 0) {
+		return;
+	}
+
+	if (lqpair->conn != NULL) {
+		nvme_local_qpair_leave(lqpair);
+	}
+
+	nvme_transport_ctrlr_disconnect_qpair_done(&lqpair->qpair);
+}
+
+/* ── The qpair ── */
+
+static struct spdk_nvme_qpair *
+nvme_local_ctrlr_create_qpair(struct spdk_nvme_ctrlr *ctrlr, uint16_t qid, uint32_t qsize,
+			      enum spdk_nvme_qprio qprio, uint32_t num_requests, bool async)
+{
+	struct nvme_local_qpair *lqpair;
+	uint16_t i;
+	int rc;
+
+	if (qsize < SPDK_NVME_QUEUE_MIN_ENTRIES || qsize > UINT16_MAX) {
+		NVME_CTRLR_ERRLOG(ctrlr, "Failed to create qpair with size %u.\n", qsize);
+		return NULL;
+	}
+
+	if (!async) {
+		NVME_CTRLR_ERRLOG(ctrlr, "LOCAL qpairs connect asynchronously only (async_mode)\n");
+		return NULL;
+	}
+
+	lqpair = calloc(1, sizeof(*lqpair));
+	if (lqpair == NULL) {
+		return NULL;
+	}
+
+	/* One entry of a queue stays empty (NVMe and NVMe-oF). */
+	lqpair->num_entries = qsize - 1;
+	rc = nvme_qpair_init(&lqpair->qpair, qid, ctrlr, qprio, num_requests, async);
+	if (rc != 0) {
+		free(lqpair);
+		return NULL;
+	}
+
+	lqpair->reqs = calloc(lqpair->num_entries, sizeof(*lqpair->reqs));
+	if (lqpair->reqs == NULL) {
+		nvme_qpair_deinit(&lqpair->qpair);
+		free(lqpair);
+		return NULL;
+	}
+
+	TAILQ_INIT(&lqpair->free_reqs);
+	for (i = 0; i < lqpair->num_entries; i++) {
+		lqpair->reqs[i].index = i;
+		TAILQ_INSERT_TAIL(&lqpair->free_reqs, &lqpair->reqs[i], link);
+	}
+
+	return &lqpair->qpair;
+}
+
+static struct spdk_nvme_qpair *
+nvme_local_ctrlr_create_io_qpair(struct spdk_nvme_ctrlr *ctrlr, uint16_t qid,
+				 const struct spdk_nvme_io_qpair_opts *opts)
+{
+	return nvme_local_ctrlr_create_qpair(ctrlr, qid, opts->io_queue_size, opts->qprio,
+					     opts->io_queue_requests, opts->async_mode);
+}
+
+/*
+ * A qpair deleted with slots the target still holds. An admin slot holds the connection's memory
+ * only, so its request is completed here. An I/O slot holds the user's buffers, which only the
+ * target's completion may give back: bdev_nvme deletes a qpair once disconnected, when none is in
+ * flight.
+ */
+static void
+nvme_local_qpair_abandon(struct nvme_local_qpair *lqpair)
+{
+	nvme_local_user_abort(lqpair, 1, nvme_local_pick_memoryless);
+	if (lqpair->in_flight > 0 && !nvme_qpair_is_admin_queue(&lqpair->qpair)) {
+		NVME_QPAIR_ERRLOG(&lqpair->qpair, "deleted with %u commands the LOCAL target still holds\n",
+				  lqpair->in_flight);
+	}
+
+	nvme_local_qpair_leave(lqpair);
+}
+
+static int
+nvme_local_ctrlr_delete_io_qpair(struct spdk_nvme_ctrlr *ctrlr, struct spdk_nvme_qpair *qpair)
+{
+	struct nvme_local_qpair *lqpair = nvme_local_qpair(qpair);
+
+	if (lqpair->conn != NULL) {
+		nvme_local_qpair_abandon(lqpair);
+	}
+
+	nvme_qpair_deinit(qpair);
+	free(lqpair->reqs);
+	free(lqpair);
+	return 0;
+}
+
+static int
+nvme_local_ctrlr_connect_qpair(struct spdk_nvme_ctrlr *ctrlr, struct spdk_nvme_qpair *qpair)
+{
+	struct nvme_local_qpair *lqpair = nvme_local_qpair(qpair);
+	struct nvme_local_listener *listener;
+	struct nvme_local_conn *conn;
+	int rc;
+
+	assert(lqpair->conn == NULL);
+	assert(lqpair->in_flight == 0);
+
+	conn = nvme_local_conn_create(qpair->id, lqpair->num_entries);
+	if (conn == NULL) {
+		return -ENOMEM;
+	}
+
+	pthread_mutex_lock(&g_nvme_local_lock);
+	listener = nvme_local_find_listener(&ctrlr->trid);
+	if (listener == NULL) {
+		rc = -ECONNREFUSED;
+	} else {
+		conn->trid = listener->trid;
+		rc = listener->accept(listener->ctx, conn);
+	}
+	pthread_mutex_unlock(&g_nvme_local_lock);
+
+	if (rc != 0) {
+		NVME_CTRLR_ERRLOG(ctrlr, "LOCAL connect to %s:%s refused: %s\n", ctrlr->trid.traddr,
+				  ctrlr->trid.trsvcid, spdk_strerror(-rc));
+		spdk_nvme_local_conn_put(conn);
+		return rc;
+	}
+
+	lqpair->conn = conn;
+	lqpair->state = NVME_LOCAL_QPAIR_CONNECT_SEND;
+	return 0;
+}
+
+static void
+nvme_local_ctrlr_disconnect_qpair(struct spdk_nvme_ctrlr *ctrlr, struct spdk_nvme_qpair *qpair)
+{
+	struct nvme_local_qpair *lqpair = nvme_local_qpair(qpair);
+
+	if (lqpair->conn != NULL) {
+		/* The target disconnects its qpair: it completes what it holds, and hands back as
+		 * aborted what it frees instead (its AERs). */
+		__atomic_store_n(&lqpair->conn->initiator_leaving, true, __ATOMIC_RELEASE);
+		lqpair->state = NVME_LOCAL_QPAIR_QUIESCING;
+	}
+
+	nvme_local_qpair_try_finish_disconnect(lqpair);
+}
+
+static int
+nvme_local_connect_poll(struct nvme_local_qpair *lqpair)
+{
+	struct spdk_nvme_qpair *qpair = &lqpair->qpair;
+	int rc;
+
+	/* nvme_fabric_qpair_connect_poll() polls the qpair, so this runs within itself. */
+	if (qpair->in_connect_poll) {
+		return -EAGAIN;
+	}
+
+	qpair->in_connect_poll = true;
+	switch (lqpair->state) {
+	case NVME_LOCAL_QPAIR_CONNECT_SEND:
+		rc = nvme_fabric_qpair_connect_async(qpair, lqpair->num_entries + 1);
+		if (rc == 0) {
+			lqpair->state = NVME_LOCAL_QPAIR_CONNECT_POLL;
+			rc = -EAGAIN;
+		}
+		break;
+	case NVME_LOCAL_QPAIR_CONNECT_POLL:
+		rc = nvme_fabric_qpair_connect_poll(qpair);
+		if (rc == 0) {
+			if (nvme_fabric_qpair_auth_required(qpair)) {
+				/* Same process: nothing to authenticate, and nothing to do it with. */
+				NVME_QPAIR_ERRLOG(qpair, "the subsystem asks for authentication, which LOCAL does not do\n");
+				rc = -ENOTSUP;
+			} else {
+				lqpair->state = NVME_LOCAL_QPAIR_RUNNING;
+				nvme_qpair_set_state(qpair, NVME_QPAIR_CONNECTED);
+			}
+		}
+		break;
+	default:
+		rc = 0;
+		break;
+	}
+	qpair->in_connect_poll = false;
+
+	return rc;
+}
+
+static int32_t
+nvme_local_qpair_process_completions(struct spdk_nvme_qpair *qpair, uint32_t max_completions)
+{
+	struct nvme_local_qpair *lqpair = nvme_local_qpair(qpair);
+	uint32_t max, reaped;
+	int rc;
+
+	if (spdk_unlikely(lqpair->conn == NULL)) {
+		return nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTED ? -ENXIO : 0;
+	}
+
+	max = max_completions == 0 ? lqpair->num_entries : spdk_min(max_completions, lqpair->num_entries);
+	reaped = nvme_local_reap(lqpair, max);
+
+	if (spdk_unlikely(lqpair->conn != NULL && nvme_local_target_closed(lqpair->conn))) {
+		/* What it handed back before closing comes first. */
+		reaped += nvme_local_reap(lqpair, UINT32_MAX);
+		if (lqpair->conn != NULL) {
+			nvme_local_take_back(lqpair);
+		}
+		if (nvme_qpair_get_state(qpair) != NVME_QPAIR_DISCONNECTING &&
+		    nvme_qpair_get_state(qpair) != NVME_QPAIR_DISCONNECTED) {
+			goto fail;
+		}
+	}
+
+	if (spdk_unlikely(nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTING)) {
+		nvme_local_qpair_try_finish_disconnect(lqpair);
+		return reaped;
+	}
+
+	if (spdk_unlikely(lqpair->state == NVME_LOCAL_QPAIR_CONNECT_SEND ||
+			  lqpair->state == NVME_LOCAL_QPAIR_CONNECT_POLL)) {
+		rc = nvme_local_connect_poll(lqpair);
+		if (rc == 0) {
+			/* What was queued while connecting goes now. */
+			nvme_qpair_resubmit_requests(qpair, lqpair->num_entries);
+		} else if (rc != -EAGAIN) {
+			goto fail;
+		}
+	}
+
+	return reaped;
+fail:
+	if (!qpair->transport_failure_reason) {
+		qpair->transport_failure_reason = SPDK_NVME_QPAIR_FAILURE_REMOTE;
+	}
+
+	nvme_ctrlr_disconnect_qpair(qpair);
+	/* No error until the qpair is disconnected. */
+	return nvme_qpair_get_state(qpair) == NVME_QPAIR_DISCONNECTED ? -ENXIO : 0;
+}
+
+static int
+nvme_local_qpair_submit_request(struct spdk_nvme_qpair *qpair, struct nvme_request *req)
+{
+	struct nvme_local_qpair *lqpair = nvme_local_qpair(qpair);
+	struct nvme_local_conn *conn = lqpair->conn;
+	struct nvme_local_slot *slot;
+	struct nvme_local_req *lreq;
+	int rc;
+
+	if (spdk_unlikely(conn == NULL || lqpair->state == NVME_LOCAL_QPAIR_QUIESCING)) {
+		return -ENXIO;
+	}
+
+	/* NVMe-oF carries no separate metadata buffer. */
+	if (spdk_unlikely(req->payload.md != NULL)) {
+		return -ENOTSUP;
+	}
+
+	lreq = TAILQ_FIRST(&lqpair->free_reqs);
+	if (spdk_unlikely(lreq == NULL)) {
+		return -EAGAIN;
+	}
+
+	slot = &conn->slots[lreq->index];
+	req->cmd.cid = lreq->index;
+	rc = nvme_local_slot_fill(lqpair, slot, req);
+	if (spdk_unlikely(rc != 0)) {
+		NVME_QPAIR_ERRLOG(qpair, "LOCAL command 0x%x not built: %s\n", req->cmd.opc,
+				  spdk_strerror(-rc));
+		return rc;
+	}
+
+	TAILQ_REMOVE(&lqpair->free_reqs, lreq, link);
+	lreq->req = req;
+	lreq->in_flight = true;
+	lqpair->in_flight++;
+	qpair->queue_depth++;
+
+	/* A slot is in one ring at a time and the rings have a place per slot: never full. */
+	if (spdk_unlikely(!nvme_local_ring_put(&conn->sq, slot))) {
+		assert(false);
+		spdk_free(slot->bounce);
+		slot->bounce = NULL;
+		nvme_local_req_put(lqpair, lreq);
+		qpair->queue_depth--;
+		return -EAGAIN;
+	}
+
+	return 0;
+}
+
+static void
+nvme_local_qpair_abort_reqs(struct spdk_nvme_qpair *qpair, uint32_t dnr)
+{
+	/* The target completes the others: their data are the user's. */
+	nvme_local_user_abort(nvme_local_qpair(qpair), dnr, nvme_local_pick_memoryless);
+}
+
+static void
+nvme_local_admin_qpair_abort_aers(struct spdk_nvme_qpair *qpair)
+{
+	nvme_local_user_abort(nvme_local_qpair(qpair), 0, nvme_local_pick_aer);
+}
+
+static int
+nvme_local_qpair_reset(struct spdk_nvme_qpair *qpair)
+{
+	return 0;
+}
+
+static int
+nvme_local_qpair_iterate_requests(struct spdk_nvme_qpair *qpair,
+				  int (*iter_fn)(struct nvme_request *req, void *arg), void *arg)
+{
+	struct nvme_local_qpair *lqpair = nvme_local_qpair(qpair);
+	struct nvme_local_req *lreq;
+	uint16_t i;
+	int rc;
+
+	for (i = 0; i < lqpair->num_entries; i++) {
+		lreq = &lqpair->reqs[i];
+		if (lreq->in_flight && !lreq->user_done) {
+			rc = iter_fn(lreq->req, arg);
+			if (rc != 0) {
+				return rc;
+			}
+		}
+	}
+
+	return 0;
+}
+
+/* ── The controller ── */
+
+static struct spdk_nvme_ctrlr *
+nvme_local_ctrlr_construct(const struct spdk_nvme_transport_id *trid,
+			   const struct spdk_nvme_ctrlr_opts *opts, void *devhandle)
+{
+	struct nvme_local_ctrlr *lctrlr;
+	int rc;
+
+	lctrlr = calloc(1, sizeof(*lctrlr));
+	if (lctrlr == NULL) {
+		return NULL;
+	}
+
+	lctrlr->ctrlr.opts = *opts;
+	lctrlr->ctrlr.trid = *trid;
+	/* A fabrics controller: bdev_nvme resets it by disconnecting it. */
+	lctrlr->ctrlr.trid.trtype = SPDK_NVME_TRANSPORT_CUSTOM_FABRICS;
+
+	rc = nvme_ctrlr_construct(&lctrlr->ctrlr);
+	if (rc != 0) {
+		free(lctrlr);
+		return NULL;
+	}
+
+	lctrlr->ctrlr.adminq = nvme_local_ctrlr_create_qpair(&lctrlr->ctrlr, 0,
+			       lctrlr->ctrlr.opts.admin_queue_size, 0,
+			       lctrlr->ctrlr.opts.admin_queue_size, true);
+	if (lctrlr->ctrlr.adminq == NULL) {
+		NVME_CTRLR_ERRLOG(&lctrlr->ctrlr, "failed to create admin qpair\n");
+		nvme_ctrlr_destruct(&lctrlr->ctrlr);
+		return NULL;
+	}
+
+	if (nvme_ctrlr_add_process(&lctrlr->ctrlr, 0) != 0) {
+		NVME_CTRLR_ERRLOG(&lctrlr->ctrlr, "nvme_ctrlr_add_process() failed\n");
+		nvme_ctrlr_destruct(&lctrlr->ctrlr);
+		return NULL;
+	}
+
+	return &lctrlr->ctrlr;
+}
+
+static int
+nvme_local_ctrlr_destruct(struct spdk_nvme_ctrlr *ctrlr)
+{
+	struct nvme_local_ctrlr *lctrlr = nvme_local_ctrlr(ctrlr);
+
+	if (ctrlr->adminq != NULL) {
+		nvme_local_ctrlr_delete_io_qpair(ctrlr, ctrlr->adminq);
+	}
+
+	nvme_ctrlr_destruct_finish(ctrlr);
+	free(lctrlr);
+	return 0;
+}
+
+static int
+nvme_local_ctrlr_enable(struct spdk_nvme_ctrlr *ctrlr)
+{
+	return 0;
+}

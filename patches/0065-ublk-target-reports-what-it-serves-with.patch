+++ b/lib/thread/iobuf.c
@@ -898,6 +898,24 @@ iobuf_get_channel_stats(struct spdk_io_channel_iter *iter)
 	spdk_for_each_channel_continue(iter, 0);
 }
 
+/* Evariops 0065 */
+void
+spdk_iobuf_get_pool_free(uint64_t *small, uint64_t *large)
+{
+	int32_t i;
+
+	*small = 0;
+	*large = 0;
+	IOBUF_FOREACH_NUMA_ID(i) {
+		if (g_iobuf.node[i].small_pool != NULL) {
+			*small += spdk_ring_count(g_iobuf.node[i].small_pool);
+		}
+		if (g_iobuf.node[i].large_pool != NULL) {
+			*large += spdk_ring_count(g_iobuf.node[i].large_pool);
+		}
+	}
+}
+
 int
 spdk_iobuf_get_stats(spdk_iobuf_get_stats_cb cb_fn, void *cb_arg)
 {

+/**
+ * Evariops: the free buffers of the iobuf pools, summed over NUMA nodes, read without
+ * stopping anyone: what a waiting request could still be given. Buffers in the modules'
+ * per-thread caches are not counted.
+ *
+ * \param small Free small buffers.
+ * \param large Free large buffers.
+ */
+void spdk_iobuf_get_pool_free(uint64_t *small, uint64_t *large);
+
 typedef void (*spdk_post_poller_fn)(void *fn_arg);
 

+/* Evariops 0065: what the target serves with, read on the app thread: the driver's
+ * features, each poll group's buffers, and what the iobuf pools still hold. A client
+ * decides from it whether the node serves ublk disks at all. */
+void
+ublk_dump_target_json(struct spdk_json_write_ctx *w)
+{
+	struct ublk_poll_group *poll_group;
+	uint64_t small_free, large_free;
+	uint32_t i;
+	int state;
+
+	spdk_json_write_object_begin(w);
+	spdk_json_write_named_bool(w, "active", g_ublk_tgt.active);
+	spdk_json_write_named_string(w, "cpumask", spdk_cpuset_fmt(&g_core_mask));
+	spdk_json_write_named_uint64(w, "features", g_ublk_tgt.features);
+	spdk_json_write_named_array_begin(w, "features_found");
+	for (i = 0; i < SPDK_COUNTOF(g_ublk_feature_names); i++) {
+		if (g_ublk_tgt.features & g_ublk_feature_names[i].flag) {
+			spdk_json_write_string(w, g_ublk_feature_names[i].name);
+		}
+	}
+	spdk_json_write_array_end(w);
+	spdk_json_write_named_bool(w, "user_copy", g_ublk_tgt.user_copy);
+
+	spdk_json_write_named_array_begin(w, "poll_groups");
+	for (i = 0; i < g_num_ublk_poll_groups; i++) {
+		poll_group = &g_ublk_tgt.poll_groups[i];
+		state = __atomic_load_n(&poll_group->buffers_state, __ATOMIC_ACQUIRE);
+		spdk_json_write_object_begin(w);
+		spdk_json_write_named_string(w, "thread", poll_group->ublk_thread != NULL ?
+					     spdk_thread_get_name(poll_group->ublk_thread) : "");
+		spdk_json_write_named_string(w, "buffers", state == UBLK_POLL_GROUP_READY ? "ready" :
+					     state == UBLK_POLL_GROUP_FAILED ? "failed" : "pending");
+		spdk_json_write_named_uint32(w, "holders", poll_group->buf_holders);
+		spdk_json_write_named_bool(w, "reserve_lent", poll_group->reserve_lent);
+		spdk_json_write_object_end(w);
+	}
+	spdk_json_write_array_end(w);
+
+	spdk_iobuf_get_pool_free(&small_free, &large_free);
+	spdk_json_write_named_object_begin(w, "iobuf");
+	spdk_json_write_named_uint64(w, "small_free", small_free);
+	spdk_json_write_named_uint64(w, "large_free", large_free);
+	spdk_json_write_object_end(w);
+
+	spdk_json_write_object_end(w);
+}

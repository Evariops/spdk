+/* Evariops 0065: ublk_get_target {} reports what the target serves with: the driver's
+ * features by name, each poll group's buffers, and the iobuf pools' free buffers. A fork
+ * RPC, outside the schema (Evariops 0057). */
+static void
+rpc_ublk_get_target(struct spdk_jsonrpc_request *request, const struct spdk_json_val *params)
+{
+	struct spdk_json_write_ctx *w;
+
+	if (params != NULL) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "ublk_get_target takes no parameters");
+		return;
+	}
+
+	w = spdk_jsonrpc_begin_result(request);
+	ublk_dump_target_json(w);
+	spdk_jsonrpc_end_result(request, w);
+}
+
+SPDK_RPC_REGISTER("ublk_get_target", rpc_ublk_get_target, SPDK_RPC_RUNTIME)

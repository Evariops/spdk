 		return;
 	}
 
+	/* Evariops 0035: the FINAL release was the only silent exit of this ledger —
+	 * a reader saw "ref 1 holders[qpair:1]" then nothing, and the silence was
+	 * read as an immortal ctrlr (it carried a full misdiagnosis on 2026-08-13).
+	 * The last put speaks like every deferred one does. */
+	NVME_CTRLR_NOTICELOG(nvme_ctrlr,
+			     "final ref released (by %s): destruct proceeds (Evariops 0035)\n",
+			     g_nvme_ctrlr_ref_holder_names[holder]);

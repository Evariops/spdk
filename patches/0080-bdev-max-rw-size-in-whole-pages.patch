diff --git a/lib/bdev/bdev.c b/lib/bdev/bdev.c
index 7fcbd7f00..07200a439 100644
--- a/lib/bdev/bdev.c
+++ b/lib/bdev/bdev.c
@@ -5479,6 +5479,31 @@ bdev_get_max_write(const struct spdk_bdev *bdev, uint64_t num_bytes)
 	return max_write_blocks;
 }
 
+/*
+ * Evariops 0080: the largest read or write handed whole to a bdev that wants aligned buffers,
+ * from the size of an iobuf buffer, in whole 4 KiB when its blocks divide a page. The bare
+ * computation, (132 KiB - (alignment - 1)) / block size, gives 263 blocks of 512 B: a 1 MiB I/O
+ * split in pieces of 131.5 KiB reaches a disk whose largest transfer is 128 KiB as 128 KiB plus
+ * 3.5 KiB, and every piece after the first starts inside a page.
+ */
+static uint64_t
+bdev_get_max_buffered_rw(const struct spdk_bdev *bdev, uint64_t num_bytes)
+{
+	uint64_t max_blocks = bdev_get_max_write(bdev, num_bytes);
+	uint32_t block_size = spdk_bdev_get_data_block_size(bdev);
+	uint64_t page_blocks;
+
+	if (spdk_bdev_is_md_interleaved(bdev) || block_size >= 4096 || 4096 % block_size != 0) {
+		return max_blocks;
+	}
+	page_blocks = 4096 / block_size;
+	if (page_blocks % bdev->write_unit_size != 0 || max_blocks < page_blocks) {
+		return max_blocks;
+	}
+
+	return max_blocks - max_blocks % page_blocks;
+}

 }
 
+/*
+ * Evariops 0080: a bdev that wants aligned buffers is handed reads and writes an iobuf buffer
+ * long at most, in whole 4 KiB when its blocks divide a page. With 132 KiB buffers, 512 B blocks
+ * aligned on 512 B were handed 263 blocks (131.5 KiB): a 128 KiB disk transfer plus 3.5 KiB.
+ */
+static void
+bdev_max_rw_size_whole_pages(void)
+{
+	struct spdk_iobuf_opts iobuf_opts = {};
+	struct {
+		uint32_t blocklen;
+		uint32_t alignment;
+		uint32_t write_unit_size;
+		uint32_t max_rw_size;
+	} cases[] = {
+		{ 512, 512, 1, 256 },
+		{ 512, 4096, 1, 256 },
+		{ 2048, 2048, 1, 64 },
+		{ 4096, 4096, 1, 32 },
+		/* A write unit that does not divide a page keeps the bare computation. */
+		{ 512, 512, 3, 261 },
+	};
+	struct spdk_bdev *bdev;
+	size_t i;
+	int rc;
+
+	ut_init_bdev(NULL);
+	spdk_iobuf_get_opts(&iobuf_opts, sizeof(iobuf_opts));
+	SPDK_CU_ASSERT_FATAL(iobuf_opts.large_bufsize == 132 * 1024);
+
+	for (i = 0; i < SPDK_COUNTOF(cases); i++) {
+		bdev = calloc(1, sizeof(*bdev));
+		SPDK_CU_ASSERT_FATAL(bdev != NULL);
+		bdev->name = "bdev0";
+		bdev->fn_table = &fn_table;
+		bdev->module = &bdev_ut_if;
+		bdev->blockcnt = 1024;
+		bdev->blocklen = cases[i].blocklen;
+		bdev->required_alignment = spdk_u32log2(cases[i].alignment);
+		bdev->write_unit_size = cases[i].write_unit_size;
+		rc = spdk_bdev_register(bdev);
+		poll_threads();
+		CU_ASSERT(rc == 0);
+		CU_ASSERT_EQUAL(bdev->max_rw_size, cases[i].max_rw_size);
+		free_bdev(bdev);
+	}
+
+	ut_fini_bdev();
+}

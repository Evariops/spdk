index de4ec92..a523787 100644
--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -102,6 +102,14 @@ struct raid_bdev_process {
 	 * NULL when the registry could not allocate — the rebuild still runs,
 	 * it is just unobservable there. Sealed exactly once at finish. */
 	struct raid_rebuild_outcome	*outcome;
+	/* Evariops 0014.8 (RPC-CONTRACT §10a): integrated verify phase state.
+	 * verify_done guards re-entry; verified feeds the registry seal (and

diff --git a/module/bdev/raid/bdev_raid.c b/module/bdev/raid/bdev_raid.c
index f2611d8..0a1cdee 100644
--- a/module/bdev/raid/bdev_raid.c
+++ b/module/bdev/raid/bdev_raid.c
@@ -2251,6 +2251,7 @@ raid_bdev_remove_base_bdev_on_quiesced(void *ctx, int status)
 {
 	struct raid_base_bdev_info *base_info = ctx;
 	struct raid_bdev *raid_bdev = base_info->raid_bdev;
+	struct raid_base_bdev_info *survivor;
 
 	if (status != 0) {
 		SPDK_ERRLOG("Failed to quiesce raid bdev %s: %s\n",
@@ -2259,6 +2260,29 @@ raid_bdev_remove_base_bdev_on_quiesced(void *ctx, int status)
 		return;
 	}
 
+	/* Evariops 0019: bound the delta the moment the member leaves, by opening
+	 * an auto epoch on every surviving member's cbt — each survivor then records
+	 * every post-ejection write. -EEXIST means a live round already bounds it,
+	 * -ENODEV that the member is not cbt-wrapped; both are expected. */
+	if (raid_bdev->level == RAID1 && base_info->name != NULL) {
+		RAID_FOR_EACH_BASE_BDEV(raid_bdev, survivor) {
+			int rc;
+
+			if (survivor == base_info || !survivor->is_configured ||
+			    survivor->name == NULL) {
+				continue;
+			}
+			rc = vbdev_cbt_auto_epoch_open(survivor->name, base_info->name);
+			if (rc != 0 && rc != -EEXIST && rc != -ENODEV) {
+				SPDK_WARNLOG("raid bdev '%s': auto epoch on '%s' for "
+					     "ejected '%s' failed: %s — the debt path "
+					     "will degrade to a full rebuild (D14)\n",
+					     raid_bdev->bdev.name, survivor->name,
+					     base_info->name, spdk_strerror(-rc));
+			}
+		}
+	}
+
 	if (raid_bdev->sb) {
 		struct raid_bdev_superblock *sb = raid_bdev->sb;
 		uint8_t slot = raid_bdev_base_bdev_slot(base_info);
